<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:iconControl="clr-namespace:ClassIsland.Core.Controls.IconControl"
                    xmlns:controls="clr-namespace:ClassIsland.Core.Controls">
    <Style TargetType="{x:Type iconControl:IconControl}" x:Key="IconControlBaseStyle">
        <Style.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="RealIconKind" Value="PackIcon"/>
                    <Condition Property="IsFallbackMode" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type iconControl:IconControl}">
                            <controls:IconText Kind="{TemplateBinding FallbackGlyph}"
                                               IconSize="{TemplateBinding FontSize}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="RealIconKind" Value="PackIcon"/>
                    <Condition Property="IsFallbackMode" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type iconControl:IconControl}">
                            <controls:IconText Kind="{TemplateBinding Glyph}"
                                               IconSize="{TemplateBinding FontSize}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </MultiTrigger>
        </Style.Triggers>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type iconControl:IconControl}">
                    <Image Source="{TemplateBinding ImageSource}"
                           x:Name="PART_ImageIcon"
                           Stretch="UniformToFill"
                           StretchDirection="Both"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type iconControl:IconControl}" BasedOn="{StaticResource IconControlBaseStyle}"/>
</ResourceDictionary>
