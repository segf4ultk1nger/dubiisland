<UserControl x:Class="ClassIsland.Core.Controls.SettingsControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ClassIsland.Core.Controls"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d" 
             Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
             FontFamily="{StaticResource HarmonyOsSans}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <mah:ToggleSwitch x:Key="ToggleButton" OnContent="开" OffContent="关" MinWidth="0"
                          IsOn="{Binding IsOn, Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:SettingsControl}}}"/>
        <!-- Header TextBlock style -->
        <Style TargetType="TextBlock" x:Key="HeaderTextBlockStyle">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:SettingsControl}}}"
                             Value="True">
                    <Setter Property="FontSize" Value="13"/>
                </DataTrigger>
            </Style.Triggers>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <!-- Description TextBlock style（与标题同字号，仅用透明度区分主次） -->
        <Style TargetType="TextBlock" x:Key="DescriptionTextBlockStyle">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact, Mode=OneWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:SettingsControl}}}"
                             Value="True">
                    <Setter Property="FontSize" Value="13"/>
                </DataTrigger>
            </Style.Triggers>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <!-- 标题 / 描述 / 控件，垂直堆叠左对齐（Windows 10 设置风格） -->
        <StackPanel>

            <TextBlock TextWrapping="Wrap" 
                       Text="{Binding Header, Mode=OneWay, ElementName=Root}"
                       Style="{StaticResource HeaderTextBlockStyle}">
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0 1 0 0" 
                       Opacity="0.75"
                       Text="{Binding Description, Mode=OneWay, ElementName=Root}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource DescriptionTextBlockStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Description, Mode=OneWay, ElementName=Root}"
                                         Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Description, Mode=OneWay, ElementName=Root}"
                                         Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- switcher -->
            <ContentPresenter
                Visibility="{Binding HasSwitcher, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay, ElementName=Root}"
                Margin="0 8 0 0"
                MinHeight="32"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
                <ContentPresenter.Style>
                    <Style TargetType="ContentPresenter">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Switcher, Mode=OneWay, ElementName=Root}" 
                                         Value="{x:Null}">
                                <Setter Property="Content" Value="{StaticResource ToggleButton}"/>
                            </DataTrigger>
                        </Style.Triggers>
                        <Setter Property="Content" Value="{Binding Switcher, Mode=OneWay, ElementName=Root}"/>
                    </Style>
                </ContentPresenter.Style>
            </ContentPresenter>
        </StackPanel>
    </Grid>
</UserControl>
