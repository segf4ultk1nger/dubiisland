<UserControl x:Class="ClassIsland.Core.Controls.IconText"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ClassIsland.Core.Controls"
             mc:Ignorable="d"
             d:DesignHeight="24" d:DesignWidth="120">
    <StackPanel Orientation="Horizontal">
        <TextBlock FontFamily="Segoe MDL2 Assets"
                   Text="{Binding Kind, RelativeSource={RelativeSource AncestorType=controls:IconText}}"
                   FontSize="{Binding IconSize, RelativeSource={RelativeSource AncestorType=controls:IconText}}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding Text, RelativeSource={RelativeSource AncestorType=controls:IconText}}"
                   VerticalAlignment="Center"
                   Margin="{Binding IconMargin, RelativeSource={RelativeSource AncestorType=controls:IconText}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource AncestorType=controls:IconText}}"
                                     Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource AncestorType=controls:IconText}}"
                                     Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
