<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:templates="clr-namespace:ClassIsland.Core.Models.Notification.Templates" xmlns:ciCore="clr-namespace:ClassIsland.Core.Controls">
    <DataTemplate x:Key="{x:Static templates:TwoIconsMaskTemplateData.TemplateResourceKey}"
                  DataType="{x:Type templates:TwoIconsMaskTemplateData}">
        <StackPanel Orientation="Horizontal" 
                    VerticalAlignment="Center" HorizontalAlignment="Center">
            <ciCore:IconText IconSize="20" Kind="{Binding LeftIconKind}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Text}" FontSize="{DynamicResource MainWindowEmphasizedFontSize}" 
                       Margin="8 0" FontWeight="Bold"/>
            <ciCore:IconText IconSize="20" Kind="{Binding RightIconKind}" VerticalAlignment="Center" Visibility="{Binding HasRightIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
