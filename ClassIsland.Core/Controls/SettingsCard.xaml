<UserControl x:Class="ClassIsland.Core.Controls.SettingsCard"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters1="clr-namespace:ClassIsland.Core.Converters"
             xmlns:controls1="clr-namespace:ClassIsland.Core.Controls"
             mc:Ignorable="d" 
             Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters1:BooleanToVisibilityReConverter x:Key="BooleanToVisibilityReConverter"/>
    </UserControl.Resources>
    <Border HorizontalAlignment="Stretch" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}" Padding="12 10 16 10">
        <controls1:SettingsControl 
            Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
            Header="{Binding Header, Mode=OneWay, ElementName=Root}"
            Description="{Binding Description, Mode=OneWay, ElementName=Root}"
            IconGlyph="{Binding IconGlyph, Mode=OneWay, ElementName=Root}"
            IsOn="{Binding IsOn, Mode=TwoWay, ElementName=Root}"
            Switcher="{Binding Switcher, Mode=TwoWay, ElementName=Root}"
            HasSwitcher="{Binding HasSwitcher, Mode=OneWay, ElementName=Root}"/>
    </Border>
</UserControl>
