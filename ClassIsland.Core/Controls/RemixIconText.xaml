<UserControl x:Class="ClassIsland.Core.Controls.RemixIconText"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:ClassIsland.Core.Controls"
             xmlns:remix="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.RemixIcon"
             mc:Ignorable="d"
             d:DesignHeight="24" d:DesignWidth="120">
    <StackPanel Orientation="Horizontal">
        <remix:PackIconRemixIcon
            Kind="{Binding Kind, RelativeSource={RelativeSource AncestorType=controls:RemixIconText}}"
            Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=controls:RemixIconText}}"
            Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=controls:RemixIconText}}"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding Text, RelativeSource={RelativeSource AncestorType=controls:RemixIconText}}"
                   VerticalAlignment="Center"
                   Margin="{Binding IconMargin, RelativeSource={RelativeSource AncestorType=controls:RemixIconText}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource AncestorType=controls:RemixIconText}}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource AncestorType=controls:RemixIconText}}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
