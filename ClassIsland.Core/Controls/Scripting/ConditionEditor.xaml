<UserControl x:Class="ClassIsland.Core.Controls.Scripting.ConditionEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ClassIsland.Core.Controls.Scripting"
             mc:Ignorable="d"
             d:DesignHeight="220" d:DesignWidth="450">
    <StackPanel>
        <TextBlock Text="条件表达式"
                   Style="{StaticResource Headline5TextBlock}"
                   Margin="0 0 0 4" />
        <TextBlock Text="使用 JavaScript 表达式描述条件，例如 lessons.currentSubject === &quot;数学&quot;。"
                   TextWrapping="Wrap"
                   Opacity="0.75"
                   Margin="0 0 0 6" />
        <TextBox x:Name="ConditionTextBox"
                 MinHeight="72"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 mah:TextBoxHelper.Watermark="输入条件表达式…"
                 TextChanged="ConditionTextBox_OnTextChanged"
                 Text="{Binding Condition, RelativeSource={RelativeSource AncestorType=local:ConditionEditor}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <Border Background="{DynamicResource MahApps.Brushes.Control.Background}"
                CornerRadius="4"
                Padding="8"
                Margin="0 6 0 0">
            <StackPanel>
                <TextBlock Text="可用变量：lessons / window / weather / time"
                           TextWrapping="Wrap"
                           Opacity="0.85" />
                <TextBlock Text="示例：lessons.currentSubject === &quot;数学&quot;、time.now().Hour &gt;= 8、window.State === &quot;fullscreen&quot;、weather.isWeather(&quot;晴&quot;)"
                           TextWrapping="Wrap"
                           Opacity="0.65"
                           Margin="0 2 0 0" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0 6 0 0">
            <TextBlock Text="当前结果：" VerticalAlignment="Center" />
            <TextBlock x:Name="PreviewTextBlock"
                       Text="--"
                       FontWeight="Medium"
                       VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="PreviewErrorTextBlock"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource MahApps.Brushes.Accent3}"
                   Visibility="Collapsed"
                   Margin="0 2 0 0" />
    </StackPanel>
</UserControl>
