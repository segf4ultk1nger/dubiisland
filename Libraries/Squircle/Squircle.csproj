<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <UseWPF>true</UseWPF>
        <LangVersion>9.0</LangVersion>
        <Nullable>enable</Nullable>
        <RootNamespace>Squircle</RootNamespace>
        <AssemblyName>Squircle</AssemblyName>
        <!-- Sibling project (Squircle.Demo) lives inside this folder; keep it out of the default item globs. -->
        <DefaultItemExcludes>$(DefaultItemExcludes);Squircle.Demo\**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all"/>
    </ItemGroup>

</Project>
