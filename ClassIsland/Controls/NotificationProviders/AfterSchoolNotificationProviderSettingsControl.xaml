<ci:NotificationProviderControlBase
    x:TypeArguments="notificationProviderSettings:AfterSchoolNotificationProviderSettings"
            x:Class="ClassIsland.Controls.NotificationProviders.AfterSchoolNotificationProviderSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ClassIsland.Controls.NotificationProviders"
             xmlns:ci="http://classisland.tech/schemas/xaml/core"
             xmlns:notificationProviderSettings="clr-namespace:ClassIsland.Models.NotificationProviderSettings"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" xmlns:ciCore="clr-namespace:ClassIsland.Core.Controls;assembly=ClassIsland.Core">
    <ScrollViewer DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:AfterSchoolNotificationProviderSettingsControl}}">
        <StackPanel Margin="4">
            <!-- 附加设置覆盖提示 -->
            <Border Background="{DynamicResource MahApps.Brushes.Control.Background}" Margin="0 0 0 4">
                <Grid>
                    <DockPanel Margin="8 0 4 0">
                        <Button Style="{StaticResource MahApps.Styles.Button.Flat}"
                                DockPanel.Dock="Right"
                                Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                                Click="ButtonShowAttachedSettingsInfo_OnClick">
                            <ci:IconText Kind="{x:Static ciCore:IconGlyphs.MoreCircleOutline}" Text="查看…"/>
                        </Button>
                        <ciCore:IconText Kind="{x:Static ciCore:IconGlyphs.LayersOutline}"
                                                 Margin="0 0 4 0"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="此处的设置可以在档案设置中被附加设置覆盖。"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Grid>
            </Border>
            <CheckBox Content="已启用" IsChecked="{Binding Settings.IsEnabled}" 
                      Margin="0 0 0 8"/>
            <TextBox Style="{StaticResource MahApps.Styles.TextBox}"
                     mah:TextBoxHelper.Watermark="提醒显示内容"
                     Padding="8"
                     Text="{Binding Settings.NotificationMsg}"/>
            <ci:SettingsCard IconGlyph="{x:Static ciCore:IconGlyphs.ClockOutline}" Header="放学提醒显示持续时长" Margin="0 6 0 0" Description="显示放学提醒的时长。">
                <ci:SettingsCard.Switcher>
                    <ci:NumbericTextBox MaxValue="3600" MinValue="3"
                                   Text="{Binding Settings.NotificationMsgDuration, Converter={StaticResource IntToStringConverter}}"
                                   Width="120"
                                   Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                                   Style="{StaticResource MahApps.Styles.TextBox}" />
                </ci:SettingsCard.Switcher>
            </ci:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</ci:NotificationProviderControlBase>
