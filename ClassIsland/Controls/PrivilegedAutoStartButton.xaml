<UserControl x:Class="ClassIsland.Controls.PrivilegedAutoStartButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:remix="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.RemixIcon">
    <Button x:Name="ActionButton" Style="{StaticResource MahApps.Styles.Button.Flat}" Click="Button_OnClick">
        <StackPanel Orientation="Horizontal">
            <Grid Width="16" Height="16" VerticalAlignment="Center">
                <Image x:Name="ShieldIcon" Width="16" Height="16" />
                <remix:PackIconRemixIcon x:Name="Spinner" Kind="Loader3Fill"
                                         Width="16" Height="16" Visibility="Collapsed"
                                         RenderTransformOrigin="0.5,0.5">
                    <remix:PackIconRemixIcon.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotate" />
                    </remix:PackIconRemixIcon.RenderTransform>
                </remix:PackIconRemixIcon>
            </Grid>
            <TextBlock x:Name="Label" Text="设置提权启动" Margin="6 0 0 0" VerticalAlignment="Center" />
        </StackPanel>
    </Button>
</UserControl>
