<UserControl x:Class="ClassIsland.Controls.Island.IslandPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ClassIsland.Controls.Island"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="600"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto">
    <Grid x:Name="PreviewRoot" Background="#1E1E1E" ClipToBounds="True">
        <!-- 画布层：壁纸 + 岛作为一个整体，聚焦时只变换这一层（岛跟着壁纸移动缩放） -->
        <Grid x:Name="PreviewCanvas" RenderTransformOrigin="0,0">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="FocusScale"/>
                    <TranslateTransform x:Name="FocusTranslate"/>
                </TransformGroup>
            </Grid.RenderTransform>
            <!-- 壁纸层：壁纸铺不满（贴边留白/超出屏幕）的部分由 PreviewRoot 的底色兜底 -->
            <Border x:Name="PreviewWallpaperLayer" Background="Transparent" IsHitTestVisible="False"/>
            <Border x:Name="PreviewBorder" Padding="12" SizeChanged="PreviewBorder_OnSizeChanged">
                <Viewbox x:Name="IslandViewbox" Stretch="Uniform" StretchDirection="DownOnly"
                         MaxHeight="{Binding PreviewContentCap, ElementName=IslandPreviewHost}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         SizeChanged="PreviewBorder_OnSizeChanged">
                    <local:IslandPreview x:Name="IslandPreviewHost"/>
                </Viewbox>
            </Border>
            <!-- 悬停指示：实时显示鼠标所在组件/行的位置，不做动画 -->
            <Path x:Name="HoverHighlight" IsHitTestVisible="False" Visibility="Collapsed" Stretch="None"
                  Stroke="#FF1E90FF" StrokeThickness="2"/>
            <!-- 选中项高亮：几何在 PreviewCanvas 坐标里，Rect 可做过渡动画；随聚焦变换一起移动缩放 -->
            <Path x:Name="SelectionHighlight" IsHitTestVisible="False" Visibility="Collapsed" Stretch="None"
                  Stroke="#FFFF3B30" StrokeThickness="2"/>
        </Grid>

        <!-- 右下角实时预览角标（直角、半透明黑） -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Background="#99000000" Padding="6 2">
            <TextBlock Text="实时预览" Foreground="White" FontSize="12" Opacity="0.9"/>
        </Border>
    </Grid>
</UserControl>
