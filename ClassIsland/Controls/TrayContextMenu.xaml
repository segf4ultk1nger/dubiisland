<ResourceDictionary x:Class="ClassIsland.Controls.TrayContextMenu"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters1="clr-namespace:ClassIsland.Core.Converters;assembly=ClassIsland.Core"
                    xmlns:remix="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.RemixIcon"
                    xmlns:ciCore="clr-namespace:ClassIsland.Core.Controls;assembly=ClassIsland.Core">
        <ContextMenu FontFamily="{StaticResource HarmonyOsSans}" x:Key="AppContextMenu" x:Shared="False"
                     Style="{StaticResource MahApps.Styles.ContextMenu}"
                     StaysOpen="True"
                     IsEnabled="{Binding ViewModel.IsBusy, Converter={StaticResource InvertBooleanConverter}}">
            <ContextMenu.Resources>
                <converters1:BooleanAndToVisibilityMultiConverter x:Key="BooleanAndToVisibilityMultiConverter" />
                <Style TargetType="MenuItem" BasedOn="{StaticResource MahApps.Styles.MenuItem}" />
            </ContextMenu.Resources>
            <MenuItem Header="LegacyIsland" Click="MenuItemAbout_OnClick">
                <MenuItem.Icon>
                    <Image Source="/Assets/AppLogo.png" Width="16" Height="16"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="显示主界面" Click="MenuItemSwitchMainWindowVisibility_OnClick">
                <MenuItem.Icon>
                    <remix:PackIconRemixIcon Kind="EyeFill" Width="16" Height="16"/>
                </MenuItem.Icon>
                <MenuItem.Visibility>
                    <MultiBinding Converter="{StaticResource BooleanAndToVisibilityMultiConverter}" Mode="OneWay">
                        <Binding Path="ViewModel.Settings.IsMainWindowVisible" Mode="OneWay" Converter="{StaticResource InvertBooleanConverter}" />
                    </MultiBinding>
                </MenuItem.Visibility>
            </MenuItem>
            <MenuItem Header="隐藏主界面" Click="MenuItemSwitchMainWindowVisibility_OnClick">
                <MenuItem.Icon>
                    <remix:PackIconRemixIcon Kind="EyeOffFill" Width="16" Height="16"/>
                </MenuItem.Icon>
                <MenuItem.Visibility>
                    <MultiBinding Converter="{StaticResource BooleanAndToVisibilityMultiConverter}" Mode="OneWay">
                        <Binding Path="ViewModel.Settings.IsMainWindowVisible" Mode="OneWay"/>
                    </MultiBinding>
                </MenuItem.Visibility>
            </MenuItem>
            <MenuItem Icon="{ciCore:GlyphIcon {x:Static ciCore:IconGlyphs.NotificationClearAll}}" Header="清除全部提醒" Click="MenuItemClearAllNotifications_OnClick">
                <MenuItem.Visibility>
                    <MultiBinding Converter="{StaticResource BooleanAndToVisibilityMultiConverter}" Mode="OneWay">
                        <Binding Path="ViewModel.IsOverlayOpened" Mode="OneWay"/>
                    </MultiBinding>
                </MenuItem.Visibility>
            </MenuItem>
            <Separator/>
            <MenuItem Header="编辑档案…" Click="ButtonSettings_OnClick">
                <MenuItem.Icon>
                    <remix:PackIconRemixIcon Kind="BallPenFill" Width="16" Height="16"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="应用设置…" Click="MenuItemSettings_OnClick">
                <MenuItem.Icon>
                    <remix:PackIconRemixIcon Kind="Settings4Fill" Width="16" Height="16"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="加载临时课表…" Click="MenuItemTemporaryClassPlan_OnClick">
                <MenuItem.Icon>
                    <remix:PackIconRemixIcon Kind="GitRepositoryCommitsFill" Width="16" Height="16"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Icon="{ciCore:GlyphIcon {x:Static ciCore:IconGlyphs.SwapHorizontal}}" Header="换课…" Click="MenuItemClassSwap_OnClick">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource MahApps.Styles.MenuItem}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LessonsService.CurrentClassPlan}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <Separator/>
            <MenuItem Header="重启" Click="MenuItemRestartApp_OnClick">
                <MenuItem.Icon>
                    <remix:PackIconRemixIcon Kind="RestartLine" Width="16" Height="16"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="退出" Click="MenuItemExitApp_OnClick">
                <MenuItem.Icon>
                    <remix:PackIconRemixIcon Kind="ShutDownLine" Width="16" Height="16"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator Visibility="{Binding ViewModel.Settings.IsDebugEnabled, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <MenuItem Icon="{ciCore:GlyphIcon {x:Static ciCore:IconGlyphs.BugOutline}}" Header="调试"
                      Visibility="{Binding ViewModel.Settings.IsDebugEnabled, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <MenuItem Header="SizeToContentTest" Click="ButtonResizeDebug_OnClick"/>
                <Separator/>
                <MenuItem Header="FitSize" Click="MenuItemDebugFitSize_OnClick"/>
            </MenuItem>
        </ContextMenu>
</ResourceDictionary>
