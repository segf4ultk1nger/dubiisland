<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime"
                    xmlns:controls="clr-namespace:ClassIsland.Controls"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:ciCore="clr-namespace:ClassIsland.Core.Controls;assembly=ClassIsland.Core">
    <DataTemplate DataType="{x:Type system:String}" x:Key="MaterialDesignWeatherIconTemplate">
        <Border x:Name="OuterBorder" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="Transparent">
            <ciCore:IconText HorizontalAlignment="Center" VerticalAlignment="Center"
                                     IconSize="{Binding ActualHeight, ElementName=OuterBorder}">
                <ciCore:IconText.Style>
                    <Style TargetType="ciCore:IconText">
                        <Style.Triggers>
                            <!-- 晴 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="0">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherSunny}" />
                            </DataTrigger>
                            <!-- 多云 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="1">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherPartlyCloudy}" />
                            </DataTrigger>
                            <!-- 阴 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="2">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherCloudy}" />
                            </DataTrigger>
                            <!-- 阵雨 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="3">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherPartlyRainy}" />
                            </DataTrigger>
                            <!-- 雷阵雨 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="4">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherLightningRainy}" />
                            </DataTrigger>
                            <!-- 雷阵雨并伴有冰雹 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="5">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherLightningRainy}" />
                            </DataTrigger>
                            <!-- 雨夹雪 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="6">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherSnowyRainy}" />
                            </DataTrigger>
                            <!-- 小雨 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="7">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherRainy}" />
                            </DataTrigger>
                            <!-- 中雨 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="8">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherRainy}" />
                            </DataTrigger>
                            <!-- 大雨 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="9">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherPouring}" />
                            </DataTrigger>
                            <!-- 暴雨 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="10">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherPouring}" />
                            </DataTrigger>
                            <!-- 大暴雨 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="11">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherPouring}" />
                            </DataTrigger>
                            <!-- 特大暴雨 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="12">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherPouring}" />
                            </DataTrigger>
                            <!-- 阵雪 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="13">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherPartlySnowy}" />
                            </DataTrigger>
                            <!-- 小雪 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="14">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherSnowy}" />
                            </DataTrigger>
                            <!-- 中雪 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="15">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherSnowy}" />
                            </DataTrigger>
                            <!-- 大雪 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="16">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherSnowyHeavy}" />
                            </DataTrigger>
                            <!-- 暴雪 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="17">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherSnowyHeavy}" />
                            </DataTrigger>
                            <!-- 雾 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="18">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherFog}" />
                            </DataTrigger>
                            <!-- 冻雨 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="19">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherSnowyRainy}" />
                            </DataTrigger>
                            <!-- 沙尘暴 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="20">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.DustStorm}" />
                            </DataTrigger>
                            <!-- 小雨-中雨 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="21">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherRainy}" />
                            </DataTrigger>
                            <!-- 中雨-大雨 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="22">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherRainy}" />
                            </DataTrigger>
                            <!-- 大雨-暴雨 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="23">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherPouring}" />
                            </DataTrigger>
                            <!-- 暴雨-大暴雨 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="24">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherPouring}" />
                            </DataTrigger>
                            <!-- 大暴雨-特大暴雨 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="25">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherPouring}" />
                            </DataTrigger>
                            <!-- 小雪-中雪 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="26">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherSnowy}" />
                            </DataTrigger>
                            <!-- 中雪-大雪 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="27">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherSnowy}" />
                            </DataTrigger>
                            <!-- 大雪-暴雪 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="28">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherSnowyHeavy}" />
                            </DataTrigger>
                            <!-- 浮尘 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="29">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherDust}" />
                            </DataTrigger>
                            <!-- 扬沙 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="30">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherDust}" />
                            </DataTrigger>
                            <!-- 强沙尘暴 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="31">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.DustStorm}" />
                            </DataTrigger>
                            <!-- 飑 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="32">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherRainy}" />
                            </DataTrigger>
                            <!-- 龙卷风 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="33">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherTornado}" />
                            </DataTrigger>
                            <!-- 弱高吹雪 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="34">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherSnowy}" />
                            </DataTrigger>
                            <!-- 轻雾 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="35">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherFog}" />
                            </DataTrigger>
                            <!-- 霾 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="53">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherHazy}" />
                            </DataTrigger>
                            <!-- 雨 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="301">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherRainy}" />
                            </DataTrigger>
                            <!-- 雪 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="302">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.WeatherSnowy}" />
                            </DataTrigger>
                            <!-- 未知 -->
                            <DataTrigger Binding="{Binding }"
                                         Value="99">
                                <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.CloudQuestionOutline}" />
                            </DataTrigger>
                        </Style.Triggers>
                        <Setter Property="Kind" Value="{x:Static ciCore:IconGlyphs.CloudQuestionOutline}" />
                    </Style>
                </ciCore:IconText.Style>
            </ciCore:IconText></Border>
    </DataTemplate>
</ResourceDictionary>