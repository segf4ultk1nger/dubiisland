<UserControl x:Class="ClassIsland.Controls.TimeLineListItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ClassIsland.Controls"
             xmlns:controls="clr-namespace:ClassIsland.Core.Controls;assembly=ClassIsland.Core"
             xmlns:remix="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.RemixIcon"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             SizeChanged="TimeLineListItemControl_OnSizeChanged">
    <Grid DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:TimeLineListItemControl}}"
          Margin="0"
          Visibility="{Binding IsExpanded, RelativeSource={RelativeSource FindAncestor, AncestorType=local:TimeLineListItemControl}, Converter={StaticResource BooleanToVisibilityConverter}}"
          HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <!-- Icon -->
        <controls:RemixIconText Grid.Column="0" Grid.Row="0"
            Margin="0 0 2 0"
            VerticalAlignment="Center">
            <controls:RemixIconText.Style>
                <Style TargetType="controls:RemixIconText">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TimePoint.TimeType}"
                            Value="0">
                            <Setter Property="Kind" Value="{x:Static remix:PackIconRemixIconKind.BookOpenLine}" />
                            <Setter Property="ToolTip" Value="上课时间" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding TimePoint.TimeType}"
                            Value="1">
                            <Setter Property="Kind"
                                Value="{x:Static remix:PackIconRemixIconKind.TimeLine}" />
                            <Setter Property="ToolTip" Value="课间休息" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding TimePoint.TimeType}"
                            Value="2">
                            <Setter Property="Kind"
                                Value="{x:Static remix:PackIconRemixIconKind.Separator}" />
                            <Setter Property="ToolTip" Value="分割线" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding TimePoint.TimeType}"
                                     Value="3">
                            <Setter Property="Kind"
                                    Value="{x:Static remix:PackIconRemixIconKind.PlaneLine}" />
                            <Setter Property="ToolTip" Value="行动" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:RemixIconText.Style>
        </controls:RemixIconText>

        <!-- Time -->
        <TextBlock Grid.Column="1" Grid.Row="0"
                   VerticalAlignment="Center"
                   ToolTip="时间段">
            <Run
                Text="{Binding TimePoint.StartTime, ConverterCulture=zh-cn, StringFormat={}{0:hh\\:mm\\:ss}}" />
            <Run Text="-" />
            <Run
                Text="{Binding TimePoint.EndTime, ConverterCulture=zh-cn, StringFormat={}{0:hh\\:mm\\:ss}}" />
        </TextBlock>

        <!-- Last Time -->
        <controls:RemixIconText Grid.Column="1" Grid.Row="1"
                           Kind="{x:Static remix:PackIconRemixIconKind.TimerLine}"
                           Text="{Binding TimePoint.Last}"
                           Margin="0 0 0 0" ToolTip="持续时间" />

    </Grid>
</UserControl>
