<controls:ComponentBase x:Class="ClassIsland.Controls.Components.TextComponentSettingsControl"
                         x:TypeArguments="componentSettings:TextComponentSettings"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                         xmlns:local="clr-namespace:ClassIsland.Controls.Components"
                         xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
                         xmlns:controls2="clr-namespace:ClassIsland.Core.Controls;assembly=ClassIsland.Core"
                         xmlns:componentSettings="clr-namespace:ClassIsland.Models.ComponentSettings"
                         xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                         mc:Ignorable="d" 
                         d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:TextComponentSettingsControl}}">
        <controls2:SettingsCard Header="文本内容"
                                Description="要显示的文本。">
            <controls2:SettingsCard.Switcher>
                <TextBox MinWidth="200"
                         Text="{Binding Settings.TextContent, UpdateSourceTrigger=PropertyChanged}" />
            </controls2:SettingsCard.Switcher>
        </controls2:SettingsCard>

        <controls2:SettingsCard Header="字体颜色"
                                Description="选择要显示文本的颜色。">
            <controls2:SettingsCard.Switcher>
                <mah:ColorPicker Style="{StaticResource AppColorPickerStyle}"
                                 SelectedColor="{Binding Settings.FontColor, Mode=TwoWay}" />
            </controls2:SettingsCard.Switcher>
        </controls2:SettingsCard>

        <controls2:SettingsCard Header="字体大小"
                                Description="修改要显示的文本的大小。">
            <controls2:SettingsCard.Switcher>
                <Slider Width="200"
                        Maximum="30" Minimum="16" IsSnapToTickEnabled="True" AutoToolTipPlacement="BottomRight"
                        Value="{Binding Settings.FontSize}" />
            </controls2:SettingsCard.Switcher>
        </controls2:SettingsCard>
    </StackPanel>
</controls:ComponentBase>
