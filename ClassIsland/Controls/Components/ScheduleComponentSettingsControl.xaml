<ci:ComponentBase x:Class="ClassIsland.Controls.Components.ScheduleComponentSettingsControl"
                  x:TypeArguments="componentSettings:LessonControlSettings"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:ClassIsland.Controls.Components"
                  xmlns:models="clr-namespace:ClassIsland.Models"
                  xmlns:ci="http://classisland.tech/schemas/xaml/core"
                  xmlns:remix="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.RemixIcon"
                  xmlns:dialogs="clr-namespace:ClassIsland.Core.Services;assembly=ClassIsland.Core"
                  xmlns:componentSettings="clr-namespace:ClassIsland.Models.ComponentSettings"
                  xmlns:system="clr-namespace:System;assembly=System.Runtime"
                  mc:Ignorable="d"
                  d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:ScheduleComponentSettingsControl}}">
        <!-- 附加设置覆盖提示 -->
        <TextBlock TextWrapping="Wrap" Foreground="#FFE05555" FontSize="14" Margin="12 0 0 8">
            <Run>*此处设置可以在档案设置中被附加设置覆盖。</Run>
            <Hyperlink Foreground="#FFE05555" Click="ButtonShowAttachedSettings_OnClick">查看覆盖项</Hyperlink>
        </TextBlock>

        <!-- 显示时间点附加信息 -->
        <ci:SettingsCard Header="显示时间点附加信息"
                         Description="显示当前时间点的附加信息。"
                         IsOn="{Binding Settings.ShowExtraInfoOnTimePoint, Mode=TwoWay}" />
        <StackPanel Margin="0 0 0 6"
                    Visibility="{Binding Settings.ShowExtraInfoOnTimePoint, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ci:SettingsCard Header="要显示的附加信息">
                <ci:SettingsCard.Switcher>
                    <ComboBox VerticalAlignment="Center"
                              Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                              SelectedIndex="{Binding Settings.ExtraInfoType}"
                              HorizontalContentAlignment="Left"
                              MinWidth="160">
                        <ComboBoxItem HorizontalContentAlignment="Left">
                            <TextBlock Text="时间点持续时间" />
                        </ComboBoxItem>
                        <ComboBoxItem HorizontalContentAlignment="Left">
                            <TextBlock Text="已过时间/持续时间" />
                        </ComboBoxItem>
                        <ComboBoxItem HorizontalContentAlignment="Left">
                            <TextBlock Text="剩余时间/持续时间" />
                        </ComboBoxItem>
                        <ComboBoxItem HorizontalContentAlignment="Left">
                            <TextBlock Text="已过时间百分比" />
                        </ComboBoxItem>
                        <ComboBoxItem HorizontalContentAlignment="Left">
                            <TextBlock Text="剩余时间" />
                        </ComboBoxItem>
                        <ComboBoxItem HorizontalContentAlignment="Left">
                            <TextBlock Text="倒计时" />
                        </ComboBoxItem>
                    </ComboBox>
                </ci:SettingsCard.Switcher>
            </ci:SettingsCard>
            <ci:SettingsCard Header="显示精确倒计时">
                <ci:SettingsCard.Style>
                    <Style TargetType="ci:SettingsCard">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Settings.ExtraInfoType}" Value="4">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ci:SettingsCard.Style>
                <ci:SettingsCard.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="当剩余时间不足" VerticalAlignment="Center" Opacity="0.75"/>
                        <mah:NumericUpDown Value="{Binding Settings.ExtraInfo4ShowSecondsSeconds}"
                                           Minimum="0" Interval="1" StringFormat="0"
                                           MinWidth="100" MinHeight="32" FontSize="14" Margin="6 0 0 0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}" />
                        <TextBlock Text="秒时显示" VerticalAlignment="Center" Margin="6 0 0 0" Opacity="0.75"/>
                    </StackPanel>
                </ci:SettingsCard.Switcher>
            </ci:SettingsCard>
        </StackPanel>

        <!-- 时间点结束倒计时 -->
        <ci:SettingsCard Header="时间点结束倒计时"
                         Description="时间点结束前显示倒计时。"
                         IsOn="{Binding Settings.IsCountdownEnabled, Mode=TwoWay}" />
        <StackPanel Margin="0 0 0 6"
                    Visibility="{Binding Settings.IsCountdownEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ci:SettingsCard Header="时间点结束倒计时时长">
                <ci:SettingsCard.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <Slider Width="220" Minimum="0" Maximum="36000" VerticalAlignment="Center"
                                Value="{Binding Settings.CountdownSeconds}"
                                AutoToolTipPlacement="BottomRight" TickFrequency="60" TickPlacement="None"
                                IsSnapToTickEnabled="True" AutoToolTipPrecision="0" />
                        <mah:NumericUpDown Value="{Binding Settings.CountdownSeconds}"
                                           Minimum="0" Maximum="36000" Interval="60" StringFormat="0"
                                           MinWidth="100" MinHeight="32" FontSize="14" Margin="12 0 0 0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}" />
                        <TextBlock Text="秒" VerticalAlignment="Center" Margin="6 0 0 0"/>
                    </StackPanel>
                </ci:SettingsCard.Switcher>
            </ci:SettingsCard>
            <ci:SettingsCard Header="使用模糊倒计时"
                             Description="以大约时间显示，不显示精确的秒数。"
                             IsOn="{Binding Settings.IsNonExactCountdownEnabled, Mode=TwoWay}" />
        </StackPanel>

        <!-- 上课时仅显示当前课程 -->
        <ci:SettingsCard Header="上课时仅显示当前课程"
                         Description="上课时间点只显示当前时间点。"
                         IsOn="{Binding Settings.ShowCurrentLessonOnlyOnClass, Mode=TwoWay}" />
        <!-- 不显示已结束的课程 -->
        <ci:SettingsCard Header="不显示已结束的课程"
                         Description="隐藏已结束课程，仅显示当前及未开始课程。"
                         IsOn="{Binding Settings.HideFinishedClass, Mode=TwoWay}" />
        <!-- 标记换课课程 -->
        <ci:SettingsCard Header="标记换课课程"
                         Description="高亮标记临时层中通过“换课”修改的课程。"
                         IsOn="{Binding Settings.HighlightChangedClass, Mode=TwoWay}" />
        <!-- 课程表文本间距 -->
        <ci:SettingsCard Header="课程表文本间距"
                         Description="使课程表显示更紧凑或宽松。">
            <ci:SettingsCard.Switcher>
                <StackPanel Orientation="Horizontal">
                    <Slider Width="220" Minimum="0.3" Maximum="1" VerticalAlignment="Center"
                            Value="{Binding Settings.ScheduleSpacing}"
                            AutoToolTipPlacement="BottomRight" TickFrequency="0.05" TickPlacement="None"
                            IsSnapToTickEnabled="True" AutoToolTipPrecision="2" />
                    <mah:NumericUpDown Value="{Binding Settings.ScheduleSpacing}"
                                       Minimum="0.3" Maximum="1" Interval="0.05" StringFormat="0.00"
                                       MinWidth="100" MinHeight="32" FontSize="14" Margin="12 0 0 0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}" />
                </StackPanel>
            </ci:SettingsCard.Switcher>
        </ci:SettingsCard>

        <!-- 无课程时显示占位符 -->
        <ci:SettingsCard Header="无课程时显示占位符"
                         Description="无课表或当日课程结束且不显示次日课表时显示占位符。"
                         IsOn="{Binding Settings.ShowPlaceholderOnEmptyClassPlan, Mode=TwoWay}" />
        <StackPanel Margin="0 0 0 6"
                    Visibility="{Binding Settings.ShowPlaceholderOnEmptyClassPlan, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ci:SettingsCard Header="当日没有课程的占位符内容">
                <ci:SettingsCard.Switcher>
                    <ComboBox MinWidth="100"
                              MaxWidth="300"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                              IsEditable="True"
                              Text="{Binding Settings.PlaceholderTextNoClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <system:String>今天没有课程。</system:String>
                        <system:String>无</system:String>
                        <system:String>[ ]</system:String>
                    </ComboBox>
                </ci:SettingsCard.Switcher>
            </ci:SettingsCard>
            <ci:SettingsCard Header="当日课程结束的占位符内容">
                <ci:SettingsCard.Switcher>
                    <ComboBox MinWidth="100"
                              MaxWidth="300"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                              IsEditable="True"
                              Text="{Binding Settings.PlaceholderTextAllClassEnded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <system:String>今日课程已全部结束。</system:String>
                        <system:String>无</system:String>
                        <system:String>[ ]</system:String>
                    </ComboBox>
                </ci:SettingsCard.Switcher>
            </ci:SettingsCard>
        </StackPanel>

        <!-- 放学后显示明天课表 -->
        <ci:SettingsCard Header="显示明天课表"
                         Description="设置什么时候显示明天课表。">
            <ci:SettingsCard.Switcher>
                <ComboBox SelectedIndex="{Binding Settings.TomorrowScheduleShowMode}">
                    <ComboBoxItem>不显示</ComboBoxItem>
                    <ComboBoxItem>放学后显示</ComboBoxItem>
                    <ComboBoxItem>总是显示</ComboBoxItem>
                </ComboBox>
            </ci:SettingsCard.Switcher>
        </ci:SettingsCard>
        <Button Margin="0 0 0 6" HorizontalAlignment="Left"
                Style="{StaticResource MahApps.Styles.Button.Flat}"
                Click="ButtonImportLegacySettings_OnClick"
                Visibility="{Binding SettingsService.Settings.IsMigratedFromv1_4, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <remix:PackIconRemixIcon Kind="ImportLine" Width="16" Height="16" VerticalAlignment="Center"/>
                <TextBlock Text="导入旧版设置" VerticalAlignment="Center" Margin="6 0 0 0"/>
            </StackPanel>
        </Button>
    </StackPanel>
</ci:ComponentBase>
