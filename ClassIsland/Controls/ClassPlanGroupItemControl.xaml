<UserControl x:Class="ClassIsland.Controls.ClassPlanGroupItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ClassIsland.Controls"
        xmlns:dialogs="clr-namespace:ClassIsland.Core.Services;assembly=ClassIsland.Core"
             xmlns:ci="http://classisland.tech/schemas/xaml/core"
             xmlns:views="clr-namespace:ClassIsland.Views"
             xmlns:converters="clr-namespace:ClassIsland.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" xmlns:ciCore="clr-namespace:ClassIsland.Core.Controls;assembly=ClassIsland.Core">
    <UserControl.Resources>
    </UserControl.Resources>
    <Grid DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:ClassPlanGroupItemControl}}">
        <Grid.ContextMenu>
            <ContextMenu FontFamily="{StaticResource HarmonyOsSans}">
                <MenuItem Icon="{ciCore:GlyphIcon {x:Static ciCore:IconGlyphs.FileDocumentMultipleOutline}}" Header="临时启用" Click="MenuItemTemp_OnClick"/>
                <Separator/>
                <MenuItem Icon="{ciCore:GlyphIcon {x:Static ciCore:IconGlyphs.RenameOutline}}" Header="重命名" Click="MenuItemRename_OnClick" IsEnabled="{Binding IsProtected, Converter={StaticResource InvertBooleanConverter}}"/>
                <!--<MenuItem Icon="{ciCore:GlyphIcon {x:Static ciCore:IconGlyphs.FileExportOutline}}" Header="导出"/>-->
                <MenuItem Icon="{ciCore:GlyphIcon {x:Static ciCore:IconGlyphs.Remove}}" Header="解散" Click="MenuItemDisband_OnClick" IsEnabled="{Binding IsProtected, Converter={StaticResource InvertBooleanConverter}}"/>
                <MenuItem Icon="{ciCore:GlyphIcon {x:Static ciCore:IconGlyphs.DeleteOutline}}" Header="删除" Click="MenuItemDelete_OnClick" IsEnabled="{Binding IsProtected, Converter={StaticResource InvertBooleanConverter}}"/>
            </ContextMenu>
        </Grid.ContextMenu>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal" HorizontalAlignment="Stretch" Background="Transparent">
            <StackPanel.Resources>
                <converters:GuidToStringRadioButtonSelectionConverter x:Key="StringToRadioButtonSelectionConverter" />
            </StackPanel.Resources>
            <RadioButton GroupName="ProfileSelection" VerticalAlignment="Center">
                <RadioButton.IsChecked>
                    <MultiBinding Converter="{StaticResource StringToRadioButtonSelectionConverter}">
                        <Binding Path="ProfileService.Profile.SelectedClassPlanGroupId" 
                                                 RelativeSource="{RelativeSource FindAncestor, AncestorType=views:ProfileSettingsWindow}"/>
                        <Binding Path="Key" Mode="OneWay"/>
                    </MultiBinding>
                </RadioButton.IsChecked>
            </RadioButton>
            <TextBox Text="{Binding Item.Name}" 
                     Padding="0"
                     x:Name="MainTextBox"
                     IsReadOnly="{Binding IsRenaming, Converter={StaticResource InvertBooleanConverter}}"
                     VerticalAlignment="Center" Margin="6 0 0 0"
                     LostFocus="TextBox_OnLostFocus"
                     BorderThickness="0"
                     Focusable="{Binding IsRenaming}"
                     IsHitTestVisible="{Binding IsRenaming}"
                     KeyDown="TextBox_OnKeyDown"/>
        </StackPanel>
    </Grid>
</UserControl>
