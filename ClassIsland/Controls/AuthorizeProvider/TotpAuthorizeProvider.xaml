<ci:AuthorizeProviderControlBase x:TypeArguments="authorizeProviderSettings:TotpAuthorizeSettings"
                                 x:Class="ClassIsland.Controls.AuthorizeProvider.TotpAuthorizeProvider"
                                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                                 xmlns:local="clr-namespace:ClassIsland.Controls.AuthorizeProvider"
                                 xmlns:ci="http://classisland.tech/schemas/xaml/core"
                                 xmlns:authorizeProviderSettings="clr-namespace:ClassIsland.Models.AuthorizeProviderSettings"
                                 xmlns:ciCore="clr-namespace:ClassIsland.Core.Controls;assembly=ClassIsland.Core"
                                 xmlns:remix="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.RemixIcon"
                                 mc:Ignorable="d"
                                 d:DesignHeight="450" d:DesignWidth="800"
                                 Loaded="TotpAuthorizeProvider_OnLoaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0 0 0 8"
                    Visibility="{Binding IsEditingMode, RelativeSource={RelativeSource FindAncestor, AncestorType=local:TotpAuthorizeProvider}, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="在验证器应用中添加下列密钥，然后输入动态验证码以确认。" TextWrapping="Wrap"/>
            <TextBox x:Name="SecretBox" IsReadOnly="True" Margin="0 4 0 0"
                     FontFamily="Consolas" FontSize="15"/>
            <TextBox x:Name="UriBox" IsReadOnly="True" Margin="0 4 0 0"
                     FontSize="11" TextWrapping="Wrap"/>
            <Button Style="{StaticResource MahApps.Styles.Button.Flat}"
                    Margin="0 4 0 0"
                    HorizontalAlignment="Left"
                    Click="ButtonRegenerateSecret_OnClick">
                <ciCore:RemixIconText Kind="{x:Static remix:PackIconRemixIconKind.RefreshLine}" Text="重新生成"/>
            </Button>
        </StackPanel>

        <TextBox Grid.Row="1" Grid.Column="0" x:Name="CodeBox"
                 mah:TextBoxHelper.Watermark="动态验证码"
                 MaxLength="6"
                 KeyDown="CodeBox_OnKeyDown"/>
        <Button Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                Style="{StaticResource MahApps.Styles.Button.Flat}"
                VerticalContentAlignment="Center"
                ToolTip="验证"
                Click="ButtonVerify_OnClick">
            <ciCore:RemixIconText Kind="{x:Static remix:PackIconRemixIconKind.ArrowRightLine}"/>
        </Button>

        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                   Text="验证码不正确。" Foreground="IndianRed"
                   Visibility="{Binding AuthorizeFailed, RelativeSource={RelativeSource FindAncestor, AncestorType=local:TotpAuthorizeProvider}, Converter={StaticResource BooleanToVisibilityConverter}}"
                   Margin="0 4 0 0"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                   x:Name="VerifyStatusText" Foreground="ForestGreen"
                   Visibility="Collapsed"
                   Margin="0 4 0 0"/>
    </Grid>
</ci:AuthorizeProviderControlBase>
