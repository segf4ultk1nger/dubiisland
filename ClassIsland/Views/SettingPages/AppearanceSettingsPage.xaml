<controls:SettingsPageBase x:Class="ClassIsland.Views.SettingPages.AppearanceSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ClassIsland.Views.SettingPages"
      xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
      xmlns:controls1="clr-namespace:ClassIsland.Core.Controls;assembly=ClassIsland.Core"
      xmlns:converters="clr-namespace:ClassIsland.Core.Converters;assembly=ClassIsland.Core"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="外观"
      TextElement.Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
      Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
      FontFamily="{StaticResource HarmonyOsSans}"
      TextElement.FontWeight="Regular"
      TextElement.FontSize="14"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextRenderingMode="Auto"
      d:DataContext="{d:DesignInstance local:AppearanceSettingsPage}">

    <controls:SettingsPageBase.Resources>
        <converters:ColorToColorPickerBrushConverter x:Key="ColorToColorPickerBrushConverter" />
    </controls:SettingsPageBase.Resources>
    <ScrollViewer>
        <StackPanel Style="{StaticResource SettingsPageStackPanelStyle}" Tag="CanPolicyDisable">
            <controls1:IconText Kind="{x:Static controls1:IconGlyphs.CogOutline}" Text="基本" Margin="0 0 0 8" />
            <!-- 界面缩放 -->
            <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.ZoomInOutline}" Header="界面缩放"
                                                           Description="主界面的缩放大小。">
                <controls1:SettingsCard.Switcher>
                    <Slider Width="180" Minimum="0.75" Maximum="2.5"
                                                    VerticalAlignment="Center"
                                                    Value="{Binding SettingsService.Settings.Scale}"
                                                    AutoToolTipPlacement="BottomRight"
                                                    TickFrequency="0.05"
                                                    TickPlacement="None"
                                                    IsSnapToTickEnabled="True"
                                                    AutoToolTipPrecision="2" />
                </controls1:SettingsCard.Switcher>
            </controls1:SettingsCard>
            <!--背景颜色-->
            <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.FormatColorFill}"
                                    Header="背景颜色"
                                    Description="主界面背景颜色，禁用时随主题自动选择。"
                                    Margin="0 0 0 6">
                <controls1:SettingsCard.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <controls1:ColorPicker VerticalAlignment="Center"
                                        Margin="0 0 6 0"
                                        Color="{Binding SettingsService.Settings.BackgroundColor, Mode=TwoWay}"
                                        Visibility="{Binding SettingsService.Settings.IsCustomBackgroundColorEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ToggleButton VerticalAlignment="Center" IsChecked="{Binding SettingsService.Settings.IsCustomBackgroundColorEnabled}"/>
                    </StackPanel>
                </controls1:SettingsCard.Switcher>
            </controls1:SettingsCard>
            <!-- 背景不透明度 -->
            <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.SquareTransparent}" Header="背景不透明度"
                                                           Description="主界面背景的不透明度。">
                <controls1:SettingsCard.Switcher>
                    <Slider Width="180" Minimum="0" Maximum="1"
                                                    Value="{Binding SettingsService.Settings.Opacity}"
                                                    AutoToolTipPlacement="BottomRight"
                                                    TickFrequency="0.05"
                                                    IsSnapToTickEnabled="True"
                                                    AutoToolTipPrecision="2" />
                </controls1:SettingsCard.Switcher>
            </controls1:SettingsCard>
            <!-- 圆角半径 -->
            <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.BorderRoundCorners}" Header="圆角半径"
                                    Description="主界面圆角半径，最大时左右边缘为半圆。">
                <controls1:SettingsCard.Switcher>
                    <Slider Grid.Column="1" Grid.Row="0" Width="180" Minimum="0" Maximum="20"
                            Value="{Binding SettingsService.Settings.RadiusX}"
                            AutoToolTipPlacement="BottomRight"
                            TickFrequency="0.5"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            AutoToolTipPrecision="1" />
                </controls1:SettingsCard.Switcher>
            </controls1:SettingsCard>
            <!-- 行间隔 -->
            <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.Margin}" Header="行间隔"
                                    Description="主界面行间间隔。">
                <controls1:SettingsCard.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <Slider Width="130" Minimum="0" Maximum="150"
                                Value="{Binding SettingsService.Settings.MainWindowLineVerticalMargin}"
                                AutoToolTipPlacement="BottomRight"
                                TickFrequency="5"
                                IsSnapToTickEnabled="True"
                                AutoToolTipPrecision="1" />
                        <TextBox Text="{Binding SettingsService.Settings.MainWindowLineVerticalMargin, Converter={StaticResource IntToStringConverter}}"
                                 Width="50"/>
                    </StackPanel>
                </controls1:SettingsCard.Switcher>
            </controls1:SettingsCard>
            <Separator Margin="0 16 0 8" />
            <controls1:IconText Kind="{x:Static controls1:IconGlyphs.PaletteOutline}" Text="主题" Margin="0 0 0 8" />
            <!-- 应用主题 -->
            <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.ThemeLightDark}" Header="应用主题"
                                                           Description="控制应用的明暗主题。">
                <controls1:SettingsCard.Switcher>
                    <Grid>
                        <ComboBox Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                                  SelectedIndex="{Binding SettingsService.Settings.Theme}"
                                  HorizontalContentAlignment="Left">
                            <controls1:IconText Kind="{x:Static controls1:IconGlyphs.ThemeLightDark}" Text="跟随系统" />
                            <controls1:IconText Kind="{x:Static controls1:IconGlyphs.WhiteBalanceSunny}" Text="明亮" />
                            <controls1:IconText Kind="{x:Static controls1:IconGlyphs.WeatherNight}" Text="黑暗" />
                        </ComboBox>
                    </Grid>
                </controls1:SettingsCard.Switcher>
            </controls1:SettingsCard>
            <!-- 主题色来源 -->
            <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.PaletteSwatchOutline}" Header="主题色来源"
                                                           Description="控制应用选取主题色的途径。">
                <controls1:SettingsCard.Switcher>
                    <Grid>
                        <ComboBox Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                                  SelectionChanged="ButtonUpdateWallpaper_OnClick"
                                  HorizontalContentAlignment="Left"
                                  SelectedIndex="{Binding SettingsService.Settings.ColorSource}">
                            <controls1:IconText Kind="{x:Static controls1:IconGlyphs.UserOutline}" Text="自定义" />
                            <controls1:IconText Kind="{x:Static controls1:IconGlyphs.Wallpaper}" Text="系统壁纸" />
                            <controls1:IconText Kind="{x:Static controls1:IconGlyphs.MicrosoftWindows}" Text="系统" />
                            <controls1:IconText Kind="{x:Static controls1:IconGlyphs.PanoramaVariantOutline}" Text="屏幕主题色" />
                        </ComboBox>
                    </Grid>
                </controls1:SettingsCard.Switcher>
            </controls1:SettingsCard>
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SettingsService.Settings.ColorSource}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </StackPanel.Style>
                <!-- 第一主题色 -->
                <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.PaletteOutline}" Header="第一主题色"
                                                               Description="应用主要显示的主题颜色。">
                    <controls1:SettingsCard.Switcher>
                        <controls1:ColorPicker
                                                    Color="{Binding SettingsService.Settings.PrimaryColor, Mode=TwoWay}" />
                    </controls1:SettingsCard.Switcher>
                </controls1:SettingsCard>
                <!-- 第二主题色 -->
                <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.PaletteOutline}" Header="第二主题色"
                                                               Description="应用次要显示的主题颜色。">
                    <controls1:SettingsCard.Switcher>
                        <controls1:ColorPicker
                                                    Color="{Binding SettingsService.Settings.SecondaryColor, Mode=TwoWay}" />
                    </controls1:SettingsCard.Switcher>
                </controls1:SettingsCard>
            </StackPanel>
            <!-- 壁纸主题色 -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SettingsService.Settings.ColorSource}" Value="1">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </StackPanel.Style>
                <Separator Margin="0 16 0 8" />
                <controls1:IconText Kind="{x:Static controls1:IconGlyphs.Wallpaper}" Text="壁纸主题色" Margin="0 0 0 8" />
                <!-- 壁纸主题色 -->
                <Border>
                    <Grid>
                        <StackPanel Margin="12">
                            <controls1:IconText Kind="{x:Static controls1:IconGlyphs.PaletteOutline}" Text="选择主题色" />
                            <Grid VerticalAlignment="Bottom"
                                                          IsEnabled="{Binding WallpaperPickingService.IsWorking, Mode=OneWay, Converter={StaticResource BooleanToBooleanReConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <WrapPanel HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   Grid.Column="1">
                                    <!-- 刷新 -->
                                    <Button Style="{StaticResource MahApps.Styles.Button.Flat}"
                                                                    Click="ButtonUpdateWallpaper_OnClick"
                                                                    VerticalAlignment="Center"
                                                                    Margin="2 0">
                                        <controls1:IconText Kind="{x:Static controls1:IconGlyphs.Refresh}" Text="刷新" />
                                    </Button>
                                    <!-- 预览提取结果 -->
                                    <Button Style="{StaticResource MahApps.Styles.Button.Flat}"
                                                                    Click="ButtonPreviewWallpaper_OnClick"
                                                                    VerticalAlignment="Center"
                                                                    Margin="2 0">
                                        <controls1:IconText Kind="{x:Static controls1:IconGlyphs.EyeOutline}" Text="预览提取结果" />
                                    </Button>
                                </WrapPanel>
                                <!-- 颜色选择 -->
                                <ListBox Grid.Column="0"
                                         ItemsSource="{Binding SettingsService.Settings.WallpaperColorPlatte, Mode=OneWay}"
                                         SelectedIndex="{Binding SettingsService.Settings.SelectedPlatteIndex}"
                                         PreviewMouseWheel="UIElement_OnPreviewMouseWheel"
                                         HorizontalAlignment="Left">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel IsItemsHost="True" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Converter={StaticResource ColorToColorPickerBrushConverter}}" Width="32" Height="32">
                                                <controls1:IconText IconSize="14" Kind="{x:Static controls1:IconGlyphs.Check}"
                                                                            VerticalAlignment="Bottom"
                                                                            HorizontalAlignment="Right"
                                                                            Background="White"
                                                                            Foreground="Black"
                                                                            Visibility="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </StackPanel>
                        <ProgressBar
                                                    Visibility="{Binding WallpaperPickingService.IsWorking, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    IsIndeterminate="True"
                                                    VerticalAlignment="Top" />
                    </Grid>
                </Border>
                <!-- 启用自动提取主题色 -->
                <Border Margin="0 6 0 6">
                    <Expander Background="Transparent"
                                                      IsExpanded="{Binding SettingsService.Settings.IsWallpaperAutoUpdateEnabled, Mode=OneWay}"
                                                      TextBlock.Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}">
                        <Expander.Header>
                            <controls1:SettingsControl IconGlyph="{x:Static controls1:IconGlyphs.RefreshAuto}"
                                                                              Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                                                                              Header="启用自动提取主题色"
                                                                              Description="每分钟刷新一次壁纸主题色，适用于动态壁纸。"
                                                                              IsOn="{Binding SettingsService.Settings.IsWallpaperAutoUpdateEnabled, Mode=TwoWay}"
                                                                              Margin="-12 0" />
                        </Expander.Header>
                        <Grid Margin="36 0 48 12"
                                                      IsEnabled="{Binding SettingsService.Settings.IsWallpaperAutoUpdateEnabled, Mode=OneWay}">
                            <!-- 自动提取主题色间隔 -->
                            <controls1:SettingsControl IconGlyph="{x:Static controls1:IconGlyphs.ClockOutline}"
                                                                              Header="自动提取主题色间隔"
                                                                              Description="自动提取壁纸主题色的间隔，不宜低于10秒。">
                                <controls1:SettingsControl.Switcher>
                                    <Grid>
                                        <controls1:NumbericTextBox MaxValue="36000" MinValue="0"
                                                                   Width="150"
                                                                   Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                                                                   Style="{StaticResource MahApps.Styles.TextBox}"
                                                                   Text="{Binding SettingsService.Settings.WallpaperAutoUpdateIntervalSeconds, Mode=TwoWay, Converter={StaticResource IntToStringConverter}}" />
                                    </Grid>
                                </controls1:SettingsControl.Switcher>
                            </controls1:SettingsControl>
                        </Grid>
                    </Expander>
                </Border>

                <!-- 兼容模式 -->
                <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.CogOutline}" Header="启用兼容模式"
                                                               Description="从注册表而非桌面句柄提取壁纸；不兼容动态壁纸。"
                                                               IsOn="{Binding SettingsService.Settings.IsFallbackModeEnabled, Mode=TwoWay}" />

                <!-- 实验性取色算法 -->
                <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.FlaskOutline}" Header="实验性取色算法"
                                        Description="使用实验性取色算法，取色性能更好。"
                                        IsOn="{Binding SettingsService.Settings.UseExperimentColorPickingMethod, Mode=TwoWay}" />
                <!-- 壁纸层窗口类名 -->
                <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.WindowMaximize}" Header="壁纸层窗口类名"
                                                               Visibility="{Binding SettingsService.Settings.IsFallbackModeEnabled, Mode=OneWay, Converter={StaticResource InverseBoolToVisConverter}}"
                                                               Description="壁纸窗口类名，默认Progman；动态壁纸需填对应软件的窗口类名。">
                    <controls1:SettingsCard.Switcher>
                        <DockPanel Width="150">
                            <Button Style="{StaticResource MahApps.Styles.Button.Flat}"
                                                            Content="{controls1:GlyphIcon {x:Static controls1:IconGlyphs.WindowMaximize}}"
                                                            ToolTip="浏览…"
                                                            DockPanel.Dock="Right"
                                                            Click="ButtonBrowseWindows_OnClick" />
                            <TextBox Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                                                             Text="{Binding SettingsService.Settings.WallpaperClassName}" />
                        </DockPanel>
                    </controls1:SettingsCard.Switcher>
                </controls1:SettingsCard>
                <!-- 取色亮度波峰 -->
                <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.ChartBellCurve}" Header="取色亮度波峰"
                                        Visibility="{Binding SettingsService.Settings.UseExperimentColorPickingMethod, Converter={StaticResource InverseBoolToVisConverter}}"
                                        Description="取色时亮度越接近此值的颜色权重越高；默认值0.6。">
                    <controls1:SettingsCard.Switcher>
                        <Grid>
                            <controls1:NumbericTextBox MaxValue="1" MinValue="0" Width="150"
                                                       Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                                                       Style="{StaticResource MahApps.Styles.TextBox}"
                                                       Text="{Binding SettingsService.Settings.TargetLightValue, Mode=TwoWay, Converter={StaticResource IntToStringConverter}}" />
                        </Grid>
                    </controls1:SettingsCard.Switcher>
                </controls1:SettingsCard>
            </StackPanel>
            <!-- 屏幕主题色 -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SettingsService.Settings.ColorSource}" Value="3">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </StackPanel.Style>
                <Separator Margin="0 16 0 8" />
                <controls1:IconText Kind="{x:Static controls1:IconGlyphs.PanoramaVariantOutline}" Text="屏幕主题色" Margin="0 0 0 8" />
                <Border>
                    <Grid>
                        <ProgressBar Visibility="{Binding WallpaperPickingService.IsWorking, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" IsIndeterminate="True" VerticalAlignment="Top"/>
                        <StackPanel Margin="12">
                            <controls1:IconText Kind="{x:Static controls1:IconGlyphs.PaletteOutline}" Text="选择主题色" />
                            <Grid VerticalAlignment="Bottom" IsEnabled="{Binding WallpaperPickingService.IsWorking, Mode=OneWay, Converter={StaticResource BooleanToBooleanReConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <!-- 颜色选择 -->
                                <ListBox Grid.Column="0" HorizontalAlignment="Left"
                                         ItemsSource="{Binding SettingsService.Settings.WallpaperColorPlatte, Mode=OneWay}"
                                         SelectedIndex="{Binding SettingsService.Settings.SelectedPlatteIndex}"
                                         PreviewMouseWheel="UIElement_OnPreviewMouseWheel">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel IsItemsHost="True"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Converter={StaticResource ColorToColorPickerBrushConverter}}" Width="32" Height="32">
                                                <controls1:IconText IconSize="14" Kind="{x:Static controls1:IconGlyphs.Check}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Background="White" Foreground="Black"
                                                    Visibility="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="1">
                                    <!-- 刷新 -->
                                    <Button Click="ButtonUpdateWallpaper_OnClick" Style="{StaticResource MahApps.Styles.Button.Flat}" VerticalAlignment="Center" Margin="2 0">
                                        <controls1:IconText Kind="{x:Static controls1:IconGlyphs.Refresh}" Text="刷新"/>
                                    </Button>
                                    <!-- 预览提取结果 -->
                                    <Button Click="ButtonPreviewWallpaper_OnClick" Style="{StaticResource MahApps.Styles.Button.Flat}" VerticalAlignment="Center" Margin="2 0">
                                        <controls1:IconText Kind="{x:Static controls1:IconGlyphs.EyeOutline}" Text="预览提取结果"/>
                                    </Button>
                                </WrapPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- 自动提取主题色 -->
                <controls1:SettingsCard Margin="0 6" IconGlyph="{x:Static controls1:IconGlyphs.ClockOutline}" Header="自动提取主题色间隔" Description="自动提取屏幕主题色的间隔，建议10秒左右。">
                    <controls1:SettingsCard.Switcher>
                        <Grid>
                            <controls1:NumbericTextBox MaxValue="300" MinValue="0" Width="100" Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}" Style="{StaticResource MahApps.Styles.TextBox}"
                                                       Text="{Binding SettingsService.Settings.WallpaperAutoUpdateIntervalSeconds, Mode=TwoWay, Converter={StaticResource IntToStringConverter}}"/>
                        </Grid>
                    </controls1:SettingsCard.Switcher>
                </controls1:SettingsCard>
                <!-- 取色亮度波峰 -->
                <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.ChartBellCurve}" Header="取色亮度波峰" Description="取色时亮度越接近此值的颜色权重越高；默认值0.6。">
                    <controls1:SettingsCard.Switcher>
                        <Grid>
                            <controls1:NumbericTextBox MaxValue="1" MinValue="0" Width="100" Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}" Style="{StaticResource MahApps.Styles.TextBox}"
                                                       Text="{Binding SettingsService.Settings.TargetLightValue, Mode=TwoWay, Converter={StaticResource IntToStringConverter}}" />
                        </Grid>
                    </controls1:SettingsCard.Switcher>
                </controls1:SettingsCard>
            </StackPanel>
            <Separator Margin="0 16 0 8" />
            <controls1:IconText Kind="{x:Static controls1:IconGlyphs.FormatFont}" Text="字体" Margin="0 0 0 8" />
            <!-- 自定义字体 -->
            <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.FormatFont}" Header="自定义字体"
                                                           Description="自定义主界面显示课表的字体。">
                <controls1:SettingsCard.Switcher>
                    <Grid>
                        <ComboBox ItemsSource="{Binding ViewModel.FontFamilies}"
                                  Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                                  SelectedItem="{Binding SettingsService.Settings.MainWindowFont, Converter={StaticResource StringToFontFamilyConverter}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="{Binding}" FontWeight="Normal"
                                               ToolTip="{Binding Source}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Source}"
                                                                 Value="/ClassIsland;component/Assets/Fonts/#HarmonyOS Sans SC">
                                                        <Setter Property="Text"
                                                                Value="（默认）HarmonyOS Sans SC" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                                <Setter Property="Text" Value="{Binding Source}" />
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </controls1:SettingsCard.Switcher>
            </controls1:SettingsCard>
            <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.FormatLineWeight}" Header="自定义字重"
                                                           Description="主界面字体字重，需字体支持。">
                <controls1:SettingsCard.Switcher>
                    <Grid>
                        <ComboBox
                            SelectedItem="{Binding SettingsService.Settings.MainWindowFontWeight2, Converter={StaticResource IntToFontWeightConverter}}"
                            Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontWeight="{Binding}"
                                               ToolTip="{Binding}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                            <x:Static Member="FontWeights.Thin" />
                            <!--<x:Static Member="FontWeights.UltraLight"/>-->
                            <x:Static Member="FontWeights.ExtraLight" />
                            <x:Static Member="FontWeights.Light" />
                            <x:Static Member="FontWeights.Normal" />
                            <!--<x:Static Member="FontWeights.Regular"/>-->
                            <x:Static Member="FontWeights.Medium" />
                            <!--<x:Static Member="FontWeights.DemiBold"/>-->
                            <x:Static Member="FontWeights.SemiBold" />
                            <x:Static Member="FontWeights.Bold" />
                            <x:Static Member="FontWeights.ExtraBold" />
                            <!--<x:Static Member="FontWeights.UltraBold"/>-->
                            <x:Static Member="FontWeights.Black" />
                            <!--<x:Static Member="FontWeights.Heavy"/>-->
                            <x:Static Member="FontWeights.ExtraBlack" />
                            <!--<x:Static Member="FontWeights.UltraBlack"/>-->
                        </ComboBox>
                    </Grid>
                </controls1:SettingsCard.Switcher>
            </controls1:SettingsCard>
            <!-- 字体大小 -->
            <Border Margin="0 0 0 6">
                <Expander Background="Transparent"
                          TextBlock.Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}">
                    <Expander.Header>
                        <controls1:SettingsControl IconGlyph="{x:Static controls1:IconGlyphs.FontSize}"
                                                  Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                                                  Header="字体大小"
                                                  Description="调整主界面上各类字体的大小。"
                                                  HasSwitcher="False"
                                                  Margin="-12 0" />
                    </Expander.Header>
                    <Grid Margin="36 0 48 12">
                        <Grid.Resources>
                            <Style TargetType="controls1:NumbericTextBox" BasedOn="{StaticResource MahApps.Styles.TextBox}">
                                <Setter Property="Width" Value="100"/>
                                <Setter Property="MinValue" Value="1"/>
                                <Setter Property="MaxValue" Value="40"/>
                            </Style>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Column="0" Grid.Row="0" Text="次级字体大小（时间点附加信息）" Margin="0 0 0 6" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="0" Grid.Row="1" Text="正文字体大小（主界面）" Margin="0 0 0 6" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="0" Grid.Row="2" Text="强调字体大小（课程表、时钟、提醒标题、天气预报）" Margin="0 0 0 6" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="0" Grid.Row="3" Text="大号字体大小（课程预报）" Margin="0 0 0 6" VerticalAlignment="Center"/>

                        <controls1:NumbericTextBox
                            Grid.Column="1" Grid.Row="0"
                            Text="{Binding SettingsService.Settings.MainWindowSecondaryFontSize, Converter={StaticResource IntToStringConverter}}"/>
                        <controls1:NumbericTextBox
                            Grid.Column="1" Grid.Row="1"
                            Text="{Binding SettingsService.Settings.MainWindowBodyFontSize, Converter={StaticResource IntToStringConverter}}"/>
                        <controls1:NumbericTextBox
                            Grid.Column="1" Grid.Row="2"
                            Text="{Binding SettingsService.Settings.MainWindowEmphasizedFontSize, Converter={StaticResource IntToStringConverter}}"/>
                        <controls1:NumbericTextBox
                            Grid.Column="1" Grid.Row="3"
                            Text="{Binding SettingsService.Settings.MainWindowLargeFontSize, Converter={StaticResource IntToStringConverter}}"/>
                    </Grid>
                </Expander>
            </Border>
            <!-- 字体颜色 -->
            <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.FormatColorFill}"
                                    Header="字体颜色"
                                    Description="调整字体颜色，将覆盖主题默认值。"
                                    Margin="0 0 0 6">
                <controls1:SettingsCard.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <controls1:ColorPicker VerticalAlignment="Center"
                                        Margin="0 0 6 0"
                                        Color="{Binding SettingsService.Settings.CustomForegroundColor, Mode=TwoWay}"
                                        Visibility="{Binding SettingsService.Settings.IsCustomForegroundColorEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ToggleButton VerticalAlignment="Center" IsChecked="{Binding SettingsService.Settings.IsCustomForegroundColorEnabled}"/>
                    </StackPanel>
                </controls1:SettingsCard.Switcher>
            </controls1:SettingsCard>
            <!-- 字体预览 -->
            <TextBox Style="{StaticResource MahApps.Styles.TextBox}"
                                             FontWeight="{Binding SettingsService.Settings.MainWindowFontWeight2, Converter={StaticResource IntToFontWeightConverter}}"
                                             mah:TextBoxHelper.Watermark="字体预览"
                                             FontSize="17"
                                             Padding="8"
                                             IsReadOnly="False"
                                             AcceptsReturn="True"
                                             FontFamily="{Binding SettingsService.Settings.MainWindowFont, Mode=OneWay}"
                                             Margin="0 4 0 0"
                                             TextAlignment="Center"
                                             xml:space="preserve">悲剧并非终结，而是希望的起始。
语文 数学 英语 历史 物理 政治 化学 生物 地理
the quick brown fox jumps over a lazy dog
THE QUICK BROWN FOX JUMPS OVER A LAZY DOG
8:00-12:00 1234567890 +-*/</TextBox>
        </StackPanel>
    </ScrollViewer>
</controls:SettingsPageBase>
