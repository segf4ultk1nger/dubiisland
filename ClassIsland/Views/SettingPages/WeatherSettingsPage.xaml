<controls:SettingsPageBase x:Class="ClassIsland.Views.SettingPages.WeatherSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ClassIsland.Views.SettingPages"
      xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
      xmlns:controls1="clr-namespace:ClassIsland.Core.Controls;assembly=ClassIsland.Core"
      xmlns:controls2="clr-namespace:ClassIsland.Controls"
      xmlns:converters="clr-namespace:ClassIsland.Core.Converters;assembly=ClassIsland.Core"
      xmlns:remix="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.RemixIcon"
      xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:classIsland="clr-namespace:ClassIsland"
      xmlns:validations="clr-namespace:ClassIsland.Validations"
      xmlns:services="clr-namespace:ClassIsland.Core.Abstractions.Services;assembly=ClassIsland.Core"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="天气"
      d:DataContext="{d:DesignInstance local:WeatherSettingsPage}"
      TextElement.Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
      Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
      FontFamily="{StaticResource HarmonyOsSans}"
      TextElement.FontWeight="Regular"
      TextElement.FontSize="14"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="Auto">

    <controls:SettingsPageBase.Resources>
        <converters:CollectionToStringConverter x:Key="CollectionToStringConverter" />
        <converters:IntToRadioButtonSelectionConverter x:Key="IntToRadioButtonSelectionConverter" />
        <!-- Hero 顶部 Tab 按钮 -->
        <Style x:Key="HeroTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CCFFFFFF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" Padding="16 6" Margin="4 0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Hero 右上角按钮：半透明 Metro -->
        <Style x:Key="HeroButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#22FFFFFF" Padding="10 6" Margin="4 0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 无边框只读文本，支持选中复制 -->
        <Style x:Key="SelectableTextStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Grid Margin="16" x:Key="CitySearcher">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock Text="搜索城市" Style="{StaticResource DrawerTitleTextBlock}" />
                <Grid>
                    <TextBox Style="{StaticResource MahApps.Styles.TextBox}"
                             mah:TextBoxHelper.ClearTextButton="True"
                             TextChanged="TextBoxSearchCity_OnTextChanged"
                             mah:TextBoxHelper.Watermark="搜索城市或省份…"
                             x:Name="TextBoxSearchCity"/>
                    <ProgressBar Style="{StaticResource MahApps.Styles.ProgressBar}"
                                 IsIndeterminate="True"
                                 HorizontalAlignment="Right"
                                 Margin="0 0 18 0"
                                 IsHitTestVisible="False"
                                 Visibility="{Binding ViewModel.IsSearchingWeather, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </StackPanel>
            <!-- 城市列表 -->
            <ListBox Grid.Row="1"
                     Margin="0 8 0 0"
                     Background="Transparent"
                     BorderThickness="0"
                     Style="{StaticResource MahApps.Styles.ListBox}"
                     SelectedValuePath="CityId"
                     SelectedValue="{Binding SettingsService.Settings.CityId}"
                     ItemsSource="{Binding ViewModel.CitySearchResults}"
                     SelectionMode="Single"
                     SelectionChanged="SelectorCity_OnSelectionChanged"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource MahApps.Styles.ListBoxItem}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="8 6" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <b:Interaction.Behaviors>
                    <classIsland:AutoScrollBehavior />
                </b:Interaction.Behaviors>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Region}" Margin="8 0 0 0" Opacity="0.6" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Region}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Region}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <!-- 无结果 -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0 50">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewModel.CitySearchResults.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </StackPanel.Style>
                <controls1:IconText IconSize="81" Kind="{x:Static controls1:IconGlyphs.Search}" HorizontalAlignment="Center" />
                <TextBlock Text="找不到符合条件的城市。请更换搜索关键字，然后再试一次。" TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0 8 0 0" />
            </StackPanel>
        </Grid>
    </controls:SettingsPageBase.Resources>

    <Grid>
        <ScrollViewer x:Name="RootScroll"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Hidden"
                      ScrollChanged="RootScroll_OnScrollChanged"
                      SizeChanged="RootScroll_OnSizeChanged">
            <ScrollViewer.Template>
                <ControlTemplate TargetType="ScrollViewer">
                    <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                </ControlTemplate>
            </ScrollViewer.Template>
        <StackPanel>
            <!-- 天气 Hero -->
            <Border Background="{Binding ViewModel.HeroBackground}" Padding="24 20">
                <Grid TextElement.Foreground="White">
                <StackPanel MaxWidth="1000" TextElement.Foreground="White">
                    <!-- 城市 -->
                    <TextBlock Text="{Binding SettingsService.Settings.CityName}"
                               FontSize="18" HorizontalAlignment="Center" />

                    <!-- 主信息 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 6 0 0">
                        <remix:PackIconRemixIcon Foreground="White" Kind="{Binding ViewModel.CurrentIcon}"
                                                 Width="60" Height="60" VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" Margin="10 0 0 0" FontWeight="Light" FontSize="60"
                                   Text="{Binding SettingsService.Settings.LastWeatherInfo.Current.Temperature.Value}" />
                        <TextBlock VerticalAlignment="Top" Margin="2 10 0 0" FontSize="24" Text="℃" />
                    </StackPanel>

                    <TextBlock Text="{Binding ViewModel.CurrentWeatherText}"
                               FontSize="20" HorizontalAlignment="Center" Margin="0 2 0 0" />
                    <TextBlock HorizontalAlignment="Center" Margin="0 4 0 0" FontSize="12" Opacity="0.85"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="600"
                               Text="{Binding SettingsService.Settings.LastWeatherInfo.Aqi.Suggest}" />

                    <!-- 指标 -->
                    <StackPanel HorizontalAlignment="Center" Margin="0 14 0 0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="12 0">
                                <remix:PackIconRemixIcon Foreground="White" Kind="ThermometerFill" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Margin="4 0 0 0" FontSize="13" VerticalAlignment="Center">
                                    <Run Text="体感 " Foreground="#B3FFFFFF" /><Run Text="{Binding SettingsService.Settings.LastWeatherInfo.Current.FeelsLike.Value}" FontWeight="SemiBold" /><Run Text="{Binding SettingsService.Settings.LastWeatherInfo.Current.FeelsLike.Unit}" FontWeight="SemiBold" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="12 0">
                                <remix:PackIconRemixIcon Foreground="White" Kind="WindyFill" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Margin="4 0 0 0" FontSize="13" VerticalAlignment="Center">
                                    <Run Text="风 " Foreground="#B3FFFFFF" /><Run Text="{Binding SettingsService.Settings.LastWeatherInfo.Current.Wind.Speed.Value}" FontWeight="SemiBold" /><Run Text="{Binding SettingsService.Settings.LastWeatherInfo.Current.Wind.Speed.Unit}" FontWeight="SemiBold" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="12 0">
                                <remix:PackIconRemixIcon Foreground="White" Kind="WaterPercentFill" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Margin="4 0 0 0" FontSize="13" VerticalAlignment="Center">
                                    <Run Text="湿度 " Foreground="#B3FFFFFF" /><Run Text="{Binding SettingsService.Settings.LastWeatherInfo.Current.Humidity.Value}" FontWeight="SemiBold" /><Run Text="{Binding SettingsService.Settings.LastWeatherInfo.Current.Humidity.Unit}" FontWeight="SemiBold" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 8 0 0">
                            <StackPanel Orientation="Horizontal" Margin="12 0">
                                <remix:PackIconRemixIcon Foreground="White" Kind="DashboardFill" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Margin="4 0 0 0" FontSize="13" VerticalAlignment="Center">
                                    <Run Text="气压 " Foreground="#B3FFFFFF" /><Run Text="{Binding SettingsService.Settings.LastWeatherInfo.Current.Pressure.Value}" FontWeight="SemiBold" /><Run Text="{Binding SettingsService.Settings.LastWeatherInfo.Current.Pressure.Unit}" FontWeight="SemiBold" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="12 0">
                                <remix:PackIconRemixIcon Foreground="White" Kind="ShiningFill" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Margin="4 0 0 0" FontSize="13" VerticalAlignment="Center">
                                    <Run Text="紫外线 " Foreground="#B3FFFFFF" /><Run Text="{Binding ViewModel.UvText}" FontWeight="SemiBold" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="12 0">
                                <remix:PackIconRemixIcon Foreground="White" Kind="LeafFill" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Margin="4 0 0 0" FontSize="13" VerticalAlignment="Center">
                                    <Run Text="空气质量 " Foreground="#B3FFFFFF" /><Run Text="{Binding SettingsService.Settings.LastWeatherInfo.Aqi.AqiLevelText, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Tab 按钮 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 16 0 0">
                        <RadioButton Content="每日视图" GroupName="WeatherTab" Style="{StaticResource HeroTabStyle}"
                                     IsChecked="{Binding ViewModel.SelectedTab, Converter={StaticResource IntToRadioButtonSelectionConverter}, ConverterParameter=0}" />
                        <RadioButton Content="小时视图" GroupName="WeatherTab" Style="{StaticResource HeroTabStyle}"
                                     IsChecked="{Binding ViewModel.SelectedTab, Converter={StaticResource IntToRadioButtonSelectionConverter}, ConverterParameter=1}" />
                    </StackPanel>

                    <!-- Tab 内容 -->
                    <Grid x:Name="ForecastHost" Margin="0 12 0 0" SizeChanged="ForecastHost_OnSizeChanged">
                        <!-- 每日 -->
                        <ItemsControl ItemsSource="{Binding ViewModel.VisibleDaily}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.SelectedTab}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="88" Margin="2 0" Background="#14FFFFFF" Padding="4 8">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Center" FontSize="12" Opacity="0.85">
                                                <Run Text="{Binding DayText}" /><Run Text=" " /><Run Text="{Binding DateText}" />
                                            </TextBlock>
                                            <remix:PackIconRemixIcon Foreground="White" Kind="{Binding Icon}" Width="28" Height="28"
                                                                    HorizontalAlignment="Center" Margin="0 6"
                                                                    ToolTip="{Binding ConditionText}" />
                                            <TextBlock HorizontalAlignment="Center" FontSize="13">
                                                <Run Text="{Binding High}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Low}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 逐小时 -->
                        <ItemsControl ItemsSource="{Binding ViewModel.VisibleHourly}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ViewModel.SelectedTab}" Value="1">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="88" Margin="2 0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Center" FontSize="12" Opacity="0.85" Text="{Binding TimeText}" />
                                            <remix:PackIconRemixIcon Foreground="White" Kind="{Binding Icon}" Width="24" Height="24"
                                                                    HorizontalAlignment="Center" Margin="0 6" />
                                            <TextBlock HorizontalAlignment="Center" FontSize="14" Text="{Binding Temperature}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
                <!-- 左上角：更新时间 / 来源 -->
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
                    <TextBlock FontSize="12" Opacity="0.6">
                        <Run Text="更新时间 " /><Run Text="{Binding ViewModel.UpdateTimeText}" />
                    </TextBlock>
                    <TextBlock FontSize="12" Opacity="0.6" Text="来源: 小米天气" />
                </StackPanel>
                <!-- 右上角：刷新 -->
                <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                        Style="{StaticResource HeroButtonStyle}"
                        ToolTip="刷新"
                        Click="ButtonRefreshWeather_OnClick">
                    <StackPanel Orientation="Horizontal">
                        <remix:PackIconRemixIcon Foreground="White" Kind="RefreshLine" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="刷新" Foreground="White" Margin="4 0 0 0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                </Grid>
            </Border>

            <!-- 气象预警 -->
            <StackPanel Style="{StaticResource SettingsPageStackPanelStyle}"
                        Visibility="{Binding ViewModel.HasAlerts, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="气象预警" Style="{StaticResource SettingsSectionHeaderStyle}" />
                <ItemsControl ItemsSource="{Binding ViewModel.Alerts}" Margin="12 0 12 0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0 0 0 6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{Binding LevelTint}" />
                                        <Setter Property="Opacity" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                                                <Setter Property="Opacity" Value="0.55" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{Binding LevelBrush}" />
                                    <StackPanel Grid.Column="1" Margin="12 10 12 10">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}"
                                                       Opacity="0.6" FontSize="13" VerticalAlignment="Center" Margin="8 0 0 0" />
                                            <StackPanel Orientation="Horizontal">
                                                <remix:PackIconRemixIcon Kind="{Binding Icon}" Foreground="{Binding LevelBrush}"
                                                                         Width="20" Height="20" VerticalAlignment="Center" />
                                                <TextBox Style="{StaticResource SelectableTextStyle}" Text="{Binding Title, Mode=OneWay}"
                                                         FontSize="15" FontWeight="SemiBold"
                                                         Margin="8 0 0 0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding LevelText}" Opacity="0.6" FontSize="13"
                                                           Margin="8 0 0 0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBox Text="{Binding Detail, Mode=OneWay}" FontSize="13" Margin="0 6 0 0">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource SelectableTextStyle}">
                                                    <Setter Property="Opacity" Value="0.8" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- 设置 -->
            <StackPanel Style="{StaticResource SettingsPageStackPanelStyle}" Tag="CanPolicyDisable">
                <TextBlock Text="设置" Style="{StaticResource SettingsSectionHeaderStyle}" />

                <!-- 定位方式 -->
                <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.Earth}"
                                        Header="定位方式"
                                        Description="设置查询天气的位置及定位方式。"
                                        Margin="0 0 0 6">
                    <controls1:SettingsCard.Switcher>
                        <StackPanel>
                            <RadioButton GroupName="WeatherLocationSource"
                                         Style="{StaticResource MahApps.Styles.RadioButton.Win10}"
                                         FontSize="14"
                                         Content="选择城市"
                                         IsChecked="{Binding SettingsService.Settings.WeatherLocationSource, Converter={StaticResource IntToRadioButtonSelectionConverter}, ConverterParameter=0}" />
                            <RadioButton GroupName="WeatherLocationSource"
                                         Style="{StaticResource MahApps.Styles.RadioButton.Win10}"
                                         FontSize="14"
                                         Margin="0 8 0 0"
                                         Content="坐标定位"
                                         IsChecked="{Binding SettingsService.Settings.WeatherLocationSource, Converter={StaticResource IntToRadioButtonSelectionConverter}, ConverterParameter=1}" />
                        </StackPanel>
                    </controls1:SettingsCard.Switcher>
                </controls1:SettingsCard>

                <!-- 城市 -->
                <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.HomeCityOutline}"
                                        Header="城市"
                                        Description="选择用于天气查询的城市。"
                                        Margin="0 0 0 6">
                    <controls1:SettingsCard.Style>
                        <Style TargetType="controls1:SettingsCard">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SettingsService.Settings.WeatherLocationSource}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls1:SettingsCard.Style>
                    <controls1:SettingsCard.Switcher>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Style="{StaticResource MahApps.Styles.TextBox}"
                                     Text="{Binding SettingsService.Settings.CityName, Mode=OneWay}"
                                     IsReadOnly="True" IsTabStop="False" Focusable="False"
                                     MinWidth="220" MinHeight="32" FontSize="14"
                                     VerticalAlignment="Center" />
                            <Button Style="{StaticResource MahApps.Styles.Button.Flat}"
                                    Margin="8 0 0 0" MinHeight="32" VerticalAlignment="Center"
                                    Click="ButtonEditCurrentCity_OnClick">
                                <StackPanel Orientation="Horizontal">
                                    <remix:PackIconRemixIcon Kind="PencilFill" Width="16" Height="16" VerticalAlignment="Center" />
                                    <TextBlock Text="编辑地区" Margin="6 0 0 0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </controls1:SettingsCard.Switcher>
                </controls1:SettingsCard>

                <!-- 坐标 -->
                <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.MapOutline}"
                                        Header="坐标"
                                        Description="输入用于获取天气信息的经纬坐标。"
                                        Margin="0 0 0 6">
                    <controls1:SettingsCard.Style>
                        <Style TargetType="controls1:SettingsCard">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SettingsService.Settings.WeatherLocationSource}" Value="1">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls1:SettingsCard.Style>
                    <controls1:SettingsCard.Switcher>
                        <StackPanel Orientation="Horizontal">
                            <mah:MetroHeader Header="经度" Margin="0 0 12 0">
                                <mah:NumericUpDown Value="{Binding SettingsService.Settings.WeatherLongitude}"
                                                   MinWidth="120" MinHeight="32" FontSize="14"
                                                   Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}" />
                            </mah:MetroHeader>
                            <mah:MetroHeader Header="纬度" Margin="0 0 12 0">
                                <mah:NumericUpDown Value="{Binding SettingsService.Settings.WeatherLatitude}"
                                                   MinWidth="120" MinHeight="32" FontSize="14"
                                                   Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}" />
                            </mah:MetroHeader>
                            <mah:MetroHeader Header=" ">
                                <Button MinHeight="32" VerticalAlignment="Center" Click="ButtonGetCurrentPos_OnClick">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button.Flat}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ViewModel.IsLocating}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ViewModel.IsLocating}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <remix:PackIconRemixIcon Kind="MapPinFill" Width="16" Height="16" VerticalAlignment="Center" />
                                            <TextBlock Text="获取当前位置" Margin="6 0 0 0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ViewModel.IsLocating}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <remix:PackIconRemixIcon Kind="Loader4Fill" Width="16" Height="16" VerticalAlignment="Center" RenderTransformOrigin="0.5 0.5"
                                                                     Style="{StaticResource LoadingSpinnerStyle}">
                                                <remix:PackIconRemixIcon.RenderTransform>
                                                    <RotateTransform />
                                                </remix:PackIconRemixIcon.RenderTransform>
                                            </remix:PackIconRemixIcon>
                                            <TextBlock Text="获取中..." Margin="6 0 0 0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </mah:MetroHeader>
                        </StackPanel>
                    </controls1:SettingsCard.Switcher>
                </controls1:SettingsCard>

                <!-- 自动获取位置 -->
                <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.AutoMode}"
                                        Header="自动获取位置"
                                        Description="每次启动应用时自动更新位置。"
                                        IsOn="{Binding SettingsService.Settings.AutoRefreshWeatherLocation, Mode=TwoWay}"
                                        Margin="0 0 0 6">
                    <controls1:SettingsCard.Style>
                        <Style TargetType="controls1:SettingsCard">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SettingsService.Settings.WeatherLocationSource}" Value="1">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls1:SettingsCard.Style>
                </controls1:SettingsCard>

                <!-- 排除的气象预警 -->
                <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.FilterOutline}"
                                        Header="排除的气象预警"
                                        Description="包含以下字符串的预警不显示，一行一条。"
                                        Margin="0 0 0 6">
                    <controls1:SettingsCard.Switcher>
                        <TextBox Style="{StaticResource MahApps.Styles.TextBox}"
                                 Padding="8" MinWidth="360" MinHeight="32"
                                 MaxHeight="250"
                                 VerticalScrollBarVisibility="Auto"
                                 AcceptsReturn="True"
                                 LostFocus="TextBoxExcludedAlerts_OnLostFocus"
                                 Text="{Binding SettingsService.Settings.ExcludedWeatherAlerts, Converter={StaticResource CollectionToStringConverter}}" />
                    </controls1:SettingsCard.Switcher>
                </controls1:SettingsCard>

                <!-- 天气图标包 -->
                <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.WeatherPartlyCloudy}"
                                        Header="天气图标包"
                                        Description="调整天气类型图标的显示外观。"
                                        Margin="0 0 0 6">
                    <controls1:SettingsCard.Switcher>
                        <ComboBox Style="{StaticResource MahApps.Styles.ComboBox}"
                                  Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                                  HorizontalContentAlignment="Left"
                                  MinWidth="160" MinHeight="32" FontSize="14"
                                  ItemsSource="{x:Static services:IWeatherService.RegisteredTemplates}"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SettingsService.Settings.WeatherIconId}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </controls1:SettingsCard.Switcher>
                </controls1:SettingsCard>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
        <!-- 假滚动条（仅视觉/拖动，覆盖在内容上） -->
        <Border x:Name="FakeScrollBar" Width="12" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                Panel.ZIndex="999" Background="Transparent" Margin="0 4"
                SizeChanged="FakeScrollBar_OnSizeChanged">
            <Border x:Name="FakeScrollThumb" Width="6" HorizontalAlignment="Right" MinHeight="28"
                    Background="{DynamicResource MahApps.Brushes.ThemeForeground}" Opacity="0.35"
                    CornerRadius="4" VerticalAlignment="Top" Cursor="SizeNS"
                    MouseLeftButtonDown="FakeScrollThumb_OnMouseDown"
                    MouseMove="FakeScrollThumb_OnMouseMove"
                    MouseLeftButtonUp="FakeScrollThumb_OnMouseUp" />
        </Border>
    </Grid>
</controls:SettingsPageBase>
