<controls:SettingsPageBase x:Class="ClassIsland.Views.SettingPages.WindowSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ClassIsland.Views.SettingPages"
      xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
      xmlns:ci="http://classisland.tech/schemas/xaml/core"
      xmlns:remix="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.RemixIcon"
      xmlns:converters="clr-namespace:ClassIsland.Core.Converters;assembly=ClassIsland.Core"
      xmlns:validations="clr-namespace:ClassIsland.Validations"
      xmlns:system="clr-namespace:System;assembly=System.Runtime"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      TextElement.Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
      Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
      FontFamily="{StaticResource HarmonyOsSans}"
      TextElement.FontWeight="Regular"
      TextElement.FontSize="14"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextRenderingMode="Auto"
      Title="窗口"
      d:DataContext="{d:DesignInstance local:WindowSettingsPage}" xmlns:ciCore="clr-namespace:ClassIsland.Core.Controls;assembly=ClassIsland.Core">

    <controls:SettingsPageBase.Resources>
        <converters:IntToRadioButtonSelectionConverter x:Key="IntToRadioButtonSelectionConverter" />
    </controls:SettingsPageBase.Resources>

    <ScrollViewer>
        <StackPanel Style="{StaticResource SettingsPageStackPanelStyle}" Tag="CanPolicyDisable">
            <!-- 位置 -->
            <TextBlock Text="窗口" Style="{StaticResource SettingsSectionHeaderStyle}" />

            <!-- 显示器 -->
            <ci:SettingsCard Header="显示器"
                             Description="指定应用显示的显示器，如不存在则回退至主显示器。"
                             Margin="0 0 0 6">
                <ci:SettingsCard.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Style="{StaticResource MahApps.Styles.ComboBox}"
                                  Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                                  HorizontalContentAlignment="Left"
                                  MinWidth="260" MinHeight="32" FontSize="14"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding ViewModel.Screens, Mode=OneWay}">
                            <ComboBox.SelectedIndex>
                                <Binding Path="SettingsService.Settings.WindowDockingMonitorIndex">
                                    <Binding.ValidationRules>
                                        <validations:NotNegativeIndexValidationRule/>
                                    </Binding.ValidationRules>
                                </Binding>
                            </ComboBox.SelectedIndex>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <remix:PackIconRemixIcon Kind="MacFill" Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock VerticalAlignment="Center" Margin="6 0 0 0">
                                            <Run Text="{Binding DeviceName, Mode=OneWay}" />
                                            <Run Text="(">
                                            </Run>
                                            <Run Text="{Binding Bounds.Width, Mode=OneWay}">
                                            </Run>
                                            <Run Text="x">
                                            </Run>
                                            <Run Text="{Binding Bounds.Height, Mode=OneWay}">
                                            </Run>
                                            <Run Text=")" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Style="{StaticResource MahApps.Styles.Button.Flat}"
                                MinWidth="32" MinHeight="32" Padding="6"
                                Margin="8 0 0 0"
                                VerticalAlignment="Center"
                                ToolTip="刷新显示器列表"
                                Click="ButtonRefreshMonitors_OnClick">
                            <remix:PackIconRemixIcon Kind="RefreshLine" Width="16" Height="16" />
                        </Button>
                    </StackPanel>
                </ci:SettingsCard.Switcher>
            </ci:SettingsCard>

            <!-- 位置 -->
            <ci:SettingsCard Header="位置"
                             Description="主界面停靠到屏幕的位置。"
                             Margin="0 0 0 6">
                <ci:SettingsCard.Switcher>
                    <ComboBox Style="{StaticResource MahApps.Styles.ComboBox}"
                              Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                              HorizontalContentAlignment="Left"
                              MinWidth="260" MinHeight="32" FontSize="14"
                              VerticalAlignment="Center"
                              SelectedIndex="{Binding SettingsService.Settings.WindowDockingLocation, Mode=TwoWay}">
                        <ComboBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <remix:PackIconRemixIcon Kind="ArrowLeftUpBoxFill" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="左上" Margin="6 0 0 0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <remix:PackIconRemixIcon Kind="ArrowUpBoxFill" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="上" Margin="6 0 0 0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <remix:PackIconRemixIcon Kind="ArrowRightUpBoxFill" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="右上" Margin="6 0 0 0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <remix:PackIconRemixIcon Kind="ArrowLeftDownBoxFill" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="左下" Margin="6 0 0 0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <remix:PackIconRemixIcon Kind="ArrowDownBoxFill" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="下" Margin="6 0 0 0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <StackPanel Orientation="Horizontal">
                                <remix:PackIconRemixIcon Kind="ArrowRightDownBoxFill" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="右下" Margin="6 0 0 0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ComboBoxItem>
                    </ComboBox>
                </ci:SettingsCard.Switcher>
            </ci:SettingsCard>

            <!-- 偏移 -->
            <ci:SettingsCard Header="偏移"
                             Description="在停靠位置基础上的偏移量。"
                             Margin="0 0 0 6">
                <ci:SettingsCard.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <mah:MetroHeader Header="向右偏移" Margin="0 0 12 0">
                            <mah:NumericUpDown Value="{Binding SettingsService.Settings.WindowDockingOffsetX}"
                                               MinWidth="120" MinHeight="32" FontSize="14"
                                               Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}" />
                        </mah:MetroHeader>
                        <mah:MetroHeader Header="向下偏移">
                            <mah:NumericUpDown Value="{Binding SettingsService.Settings.WindowDockingOffsetY}"
                                               MinWidth="120" MinHeight="32" FontSize="14"
                                               Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}" />
                        </mah:MetroHeader>
                    </StackPanel>
                </ci:SettingsCard.Switcher>
            </ci:SettingsCard>

            <!-- 行为 -->
            <TextBlock Text="行为" Style="{StaticResource SettingsSectionHeaderStyle}" />

            <!-- 窗口层级 -->
            <ci:SettingsCard Header="窗口层级"
                                    Description="置底会显示在所有窗口后面，置顶显示在最前面。">
                <ci:SettingsCard.Switcher>
                    <StackPanel>
                        <RadioButton GroupName="WindowLayer"
                                     Style="{StaticResource MahApps.Styles.RadioButton.Win10}"
                                     FontSize="14"
                                     Content="置底"
                                     IsChecked="{Binding SettingsService.Settings.WindowLayer, Converter={StaticResource IntToRadioButtonSelectionConverter}, ConverterParameter=0}" />
                        <RadioButton GroupName="WindowLayer"
                                     Style="{StaticResource MahApps.Styles.RadioButton.Win10}"
                                     FontSize="14"
                                     Margin="0 8 0 0"
                                     Content="置顶"
                                     IsChecked="{Binding SettingsService.Settings.WindowLayer, Converter={StaticResource IntToRadioButtonSelectionConverter}, ConverterParameter=1}" />
                    </StackPanel>
                </ci:SettingsCard.Switcher>
            </ci:SettingsCard>

            <!-- 指针移入淡化 -->
            <ci:SettingsCard IconGlyph="{x:Static ciCore:IconGlyphs.MouseMoveDown}"
                             Header="指针移入淡化"
                             Description="鼠标移入或触屏点击主界面时淡化主界面。"
                             IsOn="{Binding SettingsService.Settings.IsMouseInFadingEnabled, Mode=TwoWay}"
                             Margin="0 0 0 6" />

            <!-- 指针移入淡化：子选项（开启时显示） -->
            <StackPanel Margin="0 0 0 6"
                        Visibility="{Binding SettingsService.Settings.IsMouseInFadingEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Background="#22FF0000" Visibility="{Binding SettingsService.Settings.IsErrorLoadingRawInput, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0 0 0 4">
                    <Grid TextElement.FontSize="13">
                        <DockPanel Margin="8 4 4 4">
                            <ciCore:IconText Kind="{x:Static ciCore:IconGlyphs.ErrorOutline}"
                                                     Margin="0 0 4 0"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="初始化 RawInput 失败，将使用兼容模式判断光标位置。详细请查看日志。"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Grid>
                </Border>
                <Border Background="{DynamicResource MahApps.Brushes.Control.Background}" Visibility="{Binding SettingsService.Settings.UseRawInput, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0 0 0 4">
                    <Grid TextElement.FontSize="13">
                        <DockPanel Margin="8 4 4 4">
                            <ciCore:IconText Kind="{x:Static ciCore:IconGlyphs.InfoCircleOutline}"
                                                     Margin="0 0 4 0"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="使用原始输入判断鼠标位置时，如果前台窗口的进程以管理员身份运行，可能会出现无法判定鼠标位置的情况。以管理员身份运行 LegacyIsland 可以解决此问题。"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Grid>
                </Border>

                <!-- 使用原始输入 -->
                <ci:SettingsCard IconGlyph="{x:Static ciCore:IconGlyphs.Input}"
                                 Header="使用原始输入"
                                 Description="解决触摸屏定位偏移的问题，不支持时禁用。"
                                 IsOn="{Binding SettingsService.Settings.UseRawInput, Mode=TwoWay}"
                                 Margin="0 0 0 6" />

                <!-- 触屏点击后自动恢复 -->
                <ci:SettingsCard IconGlyph="{x:Static ciCore:IconGlyphs.ClockOutline}"
                                 Visibility="{Binding SettingsService.Settings.UseRawInput, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Header="触屏点击后自动恢复时间"
                                 Description="触屏点击主界面后自动恢复显示；0为禁用。"
                                 Margin="0 0 0 6">
                    <ci:SettingsCard.Switcher>
                        <ComboBox
                                 Width="100"
                                 IsEditable="True"
                                 MinHeight="32" FontSize="14"
                                 Text="{Binding SettingsService.Settings.TouchInFadingDurationMs, Converter={StaticResource IntToStringConverter}}"
                                 Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}">
                            <system:String>0</system:String>
                            <system:String>1500</system:String>
                            <system:String>3000</system:String>
                            <system:String>4500</system:String>
                            <system:String>6000</system:String>
                        </ComboBox>
                    </ci:SettingsCard.Switcher>
                </ci:SettingsCard>

                <!-- 反转指针移入淡化 -->
                <ci:SettingsCard IconGlyph="{x:Static ciCore:IconGlyphs.MouseMoveUp}"
                                 Header="反转指针移入淡化"
                                 Description="默认淡化主界面，仅鼠标移入时显示；不影响隐藏。"
                                 IsOn="{Binding SettingsService.Settings.IsMouseInFadingReversed, Mode=TwoWay}" />
            </StackPanel>

            <!-- 兼容透明模式 -->
            <ci:SettingsCard IconGlyph="{x:Static ciCore:IconGlyphs.CogOutline}"
                             Header="兼容透明模式"
                             Description="改用 AllowTransparency 实现透明，占用更高，不支持全屏提醒特效。"
                             IsOn="{Binding SettingsService.Settings.IsCompatibleWindowTransparentEnabled, Mode=TwoWay}"
                             Margin="0 0 0 6" />
            
            <!-- 使用原始屏幕尺寸 -->
            <ci:SettingsCard IconGlyph="{x:Static ciCore:IconGlyphs.DockWindow}"
                                   Header="使用屏幕尺寸而非工作区尺寸"
                                   Description="开启后会直接使用整个屏幕区域参与布局。不会为任务栏预留空间。"
                                   IsOn="{Binding SettingsService.Settings.IsIgnoreWorkAreaEnabled, Mode=TwoWay}"
                                   Margin="0 0 0 6" />

        </StackPanel>
    </ScrollViewer>
</controls:SettingsPageBase>
