<ci:SettingsPageBase x:Class="ClassIsland.Views.SettingPages.ScriptsSettingsPage"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:local="clr-namespace:ClassIsland.Views.SettingPages"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:controls1="clr-namespace:ClassIsland.Controls"
                     xmlns:ciCore="clr-namespace:ClassIsland.Core.Controls;assembly=ClassIsland.Core"
                     xmlns:remix="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.RemixIcon"
                     mc:Ignorable="d"
                     d:DesignHeight="450"
                     d:DesignWidth="800"
                     d:DataContext="{d:DesignInstance local:ScriptsSettingsPage}"
                     Title="ScriptsSettingsPage"
                     TextElement.Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                     Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                     FontFamily="{StaticResource HarmonyOsSans}"
                     TextElement.FontWeight="Regular"
                     TextElement.FontSize="14"
                     TextOptions.TextFormattingMode="Ideal"
                     TextOptions.TextRenderingMode="Auto">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Grid Grid.Row="0" Margin="6 12 6 6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Style="{StaticResource MahApps.Styles.Button.Flat}"
                        VerticalAlignment="Center"
                        Click="ButtonNewScript_OnClick">
                    <ciCore:RemixIconText Kind="{x:Static remix:PackIconRemixIconKind.FileAddLine}" Text="新建脚本" />
                </Button>
                <Button Style="{StaticResource MahApps.Styles.Button.Flat}"
                        VerticalAlignment="Center"
                        Click="ButtonOpenDirectory_OnClick">
                    <ciCore:RemixIconText Kind="{x:Static remix:PackIconRemixIconKind.FolderOpenLine}" Text="打开目录" />
                </Button>
                <Button Style="{StaticResource MahApps.Styles.Button.Flat}"
                        VerticalAlignment="Center"
                        Click="ButtonRefresh_OnClick">
                    <ciCore:RemixIconText Kind="{x:Static remix:PackIconRemixIconKind.RefreshLine}" Text="刷新" />
                </Button>
                <Button Style="{StaticResource MahApps.Styles.Button.Flat}"
                        VerticalAlignment="Center"
                        Click="ButtonImportLegacy_OnClick"
                        ToolTip="将旧版规则集/自动化/时间点行动转换为脚本与条件表达式">
                    <ciCore:RemixIconText Kind="{x:Static remix:PackIconRemixIconKind.ImportLine}" Text="从旧配置导入" />
                </Button>
                <TextBlock Text="配置方案：Default"
                           VerticalAlignment="Center"
                           Opacity="0.75"
                           Margin="8 0 0 0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="启用脚本" VerticalAlignment="Center" Margin="0 0 6 0" />
                <mah:ToggleSwitch OnContent="开"
                                  OffContent="关"
                                  MinWidth="0"
                                  IsOn="{Binding SettingsService.Settings.IsScriptingEnabled, Mode=TwoWay}" />
            </StackPanel>
        </Grid>

        <!-- 列表 / 编辑器 -->
        <controls1:ListDetailView Grid.Row="1"
                                  Margin="4 0 0 0"
                                  ShowTitleWhenNotCompressed="True"
                                  IsPanelOpened="{Binding ViewModel.IsPanelOpened, Mode=TwoWay}">
            <controls1:ListDetailView.LeftContent>
                <ScrollViewer>
                    <ListBox ItemsSource="{Binding ViewModel.Documents}"
                             Style="{StaticResource NavigationPrimaryListBox}"
                             SelectedItem="{Binding ViewModel.SelectedDocument, Mode=TwoWay}"
                             SelectionChanged="ListBox_SelectionChanged"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel HorizontalAlignment="Stretch">
                                    <CheckBox DockPanel.Dock="Right"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding Enabled, Mode=OneWay}"
                                              Click="ScriptEnabled_OnClick"
                                              ToolTip="启用" />
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Margin="2 0 6 0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#2EA043" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Faulted">
                                                            <Setter Property="Fill" Value="#C0392B" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Disabled">
                                                            <Setter Property="Fill" Value="#888888" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock VerticalAlignment="Center" Margin="0 0 6 0" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="OK" />
                                                    <Setter Property="Foreground" Value="#2EA043" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Faulted">
                                                            <Setter Property="Text" Value="错误" />
                                                            <Setter Property="Foreground" Value="#C0392B" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Disabled">
                                                            <Setter Property="Text" Value="禁用" />
                                                            <Setter Property="Foreground" Value="#888888" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding FileName}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Opacity="0.6"
                                                   FontSize="12" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </controls1:ListDetailView.LeftContent>

            <controls1:ListDetailView.RightContent>
                <Grid>
                    <!-- 未选择脚本时的占位符 -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewModel.SelectedDocument}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ciCore:RemixIconText IconSize="56" Kind="{x:Static remix:PackIconRemixIconKind.CodeBoxLine}" />
                        <TextBlock Text="在左侧选择或新建一个脚本，然后在此处编辑。"
                                   TextWrapping="Wrap"
                                   Margin="0 4 0 0" />
                    </StackPanel>

                    <!-- 编辑器 -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViewModel.SelectedDocument}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 元数据 -->
                        <StackPanel Grid.Row="0" Margin="0 0 0 6">
                            <TextBox mah:TextBoxHelper.Watermark="显示名称"
                                     mah:TextBoxHelper.UseFloatingWatermark="True"
                                     Text="{Binding ViewModel.SelectedDocument.Name, UpdateSourceTrigger=PropertyChanged}"
                                     LostFocus="NameTextBox_OnLostFocus"
                                     FontWeight="Medium"
                                     FontSize="15"
                                     Margin="0 0 0 4" />
                            <TextBlock Text="{Binding ViewModel.SelectedDocument.FileName}"
                                       Opacity="0.6"
                                       FontSize="12" />
                        </StackPanel>

                        <!-- 操作按钮 -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 0 0 6">
                            <Button Style="{StaticResource MahApps.Styles.Button.Flat}"
                                    Click="ButtonSave_OnClick">
                                <ciCore:RemixIconText Kind="{x:Static remix:PackIconRemixIconKind.SaveLine}" Text="保存" />
                            </Button>
                            <Button Style="{StaticResource MahApps.Styles.Button.Flat}"
                                    Click="ButtonReload_OnClick">
                                <ciCore:RemixIconText Kind="{x:Static remix:PackIconRemixIconKind.RefreshLine}" Text="重载" />
                            </Button>
                            <Button Style="{StaticResource MahApps.Styles.Button.Flat}"
                                    Click="ButtonRun_OnClick">
                                <ciCore:RemixIconText Kind="{x:Static remix:PackIconRemixIconKind.PlayCircleLine}" Text="试运行" />
                            </Button>
                            <Button Style="{StaticResource MahApps.Styles.Button.Flat}"
                                    Click="ButtonRecover_OnClick">
                                <ciCore:RemixIconText Kind="{x:Static remix:PackIconRemixIconKind.ArrowGoBackLine}" Text="恢复" />
                            </Button>
                        </StackPanel>

                        <!-- 编辑器与错误提示 -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox Grid.Row="0"
                                     Text="{Binding ViewModel.EditorText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     AcceptsTab="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="13"
                                     MinHeight="160"
                                     mah:TextBoxHelper.Watermark="脚本内容…" />
                            <TextBlock Grid.Row="1"
                                       Text="{Binding ViewModel.SelectedDocument.LastError}"
                                       TextWrapping="Wrap"
                                       Foreground="#C0392B"
                                       Margin="0 4 0 0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ViewModel.SelectedDocument.LastError}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <TextBlock Grid.Row="3"
                                   Text="保存后将立即重新加载该脚本。脚本错误不会影响其它脚本。"
                                   Opacity="0.6"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0 6 0 0" />
                    </Grid>
                </Grid>
            </controls1:ListDetailView.RightContent>
        </controls1:ListDetailView>

        <!-- 日志面板 -->
        <Grid Grid.Row="2" Margin="6 6 6 6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0">
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource MahApps.Styles.Button.Flat}"
                        Click="ButtonClearLog_OnClick">
                    <ciCore:RemixIconText Kind="{x:Static remix:PackIconRemixIconKind.DeleteBinLine}" Text="清空" />
                </Button>
                <TextBlock Text="脚本日志" FontWeight="Medium" VerticalAlignment="Center" />
            </DockPanel>
            <ListBox Grid.Row="1"
                     Height="120"
                     ItemsSource="{Binding ViewModel.Logs}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Level}" Opacity="0.6" Width="48" />
                            <TextBlock Text="{Binding File}" Opacity="0.6" Width="120" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</ci:SettingsPageBase>
