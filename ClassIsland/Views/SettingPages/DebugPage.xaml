<controls:SettingsPageBase x:Class="ClassIsland.Views.SettingPages.DebugPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mahBehaviors="clr-namespace:MahApps.Metro.Behaviors;assembly=MahApps.Metro"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ClassIsland.Views.SettingPages"
      xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
      xmlns:controls1="clr-namespace:ClassIsland.Controls"
      xmlns:controls2="clr-namespace:ClassIsland.Core.Controls;assembly=ClassIsland.Core"
      xmlns:weather="clr-namespace:ClassIsland.Core.Models.Weather;assembly=ClassIsland.Core"
      xmlns:models="clr-namespace:ClassIsland.Models"
      xmlns:ci="http://classisland.tech/schemas/xaml/core"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DebugPage"
      d:DataContext="{d:DesignInstance local:DebugPage}"
      TextElement.Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
      Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
      FontFamily="{StaticResource HarmonyOsSans}"
      TextElement.FontWeight="Regular"
      TextElement.FontSize="14"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="Auto">

    <ScrollViewer>
        <StackPanel Style="{StaticResource SettingsPageStackPanelStyle}" 
                    Visibility="{Binding ManagementService.Policy.DisableDebugMenu, Converter={StaticResource InverseBoolToVisConverter}}">
            <StackPanel.Resources>
                <Style TargetType="MenuItem" BasedOn="{StaticResource MahApps.Styles.MenuItem}">
                    <Setter Property="MinWidth" Value="2000" />
                    <Style.Resources>
                        <Style TargetType="controls2:IconText">
                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}" />
                        </Style>
                    </Style.Resources>
                </Style>
                <Style TargetType="UniformGrid">
                    <Setter Property="Columns" Value="2" />
                </Style>
            </StackPanel.Resources>
            <TextBlock Text="调试" Style="{StaticResource Headline5TextBlock}" />
            <TextBlock Margin="0 12" Foreground="IndianRed" Text="仅供调试，除非你能知道您在做什么，请不要使用以下按钮。"/>
            <MenuItem Icon="{controls2:GlyphIcon {x:Static controls2:IconGlyphs.Close}}"
                      Header="关闭调试菜单"
                      Click="ButtonCloseDebug_OnClick" />
            <Separator />
            
            <MenuItem Icon="{controls2:GlyphIcon {x:Static controls2:IconGlyphs.LightningBoltOutline}}"
                      Header="特性调试窗口"
                      Click="MenuItemFeatureDebugWindow_OnClick"/>
            <UniformGrid>
                <MenuItem IsCheckable="True" Header="调试菜单" IsChecked="{Binding SettingsService.Settings.IsDebugEnabled}" />
                <MenuItem IsCheckable="True" Header="主窗口调试界面" IsChecked="{Binding SettingsService.Settings.IsMainWindowDebugEnabled}" />
            </UniformGrid>

            <Border Margin="0 4" HorizontalAlignment="Stretch">
                <StackPanel>
                    <Viewbox Stretch="Uniform" MaxHeight="340">
                        <StackPanel Orientation="Horizontal">
                            <Calendar SelectedDate="{Binding ViewModel.TargetDate}"
                                      Style="{StaticResource MahApps.Styles.Calendar}"
                                      SelectedDatesChanged="TargetDate_OnChanged"/>
                            
                        </StackPanel>
                    </Viewbox>
                    <UniformGrid>
                        <MenuItem Grid.Column="0" Grid.Row="1"
                                  Icon="{controls2:GlyphIcon {x:Static controls2:IconGlyphs.ClockRemoveOutline}}"
                                  Header="重置调试时间偏移"
                                  Click="ButtonReset_OnClick" />
                        <mah:TimePicker Grid.Column="1" Grid.Row="1" Margin="0 0 3 0"
                                  Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                                  Style="{StaticResource MahApps.Styles.TimePickerBase}"
                                  SelectedDateTimeChanged="TargetTime_OnChanged"
                                  FontSize="16"
                                  HorizontalContentAlignment="Center"
                                  SelectedDateTime="{Binding ViewModel.TargetTime}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <UniformGrid>
                <MenuItem Icon="{controls2:GlyphIcon {x:Static controls2:IconGlyphs.FlashOutline}}" Header="触发上课" Click="MenuItemDebugTriggerOnClass_OnClick" />
                <MenuItem Icon="{controls2:GlyphIcon {x:Static controls2:IconGlyphs.PlayOutline}}" Header="启动主计时器" Click="MenuItemStartMainTimer_OnClick" />
                <MenuItem Icon="{controls2:GlyphIcon {x:Static controls2:IconGlyphs.FlashOutline}}" Header="触发下课" Click="MenuItemDebugTriggerAfterClass_OnClick" />
                <MenuItem Icon="{controls2:GlyphIcon {x:Static controls2:IconGlyphs.Pause}}" Header="停止主计时器" Click="MenuItemStopMainTimer_OnClick" />
                <MenuItem Icon="{controls2:GlyphIcon {x:Static controls2:IconGlyphs.RubbishBinOutline}}" Header="垃圾回收" Click="MenuItemGcCollect_OnClick" />
                <MenuItem IsCheckable="True" Header="正在集控管理" IsChecked="{Binding ManagementService.IsManagementEnabled}"
                          IsEnabled="{Binding ManagementService.IsManagementEnabled, Converter={StaticResource BooleanToBooleanReConverter}, Mode=OneTime}" />
            </UniformGrid>
            <Separator />

            <UniformGrid>
                <MenuItem Icon="{controls2:GlyphIcon {x:Static controls2:IconGlyphs.ArrowLeftRight}}" Header="显示快速信息迁移提示" Click="MenuItemShowComponentsMigrateTips_OnClick" />
                <MenuItem Icon="{controls2:GlyphIcon {x:Static controls2:IconGlyphs.CogOutline}}" Header="覆盖设置版本" Click="MenuItemOverwriteSettingsVersion_OnClick" />
                <MenuItem Icon="{controls2:GlyphIcon {x:Static controls2:IconGlyphs.ToyBrickOutline}}" Header="显示插件使用须知" Click="MenuItemShowPluginMarketWarning_OnClick" />
                <MenuItem Icon="{controls2:GlyphIcon {x:Static controls2:IconGlyphs.RelationManyToMany}}" Header="转储课表关系图" Click="MenuItemDumpProfileRelations_OnClick" />
                <MenuItem Icon="{controls2:GlyphIcon {x:Static controls2:IconGlyphs.RelationManyToMany}}" Header="测试课表找下级" Click="MenuItemFindNext_OnClick" />
                <MenuItem Icon="{controls2:GlyphIcon {x:Static controls2:IconGlyphs.LanguageMarkdownOutline}}" Header="打开 Markdown 文档" Click="MenuItemOpenMdDocs_OnClick" />
                <MenuItem Icon="{controls2:GlyphIcon {x:Static controls2:IconGlyphs.MessageAlertOutline}}" Header="显示测试通知" Click="MenuItemShowTestNotification_OnClick" />
                <MenuItem Icon="{controls2:GlyphIcon {x:Static controls2:IconGlyphs.MapOutline}}" Header="测试定位" Click="MenuItemTryGetLocation_OnClick" />
            </UniformGrid>

            <!-- 动画缩放 -->
            <controls2:SettingsControl IconGlyph="{x:Static controls2:IconGlyphs.BugOutline}"
                                       Header="动画缩放"
                                       Description="主界面缩放动画播放倍速。"
                                       Margin="0 13 0 0">
                <controls2:SettingsControl.Switcher>
                    <TextBox
                        Text="{Binding SettingsService.Settings.DebugAnimationScale, Mode=TwoWay, Converter={StaticResource IntToStringConverter}}"
                        MinWidth="150"
                        Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                </controls2:SettingsControl.Switcher>
            </controls2:SettingsControl>

            <!-- 时间流速 -->
            <controls2:SettingsControl IconGlyph="{x:Static controls2:IconGlyphs.ClockFast}"
                                       Header="时间流速"
                                       Description="持续调整时间偏移，控制时间流速。"
                                       Margin="0 13 0 0">
                <controls2:SettingsControl.Switcher>
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <!--<Slider Grid.Column="0"
                                Value="{Binding SettingsService.Settings.DebugTimeSpeed, Mode=TwoWay}"
                                MinWidth="200"
                                TickFrequency="10" Minimum="-100" Maximum="500" IsSnapToTickEnabled="True"/>-->
                        <TextBox Grid.Column="1"
                                 Text="{Binding SettingsService.Settings.DebugTimeSpeed, Mode=TwoWay, Converter={StaticResource IntToStringConverter}}"
                                 MinWidth="102"/>
                        <Button Grid.Column="2" Click="ButtonResetTimeSpeed_OnClick" ToolTip="重置时间流速" Style="{StaticResource MahApps.Styles.Button.Flat}"
                                Content="{controls2:GlyphIcon {x:Static controls2:IconGlyphs.ClockRemoveOutline}}"/>
                    </Grid>
                </controls2:SettingsControl.Switcher>
            </controls2:SettingsControl>

            <PasswordBox mahBehaviors:PasswordBoxBindingBehavior.Password="{Binding SettingsService.Settings.DebugGitHubAuthKey}"
                         mah:TextBoxHelper.Watermark="gh更新测试密钥"
                         Style="{StaticResource MahApps.Styles.PasswordBox}"
                         PreviewMouseWheel="UIElement_OnPreviewMouseWheel"/>
            <Separator/>
            <Expander
                      Margin="0 8 0 0">
                <Expander.Resources>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource MahApps.Styles.MenuItem}">
                        <Style.Resources>
                            <Style TargetType="controls2:IconText">
                                <Setter Property="Foreground"
                                        Value="Red" />
                            </Style>
                        </Style.Resources>
                    </Style>
                </Expander.Resources>
                <Expander.Header>
                    <ci:SettingsControl HasSwitcher="False"
                                        IconGlyph="{x:Static controls2:IconGlyphs.Bomb}"
                                        Header="危险操作"
                                        Description="没事别按。"/>
                </Expander.Header>
                <StackPanel>
                    <MenuItem Icon="{controls2:GlyphIcon {x:Static controls2:IconGlyphs.Bomb}}"
                              Header="崩溃测试"
                              Click="ButtonCrash_OnClick" />
                    <MenuItem Icon="{controls2:GlyphIcon {x:Static controls2:IconGlyphs.Bomb}}"
                              Header="崩溃测试（延迟3秒）"
                              Click="ButtonDelayCrash_OnClick"/>
                    <MenuItem Icon="{controls2:GlyphIcon {x:Static controls2:IconGlyphs.Bomb}}"
                              Header="崩溃测试（Task）"
                              Click="MenuItemCrashOnTask_OnClick" />
                    <MenuItem Icon="{controls2:GlyphIcon {x:Static controls2:IconGlyphs.Dangerous}}"
                              Header="崩溃测试（扔到栈顶）"
                              Click="MenuItemCrashTestGlobal_OnClick" />
                    <MenuItem Icon="{controls2:GlyphIcon {x:Static controls2:IconGlyphs.Dangerous}}"
                              Header="Environment.FailFast();"
                              Click="MenuItemFailFast_OnClick" />
                </StackPanel>
                
            </Expander>
        </StackPanel>
    </ScrollViewer>
</controls:SettingsPageBase>
