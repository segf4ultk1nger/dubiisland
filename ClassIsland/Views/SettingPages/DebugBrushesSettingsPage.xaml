<controls:SettingsPageBase x:Class="ClassIsland.Views.SettingPages.DebugBrushesSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ClassIsland.Views.SettingPages"
      xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DebugBrushesSettingsPage"
      d:DataContext="{d:DesignInstance local:DebugBrushesSettingsPage}"
      TextElement.Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
      Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
      FontFamily="{StaticResource HarmonyOsSans}"
      TextElement.FontWeight="Regular"
      TextElement.FontSize="14"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextRenderingMode="Auto">

    <ScrollViewer>
        <StackPanel Style="{StaticResource SettingsPageStackPanelStyle}">
            <StackPanel.Resources>
                <Style TargetType="Border">
                    <Setter Property="Padding" Value="6" />
                </Style>
            </StackPanel.Resources>
            <Border HorizontalAlignment="Stretch"
                    Background="{DynamicResource MahApps.Brushes.Accent}"
                    ToolTip="MahApps.Brushes.Accent">
                <TextBlock Text="MahApps.Brushes.Accent" />
            </Border>
            <Border HorizontalAlignment="Stretch"
                    Background="{DynamicResource MahApps.Brushes.Accent2}"
                    ToolTip="MahApps.Brushes.Accent2">
                <TextBlock Text="MahApps.Brushes.Accent2" />
            </Border>
            <Border HorizontalAlignment="Stretch"
                    Background="{DynamicResource MahApps.Brushes.Accent3}"
                    ToolTip="MahApps.Brushes.Accent3">
                <TextBlock Text="MahApps.Brushes.Accent3" />
            </Border>
            <Border HorizontalAlignment="Stretch"
                    Background="{DynamicResource MahApps.Brushes.AccentBase}"
                    ToolTip="MahApps.Brushes.AccentBase">
                <TextBlock Text="MahApps.Brushes.AccentBase" />
            </Border>
            <Border HorizontalAlignment="Stretch"
                    Background="{DynamicResource MahApps.Brushes.IdealForeground}"
                    ToolTip="MahApps.Brushes.IdealForeground">
                <TextBlock Text="MahApps.Brushes.IdealForeground" />
            </Border>
            <Border HorizontalAlignment="Stretch"
                    Background="{DynamicResource MahApps.Brushes.Highlight}"
                    ToolTip="MahApps.Brushes.Highlight">
                <TextBlock Text="MahApps.Brushes.Highlight" />
            </Border>
            <Border HorizontalAlignment="Stretch"
                    Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                    ToolTip="MahApps.Brushes.ThemeBackground">
                <TextBlock Text="MahApps.Brushes.ThemeBackground" />
            </Border>
            <Border HorizontalAlignment="Stretch"
                    Background="{DynamicResource MahApps.Brushes.Control.Background}"
                    ToolTip="MahApps.Brushes.Control.Background">
                <TextBlock Text="MahApps.Brushes.Control.Background" />
            </Border>
            <Border HorizontalAlignment="Stretch"
                    Background="{DynamicResource MahApps.Brushes.ThemeForeground}"
                    ToolTip="MahApps.Brushes.ThemeForeground">
                <TextBlock Text="MahApps.Brushes.ThemeForeground" />
            </Border>
            <Border HorizontalAlignment="Stretch"
                    Background="{DynamicResource MahApps.Brushes.Gray}"
                    ToolTip="MahApps.Brushes.Gray">
                <TextBlock Text="MahApps.Brushes.Gray" />
            </Border>
            <Border HorizontalAlignment="Stretch"
                    Background="{DynamicResource MahApps.Brushes.Gray2}"
                    ToolTip="MahApps.Brushes.Gray2">
                <TextBlock Text="MahApps.Brushes.Gray2" />
            </Border>
            <Border HorizontalAlignment="Stretch"
                    Background="{DynamicResource MahApps.Brushes.Gray7}"
                    ToolTip="MahApps.Brushes.Gray7">
                <TextBlock Text="MahApps.Brushes.Gray7" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</controls:SettingsPageBase>
