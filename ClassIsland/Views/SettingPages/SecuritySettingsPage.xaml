<ci:SettingsPageBase x:Class="ClassIsland.Views.SettingPages.SecuritySettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ClassIsland.Views.SettingPages"
      xmlns:ci="http://classisland.tech/schemas/xaml/core"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SecuritySettingsPage"
      TextElement.Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
      Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
      FontFamily="{StaticResource HarmonyOsSans}"
      TextElement.FontWeight="Regular"
      TextElement.FontSize="14"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="Auto"
      Loaded="SecuritySettingsPage_OnLoaded"
      Unloaded="SecuritySettingsPage_OnUnloaded"
      d:DataContext="{d:DesignInstance local:SecuritySettingsPage}" xmlns:ciCore="clr-namespace:ClassIsland.Core.Controls;assembly=ClassIsland.Core" xmlns:remix="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.RemixIcon">

    <ScrollViewer>
        <StackPanel Style="{StaticResource SettingsPageStackPanelStyle}" IsEnabled="{Binding ViewModel.IsLocked, Converter={StaticResource InvertBooleanConverter}}">
            <TextBlock Text="访问控制" Style="{StaticResource SettingsSectionHeaderStyle}" />
            <ci:SettingsCard
                             Header="启用访问控制"
                             Description="对敏感操作（打开设置、退出应用、换课、编辑档案）要求认证。"
                             IsOn="{Binding SettingsService.Settings.IsSecurityAccessControlEnabled, Mode=TwoWay}"
                             Margin="0 0 0 6" />
            <ci:SettingsCard
                             Header="连续失败上限"
                             Description="连续认证失败达到该次数后锁定。0 表示不限制。"
                             Margin="0 0 0 6">
                <ci:SettingsCard.Switcher>
                    <mah:NumericUpDown Value="{Binding SettingsService.Settings.SecurityMaxAuthAttempts, Mode=TwoWay}"
                                       Minimum="0" MinWidth="120" MinHeight="32" FontSize="14"
                                       Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}" />
                </ci:SettingsCard.Switcher>
            </ci:SettingsCard>
            <ci:SettingsCard
                             Header="锁定时长（秒）"
                             Description="锁定后需等待该时长才能再次尝试认证。0 表示不限制。"
                             Margin="0 0 0 6">
                <ci:SettingsCard.Switcher>
                    <mah:NumericUpDown Value="{Binding SettingsService.Settings.SecurityLockoutSeconds, Mode=TwoWay}"
                                       Minimum="0" MinWidth="120" MinHeight="32" FontSize="14"
                                       Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}" />
                </ci:SettingsCard.Switcher>
            </ci:SettingsCard>
            <Button Style="{StaticResource MahApps.Styles.Button.Flat}"
                    HorizontalAlignment="Left"
                    Margin="0 0 0 6"
                    Command="{x:Static ci:UriNavigationCommands.UriNavigationCommand}"
                    CommandParameter="classisland://app/settings/management.credentials?ci_keepHistory=true">
                <ciCore:RemixIconText Kind="{x:Static remix:PackIconRemixIconKind.ShieldKeyholeLine}" Text="管理认证方式与凭据" />
            </Button>

            <Separator Margin="0 16 0 8" />
            <TextBlock Text="进程防护" Style="{StaticResource SettingsSectionHeaderStyle}" />
            <ci:SettingsCard
                             Header="启用进程守护"
                             Description="检测并处理同族进程（防止双开）。"
                             IsOn="{Binding SettingsService.Settings.IsProcessGuardEnabled, Mode=TwoWay}"
                             Margin="0 0 0 6" />
            <ci:SettingsCard
                             Header="仅通知不结束"
                             Description="检测到同族进程时仅提示，不自动结束。"
                             IsOn="{Binding SettingsService.Settings.ProcessGuardNotifyOnly, Mode=TwoWay}"
                             Margin="0 0 0 6" />
            <ci:SettingsCard
                             Header="也处理第三方同类软件"
                             Description="同时处理 Class Widgets 等同类软件。"
                             IsOn="{Binding SettingsService.Settings.ProcessGuardKillThirdParty, Mode=TwoWay}"
                             Margin="0 0 0 6" />

            <Separator Margin="0 16 0 8" />
            <TextBlock Text="注入防护" Style="{StaticResource SettingsSectionHeaderStyle}" />
            <ci:SettingsCard
                             Header="启用注入检测"
                             Description="检测第三方 DLL 注入行为。"
                             IsOn="{Binding SettingsService.Settings.IsInjectionGuardEnabled, Mode=TwoWay}"
                             Margin="0 0 0 6" />
            <ci:SettingsCard
                             Header="尝试卸载注入的 DLL"
                             Description="检测到注入时尝试卸载；默认仅提示。"
                             IsOn="{Binding SettingsService.Settings.InjectionGuardUnloadEnabled, Mode=TwoWay}"
                             Margin="0 0 0 6" />
            <ci:SettingsCard
                             Header="关闭扩展点注入"
                             Description="通过进程缓解策略关闭扩展点注入。"
                             IsOn="{Binding SettingsService.Settings.IsExtensionPointDisableEnabled, Mode=TwoWay}"
                             Margin="0 0 0 6" />

            <Separator Margin="0 16 0 8" />
            <TextBlock Text="伪装" Style="{StaticResource SettingsSectionHeaderStyle}" />
            <ci:SettingsCard
                             Header="随机窗口标题"
                             Description="随机化窗口标题以隐藏应用。"
                             IsOn="{Binding SettingsService.Settings.IsRandomWindowTitleEnabled, Mode=TwoWay}"
                             Margin="0 0 0 6" />
            <ci:SettingsCard
                             Header="隐藏进程名"
                             Description="重启后生效。"
                             IsOn="{Binding SettingsService.Settings.IsRandomProcessNameEnabled, Mode=TwoWay}"
                             Margin="0 0 0 6" />
            <ci:SettingsCard
                             Header="阻止屏幕捕获"
                             Description="阻止屏幕录制和截图捕获本应用窗口。"
                             IsOn="{Binding SettingsService.Settings.IsWindowCaptureBlockingEnabled, Mode=TwoWay}"
                             Margin="0 0 0 6" />
        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
