<ci:SettingsPageBase x:Class="ClassIsland.Views.SettingPages.StorageSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ClassIsland.Views.SettingPages"
      xmlns:ci="http://classisland.tech/schemas/xaml/core"
      xmlns:helpers="clr-namespace:ClassIsland.Shared.Helpers;assembly=ClassIsland.Shared"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      TextElement.Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
      Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
      FontFamily="{StaticResource HarmonyOsSans}"
      TextElement.FontWeight="Regular"
      TextElement.FontSize="14"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextRenderingMode="Auto"
      d:DataContext="{d:DesignInstance local:StorageSettingsPage}"
      Title="StorageSettingsPage" xmlns:ciCore="clr-namespace:ClassIsland.Core.Controls;assembly=ClassIsland.Core">

    <ScrollViewer>
        <StackPanel MaxWidth="750" Style="{StaticResource SettingsPageStackPanelStyle}">
            <Border Background="#17ee7700" Margin="0 0 0 4" Panel.ZIndex="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Count, Source={x:Static helpers:ConfigureFileHelper.Errors}}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Margin="8 4">
                    <DockPanel>
                        <ciCore:IconText IconSize="20" Kind="{x:Static ciCore:IconGlyphs.WarningOutline}" />
                        <TextBlock TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Margin="4 0 0 0">
                            <Run Text="LegacyIsland 部分配置文件已损坏且无法加载，这些配置文件已恢复至默认值。"/>
                        </TextBlock>
                    </DockPanel>
                    <Button Style="{StaticResource MahApps.Styles.Button.Flat}" HorizontalAlignment="Left"
                            Margin="24 6 0 0" Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                            Command="{x:Static ci:UriNavigationCommands.UriNavigationCommand}"
                            CommandParameter="classisland://app/config-errors">
                        <ci:IconText Kind="{x:Static ciCore:IconGlyphs.OpenInNew}" Text="详细信息…"/>
                    </Button>
                </StackPanel>
            </Border>

            <!--<Separator Margin="0 16 0 8" />
            <TextBlock Text="存储空间" Style="{StaticResource SettingsSectionHeaderStyle}" />
            <TextBlock Text="以下是 应用内 产生的各个类型文件的空间占用情况，您可以在此处清理部分临时和缓存文件。" 
                       FontWeight="Light"
                       TextWrapping="Wrap"/>

            <Separator Margin="0 16 0 8" />-->
            <TextBlock Text="备份" Style="{StaticResource SettingsSectionHeaderStyle}" />
            <!-- 启用自动备份 -->
            <Border Margin="0 0 0 6">
                <Expander Background="Transparent"
                          IsExpanded="{Binding SettingsService.Settings.IsAutoBackupEnabled, Mode=OneWay}"
                          TextBlock.Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}">
                    <Expander.Header>
                        <ci:SettingsControl IconGlyph="{x:Static ciCore:IconGlyphs.AutoMode}"
                                                  Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                                                  Header="启用自动备份"
                                                  Description="每隔一段时间自动备份档案和配置文件。"
                                                  IsOn="{Binding SettingsService.Settings.IsAutoBackupEnabled, Mode=TwoWay}"
                                                  Margin="-12 0" />
                    </Expander.Header>
                    <StackPanel Margin="36 0 48 12"
                                IsEnabled="{Binding SettingsService.Settings.IsAutoBackupEnabled}">
                        <!-- 自动备份间隔 -->
                        <ci:SettingsControl IconGlyph="{x:Static ciCore:IconGlyphs.ClockAutoOutline}"
                                               Header="自动备份间隔"
                                               IsCompact="True"
                                               Description="自动备份时的间隔天数。"
                                               Margin="0 0 0 6">
                            <ci:SettingsControl.Switcher>
                                <TextBox
                                         Width="100"
                                         Text="{Binding SettingsService.Settings.AutoBackupIntervalDays, Converter={StaticResource IntToStringConverter}}"
                                         Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                            </ci:SettingsControl.Switcher>
                        </ci:SettingsControl>
                        <!-- 自动备份上限 -->
                        <ci:SettingsControl IconGlyph="{x:Static ciCore:IconGlyphs.ArchiveArrowUpOutline}"
                                            Header="自动备份上限"
                                            IsCompact="True"
                                            Description="自动备份数量上限；达到后覆盖最旧备份，0为无上限。"
                                            Margin="0 0 0 6">
                            <ci:SettingsControl.Switcher>
                                <TextBox
                                         Width="100"
                                         Text="{Binding SettingsService.Settings.AutoBackupLimit, Converter={StaticResource IntToStringConverter}}"
                                         Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"/>
                            </ci:SettingsControl.Switcher>
                        </ci:SettingsControl>
                        <TextBlock TextWrapping="Wrap" Margin="0 0 0 6">
                            <Run Text="上次成功自动备份："/>
                            <Run Text="{Binding SettingsService.Settings.LastAutoBackupTime, ConverterCulture=zh-cn}"/>
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" TextAlignment="Left">
                            <Run Text="备份占用：" Foreground="White"/>
                            <Run Text="{Binding SettingsService.Settings.BackupFilesSize, ConverterCulture=zh-cn}"/>
                        </TextBlock>
                    </StackPanel>
                </Expander>
            </Border>
            <!-- 备份 -->
            <Border Padding="12 10 16 10" Margin="0 0 0 6">
                <StackPanel>
                    <ci:SettingsControl IconGlyph="{x:Static ciCore:IconGlyphs.BackupRestore}"
                                        Header="手动备份"
                                        Description="备份 Config/、Profiles/ 和 Settings.json，不会被自动清除。"
                                        Margin="0 0 0 6"
                                        HasSwitcher="False"/>
                    <WrapPanel>
                        <Button Style="{StaticResource MahApps.Styles.Button.Flat}"
                                IsEnabled="{Binding ViewModel.IsBackingUp, Converter={StaticResource InvertBooleanConverter}}"
                                Click="ButtonCreateBackup_OnClick">
                            <ci:IconText Kind="{x:Static ciCore:IconGlyphs.BackupRestore}" Text="立即备份" />
                        </Button>
                        <Button Style="{StaticResource MahApps.Styles.Button.Flat}"
                                Click="ButtonViewBackupFiles_OnClick">
                            <ci:IconText Kind="{x:Static ciCore:IconGlyphs.FolderOutline}" Text="查看备份文件…" />
                        </Button>
                        <ciCore:IconText Kind="{x:Static ciCore:IconGlyphs.Check}"
                                                 VerticalAlignment="Stretch"
                                                 ToolTip="备份成功。"
                                                 Visibility="{Binding ViewModel.IsBackupFinished, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ProgressBar Style="{StaticResource MahApps.Styles.ProgressBar}"
                                     Visibility="{Binding ViewModel.IsBackingUp, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Padding="12 10 16 10">
                <StackPanel>
                    <ci:SettingsControl IconGlyph="{x:Static ciCore:IconGlyphs.BackupRestore}"
                                        Header="恢复备份"
                                        Description="重启到恢复模式并恢复到指定的备份。"
                                        Margin="0 0 0 6"
                                        HasSwitcher="False"/>
                    <WrapPanel>
                        <Button Style="{StaticResource MahApps.Styles.Button.Flat}"
                                IsEnabled="{Binding ViewModel.IsBackingUp, Converter={StaticResource InvertBooleanConverter}}"
                                Click="ButtonRecoverBackup_OnClick">
                            <ci:IconText Kind="{x:Static ciCore:IconGlyphs.Restore}" Text="恢复备份" />
                        </Button>
                        

                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
