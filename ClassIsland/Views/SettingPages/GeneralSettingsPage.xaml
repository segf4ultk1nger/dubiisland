<controls:SettingsPageBase x:Class="ClassIsland.Views.SettingPages.GeneralSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ClassIsland.Views.SettingPages"
      xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
      xmlns:controls1="clr-namespace:ClassIsland.Core.Controls;assembly=ClassIsland.Core"
      xmlns:controls2="clr-namespace:ClassIsland.Controls"
      xmlns:remix="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.RemixIcon"
      xmlns:interfaces="clr-namespace:ClassIsland.Shared.Interfaces;assembly=ClassIsland.Shared"
      xmlns:views="clr-namespace:ClassIsland.Views"
      xmlns:converters="clr-namespace:ClassIsland.Core.Converters;assembly=ClassIsland.Core"
      xmlns:commands="clr-namespace:ClassIsland.Core.Commands;assembly=ClassIsland.Core"
      xmlns:ci="http://classisland.tech/schemas/xaml/core"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GeneralSettingsPage"
      TextElement.Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
      Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
      FontFamily="{StaticResource HarmonyOsSans}"
      TextElement.FontWeight="Regular"
      TextElement.FontSize="14"
      TextOptions.TextFormattingMode="Ideal"
      TextOptions.TextRenderingMode="Auto"
      d:DataContext="{d:DesignInstance local:GeneralSettingsPage}"
      Loaded="GeneralSettingsPage_OnLoaded"
      Unloaded="GeneralSettingsPage_OnUnloaded">

    <controls:SettingsPageBase.Resources>
        <converters:MiniInfoGuidToMiniInfoProviderMultiConverter x:Key="MiniInfoGuidToMiniInfoProviderMultiConverter" />

        <ci:RulesetControl x:Key="RulesetControl"
                           Ruleset="{Binding SettingsService.Settings.HiedRules, Mode=TwoWay}"/>

        <!-- 隐藏窗口：抽屉 -->
        <StackPanel x:Key="HideWindowDrawer" Margin="16">
            <StackPanel.Resources>
                <Style TargetType="CheckBox" BasedOn="{StaticResource MahApps.Styles.CheckBox}">
                    <Setter Property="Margin" Value="0 4" />
                </Style>
            </StackPanel.Resources>
            <TextBlock Text="隐藏窗口" Style="{StaticResource DrawerTitleTextBlock}" />
            <TextBlock Text="在以下情况隐藏主界面，避免遮挡屏幕。" Style="{StaticResource DrawerDescriptionTextBlock}" />
            <TabControl HorizontalContentAlignment="Left" SelectedIndex="{Binding SettingsService.Settings.HideMode}">
                <TabItem Header="基础模式">
                    <StackPanel Margin="0 8 0 0">
                        <CheckBox Content="上课时" IsChecked="{Binding SettingsService.Settings.HideOnClass}"/>
                        <CheckBox Content="前台是最大化窗口时" IsChecked="{Binding SettingsService.Settings.HideOnMaxWindow}" />
                        <CheckBox Content="前台是全屏窗口时" IsChecked="{Binding SettingsService.Settings.HideOnFullscreen}" />
                    </StackPanel>
                </TabItem>
                <TabItem Header="高级模式">
                    <StackPanel Margin="0 8 0 0">
                        <TextBlock Text="使用规则集自定义隐藏条件。" Opacity="0.75" TextWrapping="Wrap" Margin="0 0 0 8" />
                        <Button HorizontalAlignment="Left" Style="{StaticResource MahApps.Styles.Button.Flat}"
                                Command="{x:Static ci:SettingsPageBase.OpenDrawerCommand}"
                                CommandParameter="{StaticResource RulesetControl}">
                            <controls1:IconText Kind="{x:Static controls1:IconGlyphs.TagMultipleOutline}" Text="编辑规则集…"/>
                        </Button>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>

        <!-- 启动加载界面：抽屉 -->
        <StackPanel x:Key="SplashDrawer" Margin="16">
            <TextBlock Text="启动加载界面" Style="{StaticResource DrawerTitleTextBlock}" />
            <TextBlock Text="自定义启动时显示的加载界面。" Style="{StaticResource DrawerDescriptionTextBlock}" />
            <Grid>
                <Grid.IsEnabled>
                    <MultiBinding Converter="{StaticResource BooleanAndExpressionMultiConverter}">
                        <Binding Path="SettingsService.Settings.IsSplashEnabled"/>
                        <Binding Path="ManagementService.Policy.DisableSplashCustomize" Converter="{StaticResource InvertBooleanConverter}"/>
                    </MultiBinding>
                </Grid.IsEnabled>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="自定义启动图标（留空将加载默认图标）"
                                                   VerticalAlignment="Center" />
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBox MinWidth="120" MaxWidth="200"
                                                     Text="{Binding SettingsService.Settings.SplashCustomLogoSource}"
                                                     VerticalAlignment="Center" Margin="0 0 2 0" />
                    <controls2:FileBrowserButton
                                                CurrentPath="{Binding SettingsService.Settings.SplashCustomLogoSource, Mode=TwoWay}"
                                                VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="自定义启动文字（留空将加载默认文字）"
                                                   VerticalAlignment="Center" Margin="0 4 0 0" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"
                                                   Margin="0 4 0 0" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center">
                    <TextBox MinWidth="160" MaxWidth="200"
                                                     Text="{Binding SettingsService.Settings.SplashCustomText}"
                                                     VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                            Margin="0 4 0 0" Orientation="Horizontal">
                    <mah:ToggleSwitch IsOn="{Binding SettingsService.Settings.ShowDetailedStatusOnSplash}" OnContent="开" OffContent="关" MinWidth="0" Margin="0 0 6 0"/>
                    <TextBlock Text="在启动屏幕显示详细的状态信息" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Background="#22FF0000" Margin="0 6 0 0" Visibility="{Binding ManagementService.Policy.DisableSplashCustomize, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid TextElement.FontSize="13">
                        <DockPanel Margin="8 4 4 4">
                            <controls1:IconText Kind="{x:Static controls1:IconGlyphs.Forbid}"
                                                     Margin="0 0 4 0"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="自定义启动界面功能已被您所在的组织禁用。"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Grid>
                </Border>

                <Button Grid.Row="4" Grid.ColumnSpan="2" Grid.Column="0"
                        Margin="0 6 0 0" Style="{StaticResource MahApps.Styles.Button.Flat}"
                        HorizontalAlignment="Left" Click="ButtonRefreshSplashPreview_OnClick">
                    <ci:IconText Kind="{x:Static controls1:IconGlyphs.EyeOutline}" Text="预览"/>
                </Button>
            </Grid>
        </StackPanel>

        <!-- 使用精确时间：抽屉 -->
        <StackPanel x:Key="ExactTimeDrawer" Margin="16">
            <TextBlock Text="精确时间服务器" Style="{StaticResource DrawerTitleTextBlock}" />
            <TextBlock Text="使用从指定服务器同步的时间，而非系统时间。" Style="{StaticResource DrawerDescriptionTextBlock}" />
            <ComboBox VerticalAlignment="Center"
                      Style="{StaticResource MahApps.Styles.ComboBox}"
                      mah:TextBoxHelper.Watermark="时间服务器"
                      Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                      Text="{Binding SettingsService.Settings.ExactTimeServer}"
                      MinHeight="32"
                      FontSize="14"
                      HorizontalContentAlignment="Left"
                      IsEditable="True">
                <ComboBoxItem Content="ntp.aliyun.com"/>
                <ComboBoxItem Content="1ntp.aliyun.com"/>
                <ComboBoxItem Content="cn.ntp.org.cn"/>
                <ComboBoxItem Content="pool.ntp.org"/>
                <ComboBoxItem Content="time.windows.com"/>
            </ComboBox>
            <TextBlock Margin="0 6 0 0" Text="{Binding ExactTimeService.SyncStatusMessage}"
                       TextWrapping="Wrap" />
            <Button Margin="0 6 0 0" HorizontalAlignment="Left"
                    Click="ButtonSyncTimeNow_OnClick"
                    Style="{StaticResource MahApps.Styles.Button.Flat}">
                <controls1:IconText Kind="{x:Static controls1:IconGlyphs.Refresh}" Text="立即同步"/>
            </Button>
        </StackPanel>

        <!-- 时间偏移：抽屉 -->
        <StackPanel x:Key="TimeOffsetDrawer" Margin="16">
            <TextBlock Text="时间偏移" Style="{StaticResource DrawerTitleTextBlock}" />
            <TextBlock Text="课程时间相对实际时间的偏移；增大以抵消铃声提前，减小以抵消滞后。" Style="{StaticResource DrawerDescriptionTextBlock}" />
            <controls1:SettingsControl Header="自动时间偏移"
                                       Description="每天自动按设定的增量值调整时间偏移。">
                <controls1:SettingsControl.Switcher>
                    <StackPanel>
                        <mah:ToggleSwitch IsOn="{Binding SettingsService.Settings.IsTimeAutoAdjustEnabled}" OnContent="开" OffContent="关" MinWidth="0" HorizontalAlignment="Left"/>
                        <mah:NumericUpDown Margin="0 8 0 0" MinWidth="120" HorizontalAlignment="Left"
                                           FontSize="14"
                                           Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                                           IsEnabled="{Binding SettingsService.Settings.IsTimeAutoAdjustEnabled}"
                                           Value="{Binding SettingsService.Settings.TimeAutoAdjustSeconds}"/>
                    </StackPanel>
                </controls1:SettingsControl.Switcher>
            </controls1:SettingsControl>
        </StackPanel>
    </controls:SettingsPageBase.Resources>
    <ScrollViewer>
        <StackPanel Style="{StaticResource SettingsPageStackPanelStyle}" Tag="CanPolicyDisable">
            <!-- Announcements -->
            <ItemsControl ItemsSource="{Binding AnnouncementService.Announcements, Mode=OneWay}"
                          Margin="0 0 0 8"
                          Visibility="{Binding HasItems, RelativeSource={RelativeSource Self}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ci:AnnouncementControl Announcement="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="行为" Style="{StaticResource SettingsSectionHeaderStyle}" />
            <!-- 开机自启 -->
            <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.AutomaticStart}" Header="开机自启"
                                                           Description="系统启动时自动运行本应用。"
                                                           IsOn="{Binding SettingsService.Settings.IsAutoStartEnabled, Mode=TwoWay}" />
            <!-- 注册 Url 协议 -->
            <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.Code}" Header="注册 Url 协议"
                                    Description="允许第三方应用或网页通过 classisland:// 调用本应用功能。"
                                    IsOn="{Binding SettingsService.Settings.IsUrlProtocolRegistered, Mode=TwoWay}" />
            <!-- 学期开始时间 -->
            <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.CalendarOutline}" Header="学期开始时间"
                                    Description="作为学期的第一天，用于多周轮换课表计算，应设为一周的第一天。">
                <controls1:SettingsCard.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <DatePicker SelectedDate="{Binding SettingsService.Settings.SingleWeekStartTime}"
                                    MinWidth="180"
                                    MinHeight="32"
                                    FontSize="14"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}" />
                        <Button Style="{StaticResource MahApps.Styles.Button.Flat}"
                                Click="ButtonWeekOffsetSettingsOpen_OnClick"
                                Margin="8 0 0 0"
                                ToolTip="更改多周轮换">
                            <StackPanel Orientation="Horizontal">
                                <remix:PackIconRemixIcon Kind="CalendarScheduleFill" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="更改多周轮换" Margin="6 0 0 0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Popup AllowsTransparency="True"
                               StaysOpen="False"
                               Placement="Mouse"
                               IsOpen="{Binding ViewModel.IsWeekOffsetSettingsOpen}"
                               PopupAnimation="Fade">
                            <Border Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                                    Margin="8"
                                    Button.Click="ButtonWeekOffsetSettingsButtons_OnClick">
                                <Border.Effect>
                                    <DropShadowEffect Direction="0"
                                                      ShadowDepth="0"
                                                      BlurRadius="8"
                                                      Opacity="0.5"/>
                                </Border.Effect>
                                <controls2:WeekOffsetSettingsControl/>
                            </Border>
                        </Popup>
                    </StackPanel>
                </controls1:SettingsCard.Switcher>
            </controls1:SettingsCard>
            <!-- 隐藏窗口 -->
            <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.HideOutline}" Header="隐藏窗口"
                                    Description="在以下情况隐藏主界面，避免遮挡屏幕。">
                <controls1:SettingsCard.Switcher>
                    <Button Style="{StaticResource MahApps.Styles.Button.Flat}"
                            HorizontalAlignment="Left"
                            Click="ButtonOpenHideWindow_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <remix:PackIconRemixIcon Kind="EyeOffFill" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="隐藏条件…" Margin="6 0 0 0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </controls1:SettingsCard.Switcher>
            </controls1:SettingsCard>
            <!-- 点击托盘图标行为 -->
            <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.CursorDefaultClickOutline}"
                                                           Header="点击托盘图标行为"
                                                           Description="左键单击托盘图标的操作；右键始终打开主菜单。">
                <controls1:SettingsCard.Switcher>
                    <ComboBox Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                              MinWidth="160"
                              MinHeight="32"
                              FontSize="14"
                              VerticalAlignment="Center"
                              SelectedIndex="{Binding SettingsService.Settings.TaskBarIconClickBehavior}"
                              HorizontalContentAlignment="Left">
                        <ComboBoxItem HorizontalContentAlignment="Left">打开主菜单</ComboBoxItem>
                        <ComboBoxItem HorizontalContentAlignment="Left">打开档案编辑窗口</ComboBoxItem>
                        <ComboBoxItem HorizontalContentAlignment="Left">显示/隐藏主界面</ComboBoxItem>
                        <ComboBoxItem HorizontalContentAlignment="Left">打开换课窗口</ComboBoxItem>
                    </ComboBox>
                </controls1:SettingsCard.Switcher>
            </controls1:SettingsCard>
            <!-- 显示启动加载界面 -->
            <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.RocketLaunchOutline}" Header="显示启动加载界面"
                                    Description="启动时显示加载界面。">
                <controls1:SettingsCard.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <mah:ToggleSwitch IsOn="{Binding SettingsService.Settings.IsSplashEnabled, Mode=TwoWay}" OnContent="开" OffContent="关" MinWidth="0"/>
                        <Button Style="{StaticResource MahApps.Styles.Button.Flat}"
                                Margin="8 0 0 0"
                                Click="ButtonOpenSplash_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <remix:PackIconRemixIcon Kind="SoundModuleFill" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="自定义…" Margin="6 0 0 0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </controls1:SettingsCard.Switcher>
            </controls1:SettingsCard>

            <TextBlock Text="时钟" Style="{StaticResource SettingsSectionHeaderStyle}" />
            <!-- 使用精确时间 -->
            <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.TimerSyncOutline}" Header="使用精确时间"
                                    Description="使用从指定服务器同步的时间，而非系统时间。">
                <controls1:SettingsCard.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <mah:ToggleSwitch IsOn="{Binding SettingsService.Settings.IsExactTimeEnabled, Mode=TwoWay}" OnContent="开" OffContent="关" MinWidth="0"/>
                        <Button Style="{StaticResource MahApps.Styles.Button.Flat}"
                                Margin="8 0 0 0"
                                Click="ButtonOpenExactTime_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <remix:PackIconRemixIcon Kind="TimeZoneFill" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="配置 NTP 服务器" Margin="6 0 0 0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </controls1:SettingsCard.Switcher>
            </controls1:SettingsCard>
            <!-- 时间偏移 -->
            <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.ClockArrow}" Header="时间偏移"
                                    Description="课程时间相对实际时间的偏移；增大以抵消铃声提前，减小以抵消滞后。">
                <controls1:SettingsCard.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <mah:NumericUpDown Value="{Binding SettingsService.Settings.TimeOffsetSeconds}"
                                           MinWidth="120"
                                           MinHeight="32"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}" />
                        <Button Style="{StaticResource MahApps.Styles.Button.Flat}"
                                Margin="8 0 0 0"
                                Click="ButtonOpenTimeOffset_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <remix:PackIconRemixIcon Kind="MoreFill" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="更多…" Margin="6 0 0 0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MahApps.Styles.Button.Flat}"
                                Margin="8 0 0 0"
                                Click="ButtonAdjustTime_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <remix:PackIconRemixIcon Kind="TimerFlashFill" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="对齐铃声" Margin="6 0 0 0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </controls1:SettingsCard.Switcher>
            </controls1:SettingsCard>

            <TextBlock Text="显示" Style="{StaticResource SettingsSectionHeaderStyle}" 
                                Visibility="{Binding SettingsService.Settings.ShowComponentsMigrateTip, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <!-- 简略信息 -->
            <Border Padding="14" 
                    Margin="0 0 0 8"
                    BorderBrush="{DynamicResource MahApps.Brushes.Gray7}" 
                    BorderThickness="1" CornerRadius="8"
                    Visibility="{Binding SettingsService.Settings.ShowComponentsMigrateTip, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <StackPanel>
                        <controls1:IconText IconSize="24" Kind="{x:Static controls1:IconGlyphs.WidgetsOutline}"
                                                 Foreground="{DynamicResource MahApps.Brushes.Accent}" />
                        <TextBlock TextWrapping="Wrap" Margin="0 6 0 0">
                            【快速信息】功能已被【组件】取代，您在先前版本中的快速信息和课表显示设置已经转移到【组件】中，请前往【组件】页面调整相关设置。
                            利用组件功能，您可以更自由地定制 LegacyIsland 主界面上显示的内容。
                        </TextBlock>
                        <Button Style="{StaticResource MahApps.Styles.Button.Flat}"
                                HorizontalAlignment="Left"
                                Command="{x:Static commands:UriNavigationCommands.UriNavigationCommand}"
                                CommandParameter="classisland://app/settings/components"
                                Margin="0 4 0 0">
                            <controls1:IconText Kind="{x:Static controls1:IconGlyphs.ExternalLink}" Text="前往【组件】页面" />
                        </Button>
                    </StackPanel>
                    <Button Content="{controls1:GlyphIcon {x:Static controls1:IconGlyphs.Close}}"
                            Style="{StaticResource MahApps.Styles.Button.Flat}"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Right"
                            Padding="0"
                            Margin="0 -4 "
                            ToolTip="关闭"
                            Click="ButtonCloseMigrationTip_OnClick"/>
                </Grid>
            </Border>
            <TextBlock Text="高级" Style="{StaticResource SettingsSectionHeaderStyle}" />
            <!-- 自动禁用异常插件 -->
            <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.PuzzleRemoveOutline}"
                                    Header="自动禁用异常插件"
                                    Description="自动禁用导致应用崩溃的插件。"
                                    IsOn="{Binding SettingsService.Settings.AutoDisableCorruptPlugins, Mode=TwoWay}" />
            <!-- 禁用过渡动画 -->
            <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.AnimationPlayOutline}"
                                   Header="禁用过渡动画"
                                   Description="禁用部分控件的过渡动画，提升性能和操作效率。"
                                   IsOn="{Binding SettingsService.Settings.IsTransientDisabled, Mode=TwoWay}" />
            <!-- 禁用动画等待 -->
            <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.TimerAlertOutline}"
                                    Header="禁用动画等待"
                                    Description="阻塞 UI 线程时不等动画播完，提升加载速度。"
                                    IsOn="{Binding SettingsService.Settings.IsWaitForTransientDisabled, Mode=TwoWay}" />
            <!-- 教学安全模式 -->
            <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.CarBrakeAlert}"
                                    Header="教学安全模式"
                                    Description="崩溃时按下面的方式处理，不可捕获错误直接完蛋。">
                <controls1:SettingsCard.Switcher>
                    <StackPanel>
                        <mah:ToggleSwitch IsOn="{Binding SettingsService.Settings.IsCriticalSafeMode}" OnContent="开" OffContent="关" MinWidth="0" HorizontalAlignment="Left"/>
                        <ComboBox Margin="0 8 0 0"
                                  MinWidth="160"
                                  MinHeight="32"
                                  FontSize="14"
                                  HorizontalAlignment="Left"
                                  Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                                  Visibility="{Binding SettingsService.Settings.IsCriticalSafeMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  SelectedIndex="{Binding SettingsService.Settings.CriticalSafeModeMethod}">
                            <ComboBoxItem>退出应用</ComboBoxItem>
                            <ComboBoxItem>静默重启应用</ComboBoxItem>
                            <ComboBoxItem>显示通知</ComboBoxItem>
                            <ComboBoxItem>忽略（不推荐）</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </controls1:SettingsCard.Switcher>
            </controls1:SettingsCard>
            <!-- 工具窗口销毁积极性 -->
            <controls1:SettingsCard IconGlyph="{x:Static controls1:IconGlyphs.DockWindow}" Header="工具窗口销毁积极性"
                                    Description="更积极地销毁窗口可以占用更少的内存，但也会延长窗口打开时间。（不含主窗口）">
                <controls1:SettingsCard.Switcher>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox MinWidth="200"
                                  MinHeight="32"
                                  FontSize="14"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                                  SelectedIndex="{Binding SettingsService.Settings.ToolWindowDestructionPolicy}"
                                  HorizontalContentAlignment="Left">
                            <ComboBoxItem HorizontalContentAlignment="Left">永不销毁</ComboBoxItem>
                            <ComboBoxItem HorizontalContentAlignment="Left">闲置 1 小时后销毁</ComboBoxItem>
                            <ComboBoxItem HorizontalContentAlignment="Left">闲置 30 分钟后销毁</ComboBoxItem>
                            <ComboBoxItem HorizontalContentAlignment="Left">闲置 15 分钟后销毁</ComboBoxItem>
                            <ComboBoxItem HorizontalContentAlignment="Left">闲置 10 分钟后销毁</ComboBoxItem>
                            <ComboBoxItem HorizontalContentAlignment="Left">闲置 5 分钟后销毁</ComboBoxItem>
                            <ComboBoxItem HorizontalContentAlignment="Left">闲置 3 分钟后销毁</ComboBoxItem>
                            <ComboBoxItem HorizontalContentAlignment="Left">闲置 1 分钟后销毁</ComboBoxItem>
                            <ComboBoxItem HorizontalContentAlignment="Left">闲置 30 秒后销毁</ComboBoxItem>
                            <ComboBoxItem HorizontalContentAlignment="Left">立刻销毁</ComboBoxItem>
                            <ComboBoxItem HorizontalContentAlignment="Left">自定义定时后销毁</ComboBoxItem>
                        </ComboBox>
                        <mah:NumericUpDown MinWidth="120"
                                           MinHeight="32"
                                           FontSize="14"
                                           Margin="8 0 0 0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                                           Value="{Binding SettingsService.Settings.ToolWindowDestructionCustomSeconds}"
                                           Visibility="{Binding SettingsService.Settings.IsToolWindowDestructionCustom, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="秒" Margin="6 0 0 0" VerticalAlignment="Center"
                                   Visibility="{Binding SettingsService.Settings.IsToolWindowDestructionCustom, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </controls1:SettingsCard.Switcher>
            </controls1:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</controls:SettingsPageBase>
