<controls1:MyWindow x:Class="ClassIsland.Views.WindowsPicker"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:local="clr-namespace:ClassIsland.Views"
                   xmlns:controls="clr-namespace:ClassIsland.Controls"
                   xmlns:windows="clr-namespace:Walterlv.Windows;assembly=ClassIsland.Core"
                   xmlns:controls1="clr-namespace:ClassIsland.Core.Controls;assembly=ClassIsland.Core"
                   mc:Ignorable="d"
                   d:DataContext="{d:DesignInstance local:WindowsPicker}"
                   Height="600" Width="1300"
                   TextElement.Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                   Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                   TextElement.FontWeight="Regular"
                   TextElement.FontSize="14"
                   FontFamily="{StaticResource HarmonyOsSans}"
                   Title="选择壁纸窗口">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- Main -->
        <ListBox Grid.Row="1" ItemsSource="{Binding ViewModel.DesktopWindows, Mode=OneWay}"
                 Style="{StaticResource NavigationPrimaryListBox}"
                 SelectedValue="{Binding ViewModel.SelectedClassName}"
                 SelectionMode="Single"
                 SelectedValuePath="ClassName">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel IsItemsHost="True"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Grid ClipToBounds="True" 
                        >
                            <Image Source="{Binding ScreenShot}" Height="150" Stretch="Uniform"
                                />
                            <Border Width="40" Height="40" CornerRadius="20" Margin="8" Visibility="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}}, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Background="{DynamicResource MahApps.Brushes.Accent}" TextElement.Foreground="{DynamicResource MahApps.Brushes.IdealForeground}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" Opacity="0.5" Direction="0" ShadowDepth="0"/>
                                </Border.Effect>
                                <controls1:IconText IconSize="32" Kind="{x:Static controls1:IconGlyphs.Check}"
                                                         VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <Border Width="32" Height="32" CornerRadius="4" Margin="8" VerticalAlignment="Bottom" HorizontalAlignment="Left" Background="{DynamicResource MahApps.Brushes.ThemeBackground}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" Opacity="0.5" Direction="0" ShadowDepth="0"/>
                                </Border.Effect>
                                <Image VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Stretch="UniformToFill"
                                       Width="20" Height="20"
                                       Source="{Binding Icon}"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding Description}" FontSize="18" FontWeight="Bold" Margin="0 4 0 0"/>
                        <TextBlock Text="{Binding ClassName}" FontSize="13"/>
                        <TextBlock Text="{Binding WindowText}" FontSize="13"/>
                        <TextBlock Text="{Binding OwnerProcess.ProcessName}" FontSize="13"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 分割线 -->
        <Separator Grid.Row="2" Margin="0 8 0 0"/>
        <!-- 底栏 -->
        <Grid Grid.Row="3" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <controls1:IconText Grid.Column="0" Kind="{x:Static controls1:IconGlyphs.WindowMaximize}" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Margin="8 0"
                     VerticalAlignment="Center"
                     Text="{Binding ViewModel.SelectedClassName}"
                     mah:TextBoxHelper.Watermark="窗口类名"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource MahApps.Styles.Button.Flat}" Margin="0 0 6 0"
                        Click="ButtonCancel_OnClick">
                    <controls1:IconText Kind="{x:Static controls1:IconGlyphs.Cancel}" Text="取消"/>
                </Button>
                <Button Click="ButtonDone_OnClick">
                    <controls1:IconText Kind="{x:Static controls1:IconGlyphs.Check}" Text="确定"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Padding="16" Background="{DynamicResource MahApps.Brushes.Accent}" TextElement.Foreground="{DynamicResource MahApps.Brushes.IdealForeground}">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="选择窗口" Style="{StaticResource Headline6TextBlock}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="0 0 16 0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button ToolTip="刷新"
                            Padding="0"
                            Style="{StaticResource MahApps.Styles.Button.Flat}"
                            Content="{controls1:GlyphIcon {x:Static controls1:IconGlyphs.Refresh}, Size=24}"
                            Click="ButtonRefresh_OnClick"
                            Margin="0 0 16 0"/>
                    <Grid Margin="0 0 0 0">
<ToggleButton x:Name="PopupToggle1" Style="{StaticResource MahApps.Styles.Button.Chromeless}" ToolTip="更多选项…" Padding="4">
…
</ToggleButton>
<Popup Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False" IsOpen="{Binding IsChecked, ElementName=PopupToggle1, Mode=TwoWay}">
<Border Background="{DynamicResource MahApps.Brushes.ThemeBackground}" Padding="4">

                        <StackPanel Margin="16">
                            <CheckBox IsChecked="{Binding ViewModel.IsFilteredFullscreen}"
                                      Checked="ButtonRefresh_OnClick"
                                      Unchecked="ButtonRefresh_OnClick"
                                      Content="仅显示全屏窗口"/>
                        </StackPanel>
                    
</Border>
</Popup>
</Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="0" Grid.RowSpan="4" 
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              Visibility="{Binding ViewModel.IsWorking, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                    Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                    Opacity="0.8"/>
            <controls1:StarRailLoadingControl VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>

        <windows:AsyncBox Grid.Row="0" Grid.RowSpan="4" VerticalAlignment="Bottom" Height="6" LoadingViewType="controls:LoadingMask"/>
    </Grid>
</controls1:MyWindow>
