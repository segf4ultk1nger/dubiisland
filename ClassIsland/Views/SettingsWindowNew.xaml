<controls:MyWindow x:Class="ClassIsland.Views.SettingsWindowNew"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClassIsland.Views"
        xmlns:controls="clr-namespace:ClassIsland.Core.Controls;assembly=ClassIsland.Core"
        xmlns:dialogs="clr-namespace:ClassIsland.Core.Services;assembly=ClassIsland.Core"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:controls1="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
        xmlns:converters="clr-namespace:ClassIsland.Core.Converters;assembly=ClassIsland.Core"
        xmlns:controls2="clr-namespace:ClassIsland.Controls"
        xmlns:ci="clr-namespace:ClassIsland"
        xmlns:windows="clr-namespace:Walterlv.Windows;assembly=ClassIsland.Core"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        xmlns:converters1="clr-namespace:ClassIsland.Converters"
        xmlns:attributes="clr-namespace:ClassIsland.Core.Attributes;assembly=ClassIsland.Core"
        xmlns:remix="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.RemixIcon"
        xmlns:commands="http://classisland.tech/schemas/xaml/core"
        d:DataContext="{d:DesignInstance local:SettingsWindowNew}"
        TextElement.Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
        Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
        FontFamily="{StaticResource HarmonyOsSans}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        mc:Ignorable="d"
        MinWidth="560"
        Title="LegacyIsland 设置" Height="620" Width="867"
        ShowTitleBar="True"
        SizeChanged="SettingsWindowNew_OnSizeChanged"
        Closing="SettingsWindowNew_OnClosing"
        dialogs:DialogService.Identifier="{x:Static controls1:SettingsPageBase.DialogHostIdentifier}">
    <controls:MyWindow.Resources>
        <ScrollViewer Width="332" x:Key="ExperimentalSettings"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
                <TextBlock Text="实验性功能" Style="{StaticResource Headline5TextBlock}"
                           Margin="0 0 0 4" />
                <TextBlock Text="正在开发/测试的不稳定功能，可能会出现Bug等问题，请谨慎使用。" TextWrapping="Wrap"
                           Margin="0 0 0 16" />
                <ComboBox Style="{StaticResource MahApps.Styles.ComboBox}"
                          mah:TextBoxHelper.Watermark="设置页面缓存策略"
                          Margin="0 0 0 2"
                          SelectedIndex="{Binding SettingsService.Settings.SettingsPagesCachePolicy}">
                    <ComboBoxItem>不缓存</ComboBoxItem>
                    <ComboBoxItem>保留页面缓存到窗口关闭（可能会内存泄漏）</ComboBoxItem>
                    <ComboBoxItem>一直保留页面缓存</ComboBoxItem>
                </ComboBox>
                <TextBlock Text="设置页面缓存可以提升之前打开过的设置页面的加载速度，但会增加一定的内存占用。" TextWrapping="Wrap"
                           Opacity="0.75"
                           />

                <Expander
                          Foreground="Transparent"
                          Margin="0 24 0 0"
                          Visibility="{Binding ManagementService.Policy.DisableEasterEggs, Converter={StaticResource InverseBoolToVisConverter}}">
                    
                    <Button Style="{StaticResource MahApps.Styles.Button.Flat}"
                            Click="ButtonDoNotClickVeryDangerous_OnClick"
                            Foreground="Red"
                            HorizontalAlignment="Left"
                            >
                        <commands:IconText Kind="{x:Static controls:IconGlyphs.WarningOutline}" Text="千万别点" />
                    </Button></Expander>
            </StackPanel>
        </ScrollViewer>

        <converters1:RemixIconKindConverter x:Key="RemixIconKindConverter"/>

        <!-- 导航项：设置页面 -->
        <DataTemplate DataType="{x:Type attributes:SettingsPageInfo}">
            <Grid Height="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type mah:HamburgerMenu}}, Path=CompactPaneLength, Mode=OneWay}"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <remix:PackIconRemixIcon Grid.Column="0"
                                         Width="18" Height="18"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Kind="{Binding Id, Converter={StaticResource RemixIconKindConverter}}"
                                         Foreground="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(TextElement.Foreground)}"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}"
                           VerticalAlignment="Center" Margin="4 0 12 0"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </DataTemplate>

        <!-- 导航分组分隔线 -->
        <DataTemplate DataType="{x:Type mah:HamburgerMenuSeparatorItem}">
            <Separator Margin="8 4"/>
        </DataTemplate>
    </controls:MyWindow.Resources>
    <controls:MyWindow.CommandBindings>
        <CommandBinding Command="{x:Static controls1:SettingsPageBase.OpenDrawerCommand}" Executed="CommandBindingOpenDrawer_OnExecuted"/>
        <CommandBinding Command="{x:Static controls1:SettingsPageBase.CloseDrawerCommand}" Executed="CommandBindingCloseDrawer_OnExecuted"/>
        <CommandBinding Command="{x:Static controls1:SettingsPageBase.RequestRestartCommand}" Executed="CommandBindingRestartApp_OnExecuted"></CommandBinding>
    </controls:MyWindow.CommandBindings>
    <mah:MetroWindow.LeftWindowCommands>
        <mah:WindowCommands>
            <Button ToolTip="返回"
                    Click="ButtonGoBack_OnClick"
                    Visibility="{Binding ViewModel.CanGoBack, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <remix:PackIconRemixIcon Kind="ArrowLeftLine" Width="16" Height="16" VerticalAlignment="Center"/>
                    <TextBlock Text="返回" Margin="4 0 0 0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </mah:WindowCommands>
    </mah:MetroWindow.LeftWindowCommands>
    <mah:MetroWindow.RightWindowCommands>
        <mah:WindowCommands ShowSeparators="False">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="Button"
                           BasedOn="{StaticResource MahApps.Styles.Button.Chromeless}">
                        <Setter Property="Foreground"
                                Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type FrameworkElement}}, Path=(TextElement.Foreground)}" />
                        <Setter Property="Padding" Value="6 0" />
                        <Setter Property="Margin" Value="0 0 6 0" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                </StackPanel.Resources>
                <Button Visibility="{Binding ViewModel.IsRequestedRestart, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="部分设置需要重启应用后生效。" Click="ButtonRestartApp_OnClick">
                    <StackPanel Orientation="Horizontal">
                        <remix:PackIconRemixIcon Kind="RestartLine" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="需要重启" Margin="4 0 0 0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Visibility="{Binding ManagementService.IsManagementEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Command="{x:Static dialogs:DialogService.OpenDialogCommand}" ToolTip="查看您的单位/组织如何管理此LegacyIsland实例。">
                    <Button.CommandParameter>
                        <controls2:ManagementInfoControl />
                    </Button.CommandParameter>
                    <StackPanel Orientation="Horizontal">
                        <remix:PackIconRemixIcon Kind="SuitcaseLine" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="由贵单位管理" Margin="4 0 0 0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="{x:Static ci:App.AppVersion}"
                           Margin="8 0 0 0"
                           VerticalAlignment="Center"
                           ToolTip="应用版本" />
                <mah:DropDownButton Margin="8 0 0 0"
                                    ToolTip="更多选项…"
                                    ArrowVisibility="Collapsed"
                                    MenuStyle="{StaticResource MahApps.Styles.ContextMenu}"
                                        IsExpanded="{Binding ViewModel.IsPopupOpen, Mode=TwoWay}">
                    <mah:DropDownButton.Resources>
                        <PathGeometry x:Key="Checkmark" Figures="M 0,7.65 L 2.55,7.8 L 5.1,10.65 L 12,0.6 L 13.8,0 L 4.95,16.2 Z" />
                    </mah:DropDownButton.Resources>
                    <mah:DropDownButton.Icon>
                        <remix:PackIconRemixIcon Kind="MoreFill" Width="16" Height="16" VerticalAlignment="Center"/>
                    </mah:DropDownButton.Icon>
                    <mah:DropDownButton.ItemsSource>
                        <x:Array Type="{x:Type FrameworkElement}">
                    <MenuItem Header="实验性功能…" Click="MenuItemExperimentalSettings_OnClick">
                        <MenuItem.Icon><remix:PackIconRemixIcon Kind="FlaskFill" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="调试窗口规则…" Click="MenuItemDebugWindowRule_OnClick">
                        <MenuItem.Icon><remix:PackIconRemixIcon Kind="StethoscopeFill" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="显示调试菜单"
                              IsCheckable="True"
                              IsChecked="{Binding SettingsService.Settings.IsDebugOptionsEnabled, Mode=TwoWay}">
                        <MenuItem.Icon><remix:PackIconRemixIcon Kind="BugLine" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="创建快捷换课图标" Click="MenuItemAddClassSwapShortcut_OnClick">
                        <MenuItem.Icon><remix:PackIconRemixIcon Kind="Apps2AddFill" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="集控选项…"
                              Command="{x:Static commands:UriNavigationCommands.UriNavigationCommand}"
                              CommandParameter="classisland://app/settings/management?ci_keepHistory=true">
                        <MenuItem.Icon><remix:PackIconRemixIcon Kind="SuitcaseFill" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="加入管理…"
                              Visibility="{Binding ManagementService.IsManagementEnabled, Converter={StaticResource InverseBoolToVisConverter}}"
                              Command="{x:Static dialogs:DialogService.OpenDialogCommand}">
                        <MenuItem.Icon><remix:PackIconRemixIcon Kind="SuitcaseFill" Width="16" Height="16"/></MenuItem.Icon>
                        <MenuItem.CommandParameter>
                            <controls2:JoinManagementDialog/>
                        </MenuItem.CommandParameter>
                    </MenuItem>
                    <MenuItem Header="退出管理…"
                              Click="MenuItemExitManagement_OnClick"
                              Visibility="{Binding ManagementService.IsManagementEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <MenuItem.Icon><remix:PackIconRemixIcon Kind="SuitcaseFill" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="日志…" Click="MenuItemAppLogs_OnClick">
                        <MenuItem.Icon><remix:PackIconRemixIcon Kind="FileList3Fill" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="导出诊断数据" Click="MenuItemExportDiagnosticInfo_OnClick">
                        <MenuItem.Icon><remix:PackIconRemixIcon Kind="ExportFill" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="重启到恢复模式" Click="MenuItemRestartToRecovery_OnClick">
                        <MenuItem.Icon><remix:PackIconRemixIcon Kind="RestartFill" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="以管理员身份重启" Click="MenuItemRestartAsAdmin_OnClick">
                        <MenuItem.Icon><remix:PackIconRemixIcon Kind="AdminLine" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="打开日志目录…" Click="MenuItemOpenLogFolder_OnClick">
                        <MenuItem.Icon><remix:PackIconRemixIcon Kind="Folder6Fill" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="打开数据目录…" Click="MenuItemOpenDataFolder_OnClick">
                        <MenuItem.Icon><remix:PackIconRemixIcon Kind="Folder6Fill" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="打开应用目录…" Click="MenuItemOpenAppFolder_OnClick">
                        <MenuItem.Icon><remix:PackIconRemixIcon Kind="Folder6Fill" Width="16" Height="16"/></MenuItem.Icon>
                    </MenuItem>
                        </x:Array>
                    </mah:DropDownButton.ItemsSource>
                </mah:DropDownButton>
            </StackPanel>
        </mah:WindowCommands>
    </mah:MetroWindow.RightWindowCommands>
    <mah:MetroWindow.Flyouts>
        <mah:FlyoutsControl>
            <mah:Flyout Position="Right"
                        Width="420"
                        IsModal="True"
                        TitleVisibility="Collapsed"
                        IsOpen="{Binding ViewModel.IsDrawerOpen, Mode=TwoWay}">
                <ContentControl Content="{Binding ViewModel.DrawerContent}"
                                HorizontalContentAlignment="Stretch"/>
            </mah:Flyout>
        </mah:FlyoutsControl>
    </mah:MetroWindow.Flyouts>
    <Grid x:Name="RootGrid">
        <Grid.LayoutTransform>
            <TransformGroup>
                <ScaleTransform />
                <SkewTransform />
                <RotateTransform />
                <TranslateTransform/>
            </TransformGroup>
        </Grid.LayoutTransform>
        <mah:HamburgerMenu x:Name="HamburgerMenuControl"
                           ItemsSource="{Binding MenuItems}"
                           SelectedItem="{Binding ViewModel.SelectedPageInfo, Mode=TwoWay}"
                           IsPaneOpen="{Binding ViewModel.IsNavigationDrawerOpened, Mode=TwoWay}"
                           OpenPaneLength="250"
                           CompactPaneLength="48"
                           PaneMargin="0 0 0 -20">
            <mah:HamburgerMenu.Style>
                <Style TargetType="mah:HamburgerMenu" BasedOn="{StaticResource MahApps.Styles.HamburgerMenu}">
                    <Setter Property="DisplayMode" Value="CompactInline"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ViewModel.IsViewCompressed, Mode=OneWay}" Value="True">
                            <Setter Property="DisplayMode" Value="CompactOverlay"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </mah:HamburgerMenu.Style>
            <!-- 页面内容 -->
            <Grid>
                <Frame Content="{Binding ViewModel.FrameContent}"
                       Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                       NavigationUIVisibility="Hidden"
                       ClipToBounds="True"
                       x:Name="NavigationFrame">
                    <Frame.ContentTemplate>
                        <DataTemplate>
                            <mah:TransitioningContentControl Content="{Binding}"
                                                              RestartTransitionOnContentChange="True"
                                                              Transition="Custom">
                                <mah:TransitioningContentControl.CustomVisualStates>
                                    <VisualState x:Name="CustomTransition">
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CurrentContentPresentationSite"
                                                                           Storyboard.TargetProperty="(UIElement.Opacity)">
                                                <SplineDoubleKeyFrame KeyTime="00:00:00" Value="0" />
                                                <SplineDoubleKeyFrame KeyTime="00:00:00.150" Value="1" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CurrentContentPresentationSite"
                                                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)">
                                                <SplineDoubleKeyFrame KeyTime="00:00:00" Value="200" />
                                                <SplineDoubleKeyFrame KeySpline="0.1, 0.9, 0.2, 1"
                                                                      KeyTime="00:00:00.300"
                                                                      Value="0" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PreviousContentPresentationSite"
                                                                           Storyboard.TargetProperty="(UIElement.Opacity)">
                                                <SplineDoubleKeyFrame KeyTime="00:00:00" Value="0" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </mah:TransitioningContentControl.CustomVisualStates>
                            </mah:TransitioningContentControl>
                        </DataTemplate>
                    </Frame.ContentTemplate>
                    <Frame.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform />
                            <SkewTransform />
                            <RotateTransform />
                            <TranslateTransform X="0" />
                        </TransformGroup>
                    </Frame.RenderTransform>
                    <d:Frame.Content>
                        <Page Background="Pink">
                            <TextBlock TextWrapping="Wrap"
                                       Text="{StaticResource TestStringLong}" />
                        </Page>
                    </d:Frame.Content>
                </Frame>
            </Grid>
        </mah:HamburgerMenu>

        <!-- 设置搜索：贴在汉堡菜单导航栏顶部的搜索框 + 结果覆盖层（覆盖在菜单项之上） -->
        <Grid x:Name="SearchOverlay"
              HorizontalAlignment="Left"
              VerticalAlignment="Stretch"
              Panel.ZIndex="10"
              Width="{Binding ElementName=HamburgerMenuControl, Path=OpenPaneLength}"
              Visibility="{Binding ElementName=HamburgerMenuControl, Path=IsPaneOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 搜索框放在导航栏顶端；聚焦/输入时向左伸长，盖住左侧的菜单按钮 -->
            <Grid Grid.Row="0" Height="48">
                <TextBox x:Name="SearchTextBox"
                         Margin="48 9 8 9"
                         Style="{StaticResource MahApps.Styles.TextBox}"
                         mah:TextBoxHelper.Watermark="搜索设置…"
                         mah:TextBoxHelper.ClearTextButton="True"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchTextBox_OnTextChanged"
                         PreviewKeyDown="SearchTextBox_OnPreviewKeyDown"/>
            </Grid>

            <Grid Grid.Row="1">
                <Border x:Name="SearchResultsPanel"
                        Visibility="Collapsed"
                        Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                        BorderBrush="{DynamicResource MahApps.Brushes.Gray5}"
                        BorderThickness="0 0 1 0">
                    <ListBox x:Name="SearchResultsList"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonUp="SearchResultsList_OnPreviewMouseLeftButtonUp">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4 6">
                                    <TextBlock Text="{Binding Header}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding PageName}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <Border x:Name="SearchStatusPanel"
                        Visibility="Collapsed"
                        Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                        BorderBrush="{DynamicResource MahApps.Brushes.Gray5}"
                        BorderThickness="0 0 1 0">
                    <TextBlock x:Name="SearchStatusText"
                               Margin="16 8"
                               VerticalAlignment="Top"
                               Opacity="0.6"
                               TextWrapping="Wrap"
                               IsHitTestVisible="False"/>
                </Border>
            </Grid>
        </Grid>

        <TextBlock VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16" TextWrapping="Wrap" FontWeight="Medium" Text="{Binding ViewModel.StatusMessage}"/>
    </Grid>
</controls:MyWindow>
