<controls:MyWindow x:Class="ClassIsland.Views.SettingsWindowNew"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClassIsland.Views"
        xmlns:controls="clr-namespace:ClassIsland.Core.Controls;assembly=ClassIsland.Core"
        xmlns:dialogs="clr-namespace:ClassIsland.Core.Services;assembly=ClassIsland.Core"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:controls1="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
        xmlns:converters="clr-namespace:ClassIsland.Core.Converters;assembly=ClassIsland.Core"
        xmlns:controls2="clr-namespace:ClassIsland.Controls"
        xmlns:ci="clr-namespace:ClassIsland"
        xmlns:windows="clr-namespace:Walterlv.Windows;assembly=ClassIsland.Core"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        xmlns:converters1="clr-namespace:ClassIsland.Converters"
        xmlns:attributes="clr-namespace:ClassIsland.Core.Attributes;assembly=ClassIsland.Core"
        xmlns:remix="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.RemixIcon"
        xmlns:commands="http://classisland.tech/schemas/xaml/core"
        d:DataContext="{d:DesignInstance local:SettingsWindowNew}"
        TextElement.Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
        Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
        FontFamily="{StaticResource HarmonyOsSans}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        mc:Ignorable="d"
        MinWidth="560"
        Title="应用设置" Height="550" Width="1200"
        ShowTitleBar="True"
        SizeChanged="SettingsWindowNew_OnSizeChanged"
        Closing="SettingsWindowNew_OnClosing"
        dialogs:DialogService.Identifier="{x:Static controls1:SettingsPageBase.DialogHostIdentifier}">
    <controls:MyWindow.Resources>
        <StackPanel VerticalAlignment="Stretch" Margin="16" MaxWidth="400" x:Key="RestartDialog">
            <TextBlock Style="{StaticResource Headline6TextBlock}">
                <Run Text="需要重启"/>
            </TextBlock>
            <TextBlock Margin="0 6 0 0" TextWrapping="Wrap">
                <Run Text="部分设置需要重启以应用。"/>
            </TextBlock>
            <StackPanel Orientation="Horizontal" Margin="0 8 0 0" HorizontalAlignment="Right">
                <Button Content="稍后" HorizontalAlignment="Right" Style="{DynamicResource MahApps.Styles.Button.Flat}" Command="{x:Static dialogs:DialogService.CloseDialogCommand}" >
                    <Button.CommandParameter>
                        <system:Boolean xmlns:system="clr-namespace:System;assembly=mscorlib">
                            False
                        </system:Boolean>
                    </Button.CommandParameter>
                </Button>
                <Button Content="立即重启" IsDefault="True" HorizontalAlignment="Right" Style="{DynamicResource MahApps.Styles.Button.Flat}" Command="{x:Static dialogs:DialogService.CloseDialogCommand}" >
                    <Button.CommandParameter>
                        <system:Boolean xmlns:system="clr-namespace:System;assembly=mscorlib">
                            True
                        </system:Boolean>
                    </Button.CommandParameter>
                </Button>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Width="332" x:Key="ExperimentalSettings"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
                <TextBlock Text="实验性功能" Style="{StaticResource Headline5TextBlock}"
                           Margin="0 0 0 4" />
                <TextBlock Text="正在开发/测试的不稳定功能，可能会出现Bug等问题，请谨慎使用。" TextWrapping="Wrap"
                           Margin="0 0 0 16" />
                <CheckBox IsChecked="{Binding SettingsService.Settings.ShowEchoCaveWhenSettingsPageLoading}"
                          Margin="0 0 0 6"
                          IsEnabled="{Binding ManagementService.Policy.DisableEasterEggs, Converter={StaticResource BooleanToBooleanReConverter}}">
                    <TextBlock TextWrapping="Wrap">
                        在加载设置页面时显示回声洞
                        <Run TextDecorations="{x:Static TextDecorations.Strikethrough}">
                            （其实一般你还没看完就加载好了）
                        </Run>
                    </TextBlock>
                </CheckBox>

                <ComboBox Style="{StaticResource MahApps.Styles.ComboBox}"
                          mah:TextBoxHelper.Watermark="设置页面缓存策略"
                          Margin="0 0 0 2"
                          SelectedIndex="{Binding SettingsService.Settings.SettingsPagesCachePolicy}">
                    <ComboBoxItem>不缓存</ComboBoxItem>
                    <ComboBoxItem>保留页面缓存到窗口关闭（可能会内存泄漏）</ComboBoxItem>
                    <ComboBoxItem>一直保留页面缓存</ComboBoxItem>
                </ComboBox>
                <TextBlock Text="设置页面缓存可以提升之前打开过的设置页面的加载速度，但会增加一定的内存占用。" TextWrapping="Wrap"
                           Opacity="0.75"
                           />

                <Expander
                          Foreground="Transparent"
                          Margin="0 24 0 0"
                          Visibility="{Binding ManagementService.Policy.DisableEasterEggs, Converter={StaticResource InverseBoolToVisConverter}}">
                    
                    <Button Style="{StaticResource MahApps.Styles.Button.Flat}"
                            Click="ButtonDoNotClickVeryDangerous_OnClick"
                            Foreground="Red"
                            HorizontalAlignment="Left"
                            >
                        <commands:IconText Kind="{x:Static controls:IconGlyphs.WarningOutline}" Text="千万别点" />
                    </Button></Expander>
            </StackPanel>
        </ScrollViewer>

        <Storyboard x:Key="NavigationLeaving">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NavigationFrame" Storyboard.TargetProperty="(UIElement.Opacity)">
                <EasingDoubleKeyFrame KeyTime="00:00:00" Value="1.00">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuarticEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="00:00:00.0500000" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <QuarticEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="NavigationEntering">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NavigationFrame" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)">
                <EasingDoubleKeyFrame KeyTime="00:00:00" Value="200">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="00:00:00.1000000" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="NavigationFrame" Storyboard.TargetProperty="(UIElement.Opacity)">
                <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="00:00:00.1000000" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <SineEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <converters1:RemixIconKindConverter x:Key="RemixIconKindConverter"/>

        <!-- 导航项：设置页面 -->
        <DataTemplate DataType="{x:Type attributes:SettingsPageInfo}">
            <Grid Height="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type mah:HamburgerMenu}}, Path=CompactPaneLength, Mode=OneWay}"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <remix:PackIconRemixIcon Grid.Column="0"
                                         Width="18" Height="18"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Kind="{Binding Id, Converter={StaticResource RemixIconKindConverter}}"
                                         Foreground="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(TextElement.Foreground)}"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}"
                           VerticalAlignment="Center" Margin="4 0 12 0"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </DataTemplate>

        <!-- 导航分组分隔线 -->
        <DataTemplate DataType="{x:Type mah:HamburgerMenuSeparatorItem}">
            <Separator Margin="8 4"/>
        </DataTemplate>
    </controls:MyWindow.Resources>
    <controls:MyWindow.CommandBindings>
        <CommandBinding Command="{x:Static controls1:SettingsPageBase.OpenDrawerCommand}" Executed="CommandBindingOpenDrawer_OnExecuted"/>
        <CommandBinding Command="{x:Static controls1:SettingsPageBase.CloseDrawerCommand}" Executed="CommandBindingCloseDrawer_OnExecuted"/>
        <CommandBinding Command="{x:Static controls1:SettingsPageBase.RequestRestartCommand}" Executed="CommandBindingRestartApp_OnExecuted"></CommandBinding>
    </controls:MyWindow.CommandBindings>
    <mah:MetroWindow.LeftWindowCommands>
        <mah:WindowCommands>
            <Button ToolTip="返回"
                    Click="ButtonGoBack_OnClick"
                    Visibility="{Binding ViewModel.CanGoBack, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Content="{controls:GlyphIcon {x:Static controls:IconGlyphs.ArrowLeft}, Size=16}" />
        </mah:WindowCommands>
    </mah:MetroWindow.LeftWindowCommands>
    <mah:MetroWindow.RightWindowCommands>
        <mah:WindowCommands ShowSeparators="False">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="ToggleButton"
                           BasedOn="{StaticResource MahApps.Styles.ToggleButton}">
                        <Style.Resources>
                            <converters:SolidColorBrushOpacityConverter
                                x:Key="SolidColorBrushOpacityConverter" />
                        </Style.Resources>
                        <Setter Property="Foreground"
                                Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type FrameworkElement}}, Path=(TextElement.Foreground)}" />
                        <Setter Property="BorderBrush"
                                Value="{Binding RelativeSource={RelativeSource AncestorType={x:Type FrameworkElement}}, Path=(TextElement.Foreground), Converter={StaticResource SolidColorBrushOpacityConverter}, ConverterParameter=0.5, Mode=OneWay}" />
                        <Setter Property="Margin" Value="0 0 6 0" />
                    </Style>
                </StackPanel.Resources>
                <ToggleButton Visibility="{Binding ViewModel.IsRequestedRestart, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="部分设置需要重启应用后生效。" Click="ButtonRestartApp_OnClick">
                    <TextBlock>
                        <Run Text="需要重启" />
                    </TextBlock>
                </ToggleButton>
                <ToggleButton Visibility="{Binding ManagementService.IsManagementEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" Command="{x:Static dialogs:DialogService.OpenDialogCommand}" ToolTip="查看您的单位/组织如何管理此ClassIsland实例。">
                    <ToggleButton.CommandParameter>
                        <controls2:ManagementInfoControl />
                    </ToggleButton.CommandParameter>
                    <TextBlock>
                        <Run Text="由贵单位管理" />
                    </TextBlock>
                </ToggleButton>
                <TextBlock Text="{x:Static ci:App.AppVersion}"
                           Margin="8 0 0 0"
                           VerticalAlignment="Center"
                           ToolTip="应用版本" />
                <Grid Margin="8 0 0 0">
                    <ToggleButton x:Name="PopupToggle1" Style="{StaticResource MahApps.Styles.Button.Chromeless}" ToolTip="更多选项…" IsChecked="{Binding ViewModel.IsPopupOpen, Mode=TwoWay}" Padding="4">
                        …
                    </ToggleButton>
                    <Popup Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False" IsOpen="{Binding IsChecked, ElementName=PopupToggle1, Mode=TwoWay}">
                        <Border Background="{DynamicResource MahApps.Brushes.ThemeBackground}" Padding="4">
                            <StackPanel>
                                <StackPanel>
                                    <MenuItem Icon="{controls:GlyphIcon {x:Static controls:IconGlyphs.Code}}" Header="实验性功能…"
                                              Click="MenuItemExperimentalSettings_OnClick" />
                                    <MenuItem Icon="{controls:GlyphIcon {x:Static controls:IconGlyphs.WindowMaximize}}"
                                              Header="调试窗口规则…"
                                              Click="MenuItemDebugWindowRule_OnClick"/>
                                    <MenuItem Icon="{controls:GlyphIcon {x:Static controls:IconGlyphs.SwapHorizontal}}"
                                              Header="创建快捷换课图标"
                                              Click="MenuItemAddClassSwapShortcut_OnClick"/>
                                    <Separator/>
                                    <MenuItem Icon="{controls:GlyphIcon {x:Static controls:IconGlyphs.WorkOutline}}" Header="集控选项…"
                                              Command="{x:Static commands:UriNavigationCommands.UriNavigationCommand}"
                                              CommandParameter="classisland://app/settings/management?ci_keepHistory=true">
                                    </MenuItem>
                                    <MenuItem Icon="{controls:GlyphIcon {x:Static controls:IconGlyphs.BriefcaseAddOutline}}" Header="加入管理…"
                                              Visibility="{Binding ManagementService.IsManagementEnabled, Converter={StaticResource InverseBoolToVisConverter}}"
                                              Command="{x:Static dialogs:DialogService.OpenDialogCommand}">
                                        <MenuItem.CommandParameter>
                                            <controls2:JoinManagementDialog/>
                                        </MenuItem.CommandParameter>
                                    </MenuItem>
                                    <MenuItem Icon="{controls:GlyphIcon {x:Static controls:IconGlyphs.BriefcaseOffOutline}}" Header="退出管理…"
                                              Click="MenuItemExitManagement_OnClick" 
                                              Visibility="{Binding ManagementService.IsManagementEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Icon="{controls:GlyphIcon {x:Static controls:IconGlyphs.FileDocumentOutline}}"
                                              Header="日志…"
                                              Click="MenuItemAppLogs_OnClick"/>
                                    <MenuItem Icon="{controls:GlyphIcon {x:Static controls:IconGlyphs.DatabaseExportOutline}}"
                                              Header="导出诊断数据"
                                              Click="MenuItemExportDiagnosticInfo_OnClick"/>
                                    <MenuItem Icon="{controls:GlyphIcon {x:Static controls:IconGlyphs.WrenchCheckOutline}}"
                                              Header="重启到恢复模式"
                                              Click="MenuItemRestartToRecovery_OnClick"/>
                                    <Separator/>
                                    <MenuItem Icon="{controls:GlyphIcon {x:Static controls:IconGlyphs.FolderTextOutline}}"
                                              Header="打开日志目录…"
                                              Click="MenuItemOpenLogFolder_OnClick"/>
                                    <MenuItem Icon="{controls:GlyphIcon {x:Static controls:IconGlyphs.FolderFileOutline}}"
                                              Header="打开数据目录…"
                                              Click="MenuItemOpenDataFolder_OnClick"/>
                                    <MenuItem Icon="{controls:GlyphIcon {x:Static controls:IconGlyphs.FolderDownloadOutline}}"
                                              Header="打开应用目录…"
                                              Click="MenuItemOpenAppFolder_OnClick"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </StackPanel>
        </mah:WindowCommands>
    </mah:MetroWindow.RightWindowCommands>
    <Grid x:Name="RootGrid">
        <Grid.LayoutTransform>
            <TransformGroup>
                <ScaleTransform />
                <SkewTransform />
                <RotateTransform />
                <TranslateTransform/>
            </TransformGroup>
        </Grid.LayoutTransform>
        <mah:HamburgerMenu x:Name="HamburgerMenuControl"
                           ItemsSource="{Binding MenuItems}"
                           SelectedItem="{Binding ViewModel.SelectedPageInfo, Mode=TwoWay}"
                           IsPaneOpen="{Binding ViewModel.IsNavigationDrawerOpened, Mode=TwoWay}"
                           OpenPaneLength="250"
                           CompactPaneLength="48"
                           PaneMargin="0 0 0 -20">
            <mah:HamburgerMenu.Style>
                <Style TargetType="mah:HamburgerMenu" BasedOn="{StaticResource MahApps.Styles.HamburgerMenu}">
                    <Setter Property="DisplayMode" Value="CompactInline"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ViewModel.IsViewCompressed, Mode=OneWay}" Value="True">
                            <Setter Property="DisplayMode" Value="CompactOverlay"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </mah:HamburgerMenu.Style>
            <!-- 页面内容 -->
            <Grid>
                <Grid
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="32 8 8 16"
                    Opacity="0.75">
                    <Grid.Visibility>
                        <MultiBinding Converter="{StaticResource BooleanAndToVisibilityMultiConverter}">
                            <Binding Path="SettingsService.Settings.ShowEchoCaveWhenSettingsPageLoading"/>
                            <Binding Path="ManagementService.Policy.DisableEasterEggs" Converter="{StaticResource BooleanToBooleanReConverter}"/>
                        </MultiBinding>
                    </Grid.Visibility>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <controls:IconText Kind="{x:Static controls:IconGlyphs.BulbOnOutline}" VerticalAlignment="Center"
                                             Grid.Column="0"/>
                    <TextBlock Text="{Binding ViewModel.CurrentEchoCaveText}"
                               Grid.Column="1"
                               TextWrapping="Wrap"
                               FontWeight="Regular"
                               VerticalAlignment="Center"
                               Margin="4 0 0 0"/>
                </Grid>
                <Frame Content="{Binding ViewModel.FrameContent}"
                       Background="{DynamicResource MahApps.Brushes.ThemeBackground}"
                       NavigationUIVisibility="Hidden"
                       x:Name="NavigationFrame" RenderTransformOrigin="0.5,0.5">
                    <Frame.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform />
                            <SkewTransform />
                            <RotateTransform />
                            <TranslateTransform X="0" />
                        </TransformGroup>
                    </Frame.RenderTransform>
                    <d:Frame.Content>
                        <Page Background="Pink">
                            <TextBlock TextWrapping="Wrap"
                                       Text="{StaticResource TestStringLong}" />
                        </Page>
                    </d:Frame.Content>
                </Frame>
                <windows:AsyncBox LoadingViewType="controls2:LoadingMask" x:Name="LoadingAsyncBox"/>
            </Grid>
        </mah:HamburgerMenu>
        <mah:FlyoutsControl>
            <mah:Flyout Position="Right"
                        Width="420"
                        IsModal="True"
                        TitleVisibility="Collapsed"
                        IsOpen="{Binding ViewModel.IsDrawerOpen, Mode=TwoWay}">
                <ContentControl Content="{Binding ViewModel.DrawerContent}"/>
            </mah:Flyout>
        </mah:FlyoutsControl>
        <TextBlock VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16" TextWrapping="Wrap" FontWeight="Medium" Text="{Binding ViewModel.StatusMessage}"/>
    </Grid>
</controls:MyWindow>
