<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Nullable>enable</Nullable>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>True</UseWindowsForms>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\AppLogo.ico</ApplicationIcon>
<!--        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>-->
        <UserSecretsId>0702af86-626c-4e4a-94e4-f506e4e2beb7</UserSecretsId>
        <IncludePackageReferencesDuringMarkupCompilation>true</IncludePackageReferencesDuringMarkupCompilation>
        <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
        <StartupObject>ClassIsland.Program</StartupObject>
        <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
        <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
        <AppConfig>App.config</AppConfig>
        <AssemblyName>ClassIsland</AssemblyName>
        <RootNamespace>ClassIsland</RootNamespace>
		<IsMsix>$(IsMsix)</IsMsix>
		<Configurations>Debug;Release;Debug_MSIX;Release_MSIX</Configurations>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<TargetFramework>net472</TargetFramework>
		<LangVersion>preview</LangVersion>
		<!-- 只保留中性资源，过滤掉各 NuGet 包的语言卫星程序集（System.CommandLine 等，省约 0.15MB）。 -->
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>
    <ItemGroup>
        <!-- SDK props glob App.xaml before EnableDefaultApplicationDefinition is visible. Keep exactly one item so InitializeComponent is generated. -->
        <ApplicationDefinition Remove="@(ApplicationDefinition)" />
        <ApplicationDefinition Include="App.xaml" />
    </ItemGroup>
    <PropertyGroup Condition="'$(Configuration)'=='Release' Or '$(Configuration)'=='Release_MSIX'">
        <OutputType>WinExe</OutputType>
        <DebugType>portable</DebugType>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)'=='Debug' Or '$(Configuration)'=='Debug_MSIX'">
	    <OutputType>Exe</OutputType>
	    <DefineConstants>$(DefineConstants);TRACE;DEBUG</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)'=='Debug_MSIX' Or '$(Configuration)'=='Release_MSIX'">
      <IsMsix>true</IsMsix>
    </PropertyGroup>
    <!-- Costura 只在 Release 打开，把托管依赖嵌入 exe；Debug / MSIX 关闭，保持散文件便于调试和打包。 -->
    <PropertyGroup Condition="'$(Configuration)' != 'Release'">
        <DisableFody>true</DisableFody>
    </PropertyGroup>
    <ItemGroup>
        <None Remove="assets\documents\ChangeLog.md" />
        <None Remove="Assets\TrustedPublicKeys\ClassIsland.MetadataPublisher.asc" />
    </ItemGroup>
    <ItemGroup Condition="'$(Configuration)'=='Debug'">
        <PackageReference Include="JetBrains.Profiler.Api" Version="1.4.6" />
    </ItemGroup>
    <ItemGroup Condition="'$(Configuration)'=='Debug_MSIX'">
      <PackageReference Include="JetBrains.Profiler.Api">
        <Version>1.4.6</Version>
      </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1" />
        <PackageReference Include="Costura.Fody" Version="6.0.0">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Fody" Version="6.8.2">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="DotNetCampus.LatestCSharpFeatures" Version="13.0.1" PrivateAssets="all" />
        <PackageReference Include="GuerrillaNtp" Version="3.1.0" />
        <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.213">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="NAudio" Version="2.2.1" />
        <PackageReference Include="NAudio.Asio" Version="2.2.1" PrivateAssets="all" ExcludeAssets="all" />
        <PackageReference Include="NAudio.Midi" Version="2.2.1" PrivateAssets="all" ExcludeAssets="all" />
        <PackageReference Include="NAudio.WinForms" Version="2.2.1" PrivateAssets="all" ExcludeAssets="all" />
        <PackageReference Include="System.Text.Json" Version="8.0.5" />
        <PackageReference Include="WebSocketSharp" Version="1.0.3-rc11" />
        <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="2.0.6" />
        <PackageReference Include="RawInput.Sharp" Version="0.1.3" />
        <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
        <PackageReference Include="System.CommandLine.Hosting" Version="0.4.0-alpha.22272.1" />
        <PackageReference Include="System.Management" Version="8.0.0" />
        <PackageReference Include="System.Speech" Version="8.0.0" />
        <PackageReference Include="TimeCrontab" Version="3.5.1" />
        <PackageReference Include="WindowsShortcutFactory" Version="1.1.0" />
        <PackageReference Include="ColorHelper" Version="1.8.1" />
        <PackageReference Include="Jint" Version="4.16.4" />
        <PackageReference Include="MahApps.Metro.IconPacks.RemixIcon" Version="6.2.1" />
	</ItemGroup>
    <ItemGroup>
        <Reference Include="Microsoft.CSharp" />
        <Reference Include="System.IO.Compression" />
    </ItemGroup>
    <ItemGroup>
        <Folder Include="Models\Logging\" />
        <Folder Include="Models\Native\" />
        <Folder Include="Models\TimeRules\" />
        <Folder Include="Enums\" />
        <Folder Include="Models\AuthorizeProviderSettings\" />
        <Folder Include="Models\Logging\" />
        <Folder Include="Services\Metadata\" />
    </ItemGroup>
    <ItemGroup>
        <None Include="..\..\.editorconfig" Link=".editorconfig" />
    </ItemGroup>
    <ItemGroup>
        <Resource Include="Assets\**" />
        <!-- README 用的图，不打包进程序。 -->
        <Resource Remove="Assets\DubiIsland-AppLogo.png" />
    </ItemGroup>
    <PropertyGroup Condition="'$(TrimAssets)'=='true'">
        <DefineConstants>$(DefineConstants);TrimAssets</DefineConstants>
    </PropertyGroup>
	<PropertyGroup Condition="'$(PublishBuilding)' != 'true' And ('$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Debug_MSIX')">
		<DefineConstants>$(DefineConstants);DevelopmentBuild</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(PublishBuilding)' == 'true'">
		<DefineConstants>$(DefineConstants);PublishBuilding</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="!Exists('$(MSBuildProjectDirectory)\secrets.g.cs')">
		<DefineConstants>$(DefineConstants);SecretsNotGenerated</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(IsMsix)' == 'true'">
		<DefineConstants>$(DefineConstants);IsMsix</DefineConstants>
	</PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\ClassIsland.Core\ClassIsland.Core.csproj" />
        <ProjectReference Include="..\ClassIsland.Shared\ClassIsland.Shared.csproj" />
        <ProjectReference Include="..\vendors\System.Device.Location\System.Device.Location.csproj" />
        <ProjectReference Include="..\Libraries\Squircle\Squircle.csproj" />
        <ProjectReference Include="..\Libraries\UiAccess\IccEvolved.UiAccess\IccEvolved.UiAccess.csproj" />
        <ProjectReference Include="..\Libraries\UiAccess\IccEvolved.UiAccess.Helper\IccEvolved.UiAccess.Helper.csproj">
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
            <OutputItemType>Content</OutputItemType>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </ProjectReference>
        <!-- 设置搜索：编译期读取设置页 XAML，烘焙标题/标签/拼音的索引 -->
        <ProjectReference Include="..\ClassIsland.SettingsSearchGenerator\ClassIsland.SettingsSearchGenerator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>
    <ItemGroup>
        <AdditionalFiles Include="Views\SettingPages\*.xaml" />
        <AdditionalFiles Include="Views\SettingPages\*.xaml.cs" />
    </ItemGroup>
	<ItemGroup>
		<Page Update="Themes\LightTheme.xaml">
			<Generator>MSBuild:Compile</Generator>
			<XamlRuntime>Wpf</XamlRuntime>
			<SubType>Designer</SubType>
		</Page>
		<Page Update="Themes\DarkTheme.xaml">
			<Generator>MSBuild:Compile</Generator>
			<XamlRuntime>Wpf</XamlRuntime>
			<SubType>Designer</SubType>
		</Page>
	</ItemGroup>

    <PropertyGroup>
        <UiAccessHelperConfig Condition="'$(Configuration)' == 'Debug' Or '$(Configuration)' == 'Debug_MSIX'">Debug</UiAccessHelperConfig>
        <UiAccessHelperConfig Condition="'$(UiAccessHelperConfig)' == ''">Release</UiAccessHelperConfig>
    </PropertyGroup>

    <!-- 自解压 UIAccess 组件：把 Helper 及其依赖的 IccEvolved.UiAccess.dll 内嵌进主程序，启动时解压到应用目录。 -->
    <ItemGroup>
        <EmbeddedResource Include="EdgeTts\Source\VoiceList.json">
            <LogicalName>ClassIsland.EdgeTts.Source.VoiceList.json</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="..\Libraries\UiAccess\IccEvolved.UiAccess.Helper\bin\$(UiAccessHelperConfig)\net472\IccEvolved.UiAccess.Helper.exe">
            <LogicalName>ClassIsland.UiAccess.IccEvolved.UiAccess.Helper.exe</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="..\Libraries\UiAccess\IccEvolved.UiAccess\bin\$(UiAccessHelperConfig)\net472\IccEvolved.UiAccess.dll">
            <LogicalName>ClassIsland.UiAccess.IccEvolved.UiAccess.dll</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <Target Name="PrintConstants" AfterTargets="Build">
		<Message Text="Constants: $(DefineConstants)" Importance="high" />
		<Message Text="IsMsix: $(IsMsix)" Importance="high" />
		<Message Text="TargetFramework: $(TargetFramework)" Importance="high" />
    </Target>

	<Import Project="..\Global.props" />
</Project>
