<ci:AppBase x:Class="ClassIsland.App"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ci="http://classisland.tech/schemas/xaml/core"
         xmlns:behaviors="clr-namespace:ClassIsland.Behaviors"
         xmlns:converters="clr-namespace:ClassIsland.Converters"
         xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
         xmlns:remix="clr-namespace:MahApps.Metro.IconPacks;assembly=MahApps.Metro.IconPacks.RemixIcon"
         Startup="App_OnStartup"
         ShutdownMode="OnExplicitShutdown"
         DispatcherUnhandledException="App_OnDispatcherUnhandledException">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Assets/Fonts/Fonts.xaml"/>
                <ResourceDictionary Source="/Themes/Generic.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/ClassIsland.Core;component/ThemeBase.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <FontFamily x:Key="BackendFontFamily">Microsoft YaHei UI</FontFamily>
            <ci:BooleanAndToVisibilityMultiConverter x:Key="BooleanAndToVisibilityMultiConverter" />
            <ci:SolidColorBrushOpacityConverter x:Key="SolidColorBrushOpacityConverter" />
            <Visibility x:Key="VisibilityCollapsedValue">Collapsed</Visibility>

            <Style TargetType="Slider" BasedOn="{StaticResource MahApps.Styles.Slider.Win10}">
                <Setter Property="behaviors:StyleBehaviors.Behaviors">
                    <Setter.Value>
                        <behaviors:StyleBehaviorCollection>
                            <behaviors:SliderManipulationBehavior/>
                        </behaviors:StyleBehaviorCollection>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="AppColorPickerStyle" TargetType="{x:Type mah:ColorPicker}" BasedOn="{StaticResource MahApps.Styles.ColorPicker}">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="ColorPalettesTabHeader" Value="调色板" />
                <Setter Property="AdvancedTabHeader" Value="自定义颜色" />
            </Style>
            <Style x:Key="LoadingSpinnerStyle" TargetType="remix:PackIconRemixIcon">
                <Style.Triggers>
                    <Trigger Property="IsVisible" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard x:Name="Spin">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <StopStoryboard BeginStoryboardName="Spin" />
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</ci:AppBase>
