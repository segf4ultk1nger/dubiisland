<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Configurations>Debug;Release</Configurations>
    <!-- 打包 .cipx 需要 PowerShell 7 (pwsh)；未安装时保持 false，直接引用 bin 输出文件夹即可调试。
         发布时用 dotnet build -c Release -p:CreateCipx=true。 -->
    <CreateCipx Condition="'$(CreateCipx)' == ''">false</CreateCipx>
    <RootNamespace>Org.Sifware.UiAccessX</RootNamespace>
    <AssemblyName>org.sifware.uiaccessx</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <ClassIslandPluginSdkVersion>2.1.0.1</ClassIslandPluginSdkVersion>
    <!-- 提权 Helper 是 net472，需要单独构建；Debug 用 Debug 输出，其余用 Release。 -->
    <UiAccessHelperConfig Condition="'$(Configuration)' == 'Debug'">Debug</UiAccessHelperConfig>
    <UiAccessHelperConfig Condition="'$(UiAccessHelperConfig)' == ''">Release</UiAccessHelperConfig>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClassIsland.PluginSdk" Version="$(ClassIslandPluginSdkVersion)">
      <ExcludeAssets>runtime; native</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Obfuscar" Version="2.2.50">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- 应用侧复用现有 IccEvolved.UiAccess 源码（netstandard2.0 目标）。 -->
    <ProjectReference Include="..\..\Libraries\UiAccess\IccEvolved.UiAccess\IccEvolved.UiAccess.csproj" />
    <!-- Helper 仅作为构建依赖，其输出由下面的 Content 拷贝到 UiAccessHelper 子目录。 -->
    <ProjectReference Include="..\..\Libraries\UiAccess\IccEvolved.UiAccess.Helper\IccEvolved.UiAccess.Helper.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- 把 net472 的 Helper 和它依赖的同名 DLL 放到 UiAccessHelper 子目录，避免与插件自身的 netstandard 版 DLL 冲突。 -->
  <ItemGroup>
    <Content Include="..\..\Libraries\UiAccess\IccEvolved.UiAccess.Helper\bin\$(UiAccessHelperConfig)\net472\IccEvolved.UiAccess.Helper.exe"
             Link="UiAccessHelper\IccEvolved.UiAccess.Helper.exe"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Libraries\UiAccess\IccEvolved.UiAccess\bin\$(UiAccessHelperConfig)\net472\IccEvolved.UiAccess.dll"
             Link="UiAccessHelper\IccEvolved.UiAccess.dll"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.yml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 插件包只需 dll / deps.json / manifest / 资源：pdb 与 runtimeconfig.json 是宿主运行时的产物，打进去纯属垃圾。
       （deps.json 必须保留：ClassIsland 用 AssemblyDependencyResolver 依据它解析插件依赖。） -->
  <Target Name="CleanCipxPayload" BeforeTargets="CreateCipx" Condition="'$(CreateCipx)' == 'true'">
    <ItemGroup>
      <CipxJunk Include="$(OutputPath)*.pdb;$(OutputPath)*.runtimeconfig.json" />
    </ItemGroup>
    <Delete Files="@(CipxJunk)" />
  </Target>
  <!-- 打包前用 Obfuscar 混淆插件程序集（仅打包时执行，日常 Debug/Release 构建不受影响）。
       Obfuscar 包只提供 $(Obfuscar)（Obfuscar.Console.exe 路径），且插件输出里没有它依赖的
       ClassIsland.Core/Avalonia 等程序集，所以这里按本次编译的 @(ReferencePath) 生成配置，
       把这些引用目录作为 AssemblySearchPath 喂给 Obfuscar 以建立继承关系表。 -->
  <Target Name="ObfuscatePlugin" BeforeTargets="CreateCipx" Condition="'$(CreateCipx)' == 'true'">
    <!-- 上一次打包可能已把 bin 里的 dll 混淆过；先从未混淆的 obj 编译产物恢复，避免重复混淆。 -->
    <Copy SourceFiles="$(IntermediateOutputPath)org.sifware.uiaccessx.dll"
          DestinationFiles="$(OutputPath)org.sifware.uiaccessx.dll"
          OverwriteReadOnlyFiles="true" />
    <ItemGroup>
      <_ObfuscarRefDir Include="@(ReferencePath->'%(RootDir)%(Directory)')" />
    </ItemGroup>
    <ItemGroup>
      <_ObfuscarLine Include="&lt;?xml version=&quot;1.0&quot;?&gt;" />
      <_ObfuscarLine Include="&lt;Obfuscator&gt;" />
      <_ObfuscarLine Include="  &lt;Var name=&quot;InPath&quot; value=&quot;$(MSBuildProjectDirectory)\$(OutputPath)&quot; /&gt;" />
      <_ObfuscarLine Include="  &lt;Var name=&quot;OutPath&quot; value=&quot;$(MSBuildProjectDirectory)\$(IntermediateOutputPath)obfuscated&quot; /&gt;" />
      <!-- 保留公共 API：插件入口 PluginBase 虚方法重写靠公共成员名被宿主调用，重命名会破坏加载。 -->
      <_ObfuscarLine Include="  &lt;Var name=&quot;KeepPublicApi&quot; value=&quot;true&quot; /&gt;" />
      <_ObfuscarLine Include="  &lt;Var name=&quot;HidePrivateApi&quot; value=&quot;true&quot; /&gt;" />
      <_ObfuscarLine Include="@(_ObfuscarRefDir->'  &lt;AssemblySearchPath path=&quot;%(Identity)&quot; /&gt;')" />
      <_ObfuscarLine Include="  &lt;Module file=&quot;$(MSBuildProjectDirectory)\$(OutputPath)org.sifware.uiaccessx.dll&quot; /&gt;" />
      <_ObfuscarLine Include="&lt;/Obfuscator&gt;" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)obfuscar.generated.xml" Lines="@(_ObfuscarLine)" Overwrite="true" />
    <MakeDir Directories="$(IntermediateOutputPath)obfuscated" />
    <Exec Command="&quot;$(Obfuscar)&quot; &quot;$(MSBuildProjectDirectory)\$(IntermediateOutputPath)obfuscar.generated.xml&quot;" />
    <!-- 原地会锁住输入程序集，所以混淆到独立目录再拷回输出目录。 -->
    <Copy SourceFiles="$(IntermediateOutputPath)obfuscated\org.sifware.uiaccessx.dll"
          DestinationFiles="$(OutputPath)org.sifware.uiaccessx.dll"
          OverwriteReadOnlyFiles="true" />
  </Target>

</Project>
