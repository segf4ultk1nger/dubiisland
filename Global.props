<Project>
	<PropertyGroup>
		<!-- we'll do our own versioning -->
		<GitVersion>false</GitVersion>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="GitInfo" Version="2.3.0">
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<Compile Include="..\AssemblyInfo.cs">
			<LinkBase>Properties</LinkBase>
		</Compile>
	</ItemGroup>

	<PropertyGroup>
		<!-- 手写的 Assembly/File 版本保持不动，这个基准版本只在 git 不可用时兜底 -->
		<LegacyIslandBaseVersion Condition="'$(LegacyIslandBaseVersion)' == ''">1.8</LegacyIslandBaseVersion>
	</PropertyGroup>

	<!--
		实时版本号（仅注入 InformationalVersion，供 exe 的“产品版本”、关于页和发布包名使用）：
		  0.<Ship x.x.x.x 提交数>.<yyMMdd>.<总提交数>+<短 hash>
		git 不在 PATH 或不是仓库时回退到 <LegacyIslandBaseVersion>。
		GenerateAssemblyInfo 被关闭，所以这里直接生成一个带 AssemblyInformationalVersion 的源文件。
	-->
	<Target Name="StampGitInformationalVersion"
	        BeforeTargets="BeforeCompile"
	        Condition="'$(MSBuildProjectName)' == 'ClassIsland'">
		<PropertyGroup>
			<_StampDate>$([System.DateTime]::Now.ToString('yyMMdd'))</_StampDate>
		</PropertyGroup>
		<Exec Command="git rev-list --count --grep=&quot;^Ship &quot; HEAD"
		      ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
			<Output TaskParameter="ConsoleOutput" ItemName="_StampShipOut" />
		</Exec>
		<Exec Command="git rev-list --count HEAD"
		      ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
			<Output TaskParameter="ConsoleOutput" ItemName="_StampCommitsOut" />
		</Exec>
		<Exec Command="git rev-parse --short=8 HEAD"
		      ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
			<Output TaskParameter="ConsoleOutput" ItemName="_StampHashOut" />
		</Exec>
		<PropertyGroup>
			<_StampShip>@(_StampShipOut)</_StampShip>
			<_StampCommits>@(_StampCommitsOut)</_StampCommits>
			<_StampHash>@(_StampHashOut)</_StampHash>
			<_StampedInformationalVersion Condition="'$(_StampHash)' != '' and '$(_StampCommits)' != '' and '$(_StampCommits)' != '0'">0.$(_StampShip).$(_StampDate).$(_StampCommits)+$(_StampHash)</_StampedInformationalVersion>
			<_StampedInformationalVersion Condition="'$(_StampedInformationalVersion)' == ''">$(LegacyIslandBaseVersion)</_StampedInformationalVersion>
		</PropertyGroup>
		<Message Importance="normal" Text="LegacyIsland: InformationalVersion = $(_StampedInformationalVersion)" />
		<ItemGroup>
			<_StampAttribute Include="System.Reflection.AssemblyInformationalVersionAttribute">
				<_Parameter1>$(_StampedInformationalVersion)</_Parameter1>
			</_StampAttribute>
		</ItemGroup>
		<WriteCodeFragment AssemblyAttributes="@(_StampAttribute)"
		                   Language="C#"
		                   OutputFile="$(IntermediateOutputPath)LegacyIslandVersion.g.cs">
			<Output TaskParameter="OutputFile" ItemName="Compile" />
			<Output TaskParameter="OutputFile" ItemName="FileWrites" />
		</WriteCodeFragment>
	</Target>

	<!--<Target Name="PopulateInfo" DependsOnTargets="GitVersion" BeforeTargets="GetAssemblyVersion;GenerateNuspec;GetPackageContents">
		<PropertyGroup>
			<Version>$(GitBaseTag)</Version>
		</PropertyGroup>
	</Target>-->

	<PropertyGroup Condition="'$(Configuration)'=='Debug_MSIX'">
		<DefineConstants>$(DefineConstants);TRACE;DEBUG</DefineConstants>
		<IsMsix>true</IsMsix>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)'=='Release_MSIX'">
		<IsMsix>true</IsMsix>
	</PropertyGroup>
	<PropertyGroup Condition="'$(ClassIsland_PlatformTarget)'=='x64' Or '$(PlatformTarget)'=='x64'">
		<DefineConstants>$(DefineConstants);PLATFORM_x64</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(ClassIsland_PlatformTarget)'=='x86' Or '$(PlatformTarget)'=='x86'">
		<DefineConstants>$(DefineConstants);PLATFORM_x86</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(ClassIsland_PlatformTarget)'=='arm64'">
		<DefineConstants>$(DefineConstants);PLATFORM_ARM64</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(ClassIsland_PlatformTarget)'=='arm'">
		<DefineConstants>$(DefineConstants);PLATFORM_ARM</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(ClassIsland_PlatformTarget)'=='Any CPU'">
		<DefineConstants>$(DefineConstants);PLATFORM_Any</DefineConstants>
	</PropertyGroup>
	<!-- <PropertyGroup Condition="'$(IsMsix)'=='true'">
		<Platform>AnyCPU</Platform>
		<PlatformTarget>AnyCPU</PlatformTarget>
	</PropertyGroup>
	<Target Name="OverrideProperties" BeforeTargets="PrepareForBuild" Condition="'$(IsMsix)'=='true'">
		<Message Text="Overriding properties for MSIX build" Importance="high" />
		<PropertyGroup>
			<RuntimeIdentifier></RuntimeIdentifier>
		</PropertyGroup>
	</Target> -->

	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All"/>
	</ItemGroup>
	<PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<PropertyGroup>
		<DebugType>portable</DebugType>
		<DebugSymbols>true</DebugSymbols>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
	</PropertyGroup>
</Project>