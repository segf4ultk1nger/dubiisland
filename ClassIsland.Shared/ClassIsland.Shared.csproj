  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1" />
    <PackageReference Include="CsesSharp" Version="1.0.0" />
    <PackageReference Include="DotNetCampus.LatestCSharpFeatures" Version="13.0.1" />
